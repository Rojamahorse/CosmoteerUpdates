SmallPartDestroyed
[
	&<particles/explosions/small_part_explode_flash.rules>
	&<particles/explosions/small_part_explode_sparks.rules>
	&<particles/explosions/small_part_explode.rules>
	&<particles/explosions/small_part_explode_shrapnel.rules>
	&<particles/explosions/small_part_explode_debris.rules>
	&<particles/explosions/small_part_explode_smoke.rules>

	: /BASE_SOUNDS/AudioExterior
	{
		RandomSounds = ["sounds/small_part_destroyed_01.wav",
						"sounds/small_part_destroyed_02.wav",
						"sounds/small_part_destroyed_03.wav"]
		Volume = 1
		SpeedVariation = .15

		DynamicFilter
		{
			MinDistance = 0
			MaxDistance = 2
			DistanceFalloff = 1

			MinZoom = 1
			MaxZoom = 12
			ZoomFalloff = 2

			Filter
			{
				FilterType = LowPassAmplify
				FromFrequency = 8000
				ToFrequency = 300
				FrequencyFactorExponent = 0.5
			}
		}
	}

	: /BASE_SHAKE
	{
		ShakeAmount = .05
		Duration = .5
	}
]

SmallPartDestroyedDry
[
	&<particles/explosions/small_part_explode_dry_flash.rules>
	&<particles/explosions/small_part_explode_dry_sparks.rules>
