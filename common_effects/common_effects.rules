[
	&<particles/explosions/huge_part_explode.rules>
	&<particles/explosions/huge_part_explode_flash.rules>
	&<particles/explosions/huge_part_explode_debris.rules>
	&<particles/explosions/huge_part_explode_smoke.rules>

	: /BASE_SOUNDS/AudioExterior
	{
		RandomSounds = ["sounds/huge_part_destroyed_01.wav",
						"sounds/huge_part_destroyed_02.wav",
						"sounds/huge_part_destroyed_03.wav"]
		Volume = 1
		SpeedVariation = .15

		DynamicFilter
		{
			MinDistance = 0
			MaxDistance = 2
			DistanceFalloff = 1

			MinZoom = 1
			MaxZoom = 12
			ZoomFalloff = 2

			Filter
			{
				FilterType = LowPassAmplify
				FromFrequency = 8000
				ToFrequency = 100
				FrequencyFactorExponent = 0.5
			}
		}
	}

	: /BASE_SHAKE
	{
		ShakeAmount = .3
		Duration = 1
	}
]

HugePartScorched
[
	&<particles/explosions/huge_part_explode_smoke.rules>

	: /BASE_SHAKE
	{
		ShakeAmount = .06
		Duration = .2
	}
]

StructureDestroyed
[
	&<particles/explosions/struct_explode_flash.rules>
	&<particles/explosions/struct_explode_sparks.rules>
	&<particles/explosions/struct_explode_shrapnel.rules>
	&<particles/explosions/struct_explode_debris.rules>

	: /BASE_SOUNDS/AudioExterior
	{
		RandomSounds = ["sounds/small_part_destroyed_01.wav",
						"sounds/small_part_destroyed_02.wav",
						"sounds/small_part_destroyed_03.wav"]
		Volume = 1
		SpeedVariation = .15
		Speed = 1.25

		DynamicFilter
		{
			MinDistance = 0
			MaxDistance = 2
			DistanceFalloff = 1

			MinZoom = 1
			MaxZoom = 12
			ZoomFalloff = 2

			Filter
			{
				FilterType = LowPassAmplify
				FromFrequency = 8000
				ToFrequency = 300
				FrequencyFactorExponent = 0.5
			}
		}
	}

	: /BASE_SHAKE
	{
		ShakeAmount = .03
		Duration = .3
	}
]