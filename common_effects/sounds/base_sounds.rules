AudioInterior
{
	Type = Audio

	DynamicVolume
	{
		MinDistance = .5
		MaxDistance = 1.25
		DistanceFalloff = 1

		MinZoom = 1
		MaxZoom = 4
		ZoomFalloff = 5

		ExteriorVolume = 0
	}

	MaxConcurrent = 3
}

AudioInteriorDetail
{
	Type = Audio

	DynamicVolume
	{
		MinDistance = .5
		MaxDistance = 1.25
		DistanceFalloff = 1.25

		MinZoom = 1
		MaxZoom = 4
		ZoomFalloff = 6

		ExteriorVolume = 0
	}
	
	DynamicFilter
	{
		MinZoom = 1
		MaxZoom = 4
		ZoomFalloff = 3

		Filter
		{
			FilterType = LowPassAmplify
			FromFrequency = 7350
			ToFrequency = 500
			FrequencyFactorExponent = 0.5
		}
	}

	MaxConcurrent = 3
}

