BASE = &<./Data/shots/laser_bolt_small/laser_bolt_small.rules>

DAMAGE = 350

Range = &BASE/Range
IdealRange = &BASE/IdealRange
IdealRadius = &BASE/IdealRadius
AntiPhasingRaycastDistance = 1

AttenuationLimit = &HitOperational/HitEffects/0/Damage
HitAttenuator
{
	MediaEffects = &~/HitOperational/MediaEffects
}

CrewCollisions = {Enemies=true; Junk=true}
HitCrew = &HitOperational

HitShield = &HitOperational
HitOperational
{
	HitEffects
	[
		{
			Type = Damage
			Damage : ~/BASE/Components/Hit/HitOperational/HitEffects/0/Damage { BaseValue=&~/DAMAGE }
		}
	]
	MediaEffects = &~/BASE/Components/Hit/HitOperational/MediaEffects
}
HitStructural
{
	HitEffects
	[
		{
			Type = Damage
			Damage : ~/BASE/Components/Hit/HitStructural/HitEffects/0/Damage { BaseValue=ceil((&~/DAMAGE)/2) }
		}
	]
	MediaEffects = &~/BASE/Components/Hit/HitStructural/MediaEffects
}

BeamMediaEffects
[
	// The beam itself.
	{
		Type = Beam
		Sprite
		{
			Texture
			{
				File = ./Data/common_effects/particles/noise_gradient.png
				SampleMode = Linear
				MipLevels = max
				UVMode = Wrap
			}
			_noiseTexture
			{
				File = ./Data/common_effects/particles/noise_voronoi.png
				MipLevels = max
				SampleMode = Linear
				UVMode = Wrap
			}
			Shader = "./Data/shots/ion_beam/ion_beam.shader"
			_extraBeginLength = 0
			_extraEndLength = 0.25
			_sizePulseFactor = 1.2
			_sizePulseInterval = .1
			_sizePulseUOffsetFactor = -.03
			_endCapSize = 4
			Size = [100%, 1]
			VertexColor = [255, 255, 255, 217]
			_baseColor = [1, 0, 0.53, 1]
			_halfHighlightColor = [0.5, 0.22, 0.21, 1]
			TargetBlendMode
			{
				SourceRgbFactor = InverseDestColor
				DestRgbFactor = One
				RgbOperator = Add
				SourceAlphaFactor = One
				DestAlphaFactor = One
				AlphaOperator = Add
			}
		}
		FadeInTime = .05
		FadeOutTime = .1
		Bucket = IonBeam
	}

	// Beam lighting.
	{
		Type = Beam
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Shader = "./Data/common_effects/fancy_beam_light.shader"
			Size = [100%, 2]
			_extraBeginLength = (&Size/1) / 2
			_extraEndLength = (&Size/1) / 2
			VertexColor = [255, 0, 0, 255]
			_z = 0.4
			_litReflectiveStrength = 12
			_litAdditiveStrength = 0
			_unlitAdditiveStrength = 0.25
			_nrmlStrengthLimit = 1.0
			TargetBlendMode
			{
				SourceRgbFactor = InverseDestColor
				DestRgbFactor = One
				RgbOperator = Add
				SourceAlphaFactor = Zero
				DestAlphaFactor = One
				AlphaOperator = Add
			}
		}
		Bucket = Upper4
		IsLight = true
		FadeInTime = .05
		FadeOutTime = .1
	}
]