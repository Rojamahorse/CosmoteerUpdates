ID = "cosmoteer.bullet_deck"
Range = 190
IdealRange = [75, &~/Range]
IdealRadius = [5, 50]
Speed = 120

Components
{
	Physics
	{
		Type = CirclePhysics
		Radius = 0.45
		Density = 0.0001
	}

	Death
	{
		Type = DeathByLifetime
		// Lifetime will be auto-calculated based on range and speed.
	}

	Targetable
	{
		Type = Targetable
		Health = 3000
		TargetCategory = "bullet"

		OnDeath
		{
			MediaEffects = &~/Components/Hit/HitOperational/MediaEffects
		}
	}

	Hit
	{
		Type = PenetratingHit
		Penetration = 9.0
		PenetrationSpeed = 20

		CrewCollisions = {Enemies=true; Junk=true}
		FriendlyShipLowCollisions = false
		PenetratesCrew = true
		HitCrew = &HitOperational

		HitShield = &HitOperational
		HitOperational
		{
			ReduceEffectsByPenetration = true
			Offset = [-0.15, 0]

			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue = 7500; EffectScaleExponent = 1 }
				}
				{
					Type = Impulse
					Impulse = { BaseValue = 180; EffectScaleExponent = 1 }
				}
			]

			MediaEffects
			[
				&<particles/bullet_hit_deck.rules>
				&<particles/bullet_hit_deck_sparks.rules>
				&<particles/bullet_smoke_deck.rules>
				&<particles/bullet_flash_deck.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["sounds/deck_cannon_impact_01.wav",
									"sounds/deck_cannon_impact_02.wav",
									"sounds/deck_cannon_impact_03.wav"]
					Volume = 1
					SpeedVariation = .15
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .2
					Duration = .75
				}
			]
		}
		HitStructural
		{
			ReduceEffectsByPenetration = true
			Offset = [0.5, 0]

			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue = 3600; EffectScaleExponent = 1 }
				}
				{
					Type = Impulse;
					Impulse = { BaseValue = 90; EffectScaleExponent = 1 }
				}
			]

			MediaEffects
			[
				&<../bullet_large/particles/bullet_hit_large.rules>
				&<particles/bullet_hit_deck_sparks.rules>
				&<particles/bullet_flash_deck_struct.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["sounds/deck_cannon_impact_01.wav",
									"sounds/deck_cannon_impact_02.wav",
									"sounds/deck_cannon_impact_03.wav"]
					Volume = 1
					SpeedVariation = .15
				}
			]
		}
		PenetratingOperational
		{
			ReduceEffectsByPenetration = true

			HitEffects
			[
				{
					Type = Damage
					Damage = { BaseValue = 7500; EffectScaleExponent = 1 }
				}
				{
					Type = StatusApplication
					StatusType = cosmoteer.fire
					StatusChance = { BaseValue = .4; EffectScaleExponent = 1 }
					ValueType = Interpolated
				}
				{
					Type = Impulse
					Impulse = { BaseValue = 180; EffectScaleExponent = 1 }
				}
			]

			MediaEffects
			[
				&<particles/bullet_hit_deck.rules>
				&<particles/bullet_hit_deck_sparks.rules>
			]
		}
		PenetratingStructural
		{
			// No effect.
		}
		FinishedPenetratingOperational = &PenetratingOperational
		FinishedPenetratingStructural = &PenetratingStructural
	}

	Sprite
	{
		Type = AnimatedSprite
		RenderBucket = BulletUpper3
		ReduceScaleWith = Hit
		ReduceScaleExponent = 0.5
		Animation
		{
			AtlasSprite
			{
				Texture
				{
//					File = "../bullet_large/bullet_large.png"
					File = "./Data/shots/bullet_large/bullet_large.png"
					SampleMode = Linear
					MipLevels = max
				}
				Size = [1.1, 1.1]
			}
			FrameCount = 16
			FrameSize = [256, 256]
			FramesPerRow = 4
			FramesPerSecond = 120
		}
		NormalsTexture = &Animation/AtlasSprite/Texture
		DiffuseShader = "./Data/default.shader"
		NormalsShader = "./Data/no_normals.shader"
	}

	GlowSprite
	{
		Type = Sprite
		RenderBucket = BulletUpper4
		Z = 0.5
		IsLight = true
		Offset = [-1.5, 0]
		Sprite
		{
			Texture
			{
				File = "./Data/common_effects/particles/blob.png"
				MipLevels = max
				SampleMode = Linear
			}
			Size = [18, 9]
			VertexColor = [255, 100, 0]
			TargetBlendMode = Add
			Shader = "./Data/common_effects/fancy_light.shader"
			_z = 1
            _nrmlStrengthLimit = 1
			_litReflectiveStrength = 24
			_litAdditiveStrength = 0.05
			_unlitAdditiveStrength = 0.125
		}
	}

	MediaEffects
	{
		Type = MediaEffects
		MediaEffects
		[
			&<particles/bullet_trail_deck.rules>
		]
	}
}