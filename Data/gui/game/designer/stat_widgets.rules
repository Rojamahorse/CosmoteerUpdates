        		{
        			TextRenderer : ^/0/TextRenderer
        			{
        				Color = [246, 94, 4]
        				FontSize = 20
        			}
        		}
        		Icon
        		{
        			Texture
        			{
        				File = "stat_heat_generation.png"
        				MipLevels = 2
        				SampleMode = Linear
        			}
        			VertexColor = [0, 183, 255]
        		}
        		Stat = HeatGeneration
        		StatMode = Providers
        	}
        	{
        		Type = IconText
        		NameKey = "BuildBox/HeatDissipation"
        		CustomValueTextKey = "BuildBox/HeatDissipationFmt"
        		CustomValueLabel : <build_gui.rules>/StatsGui/DefaultStatLabel
        		{
        			TextRenderer : ^/0/TextRenderer
        			{
        				Color = [67, 227, 231]
        				FontSize = 20
        			}
        		}
        		Icon
        		{
        			Texture
        			{
        				File = "stat_heat_dissipation.png"
        				MipLevels = 2
        				SampleMode = Linear
        			}
        			VertexColor = [0, 183, 255]
        		}
        		Stat = HeatDissipation
        		StatMode = Providers
        	}
		]
	}
	{
		Type = IconText
		ToggleButtonID = Thermal
		NameKey = "BuildBox/HeatCapacity"
		CustomValueTextKey = "BuildBox/HeatCapacityFmt"
