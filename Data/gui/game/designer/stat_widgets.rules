StatWidgets
[
	{
		Type = StatBar
		NameKey = "BuildBox/Crew"
		ToggleButtonID = Crew
		Icon
		{
			Texture
			{
				File = "stat_crew.png"
				MipLevels = 2
				SampleMode = Linear
			}
		}
		RecommendedStat = RecCrew
		AddCrewToProvidedStat = true
		RoundUp = true
		CustomValueTextKey = "BuildBox/CrewFmt"
		AdditionalStatMarkers
		[
			{
				TooltipKey = "BuildBox/CrewOperatorsFmt"
				Stat = CrewRequired
				StatColor = &<./Data/gui/widgets.rules>/GoodTextColor
				ShowOnTooltipOnly = true 
			}
		]
	}
	{
		Type = StatBar
		NameKey = "BuildBox/Power"
		ToggleButtonID = Power
		NumberFormat = "0.0"
		Icon
		{
			Texture
			{
				File = "stat_power.png"
				MipLevels = 2
				SampleMode = Linear
			}
		}
		RecommendedStat = RecPower
		ProvidedStat = PowerGeneration
		BlocksPerValue = 10
	}
	{
		Type = InlineContainer
		ToggleButtonID = Thermal
		StatWidgets
		[
			{
        		Type = IconText
        		NameKey = "BuildBox/HeatGeneration"
