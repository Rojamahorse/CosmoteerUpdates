			Texture
			{
				File = "stat_thermal.png"
				MipLevels = 2
				SampleMode = Linear
			}
			VertexColor = [0, 183, 255]
		}
		Stat = HeatCapacity
		StatMode = ProvidersThenStatBlocks
	}
