ID = mine_part
NameKey = "Resource/MinePart"
PluralNameKey = "Resource/MinePartPlural"
DescriptionKey = "Resource/MinePartDesc"
BuyPrice = 52
SellPrice = (&BuyPrice) / 2
MaxPerNugget = 2
MaxStackSize = 8
FlexGridPriorityKey = "flex_grid_mine_part"
FlexGridDefaultPriority = 1
DropRates = &<../resources.rules>/AmmoDropRates
Rarity = Ammunition

Icon
{
	Texture
	{
		File = "icon.png"
		MipLevels = max
	}
	Size = [64, 64]
}

Overlay
{
	Texture
	{
		File = "overlay.png"
		SampleMode = Linear
		MipLevels = max
	}
	Size = [1, 1]
}

DeathHitEffects // Scaled with stack size.
[
	{
		Type = ExplosiveDamage
		TotalDamage = { BaseValue = 6000; EffectScaleExponent = 1 }
		Radius = 3
		Delay = .05
		StatusType = cosmoteer.fire
		StatusChancePerNDamage = 50%
		StatusValue = 1
		StatusValueType = Interpolated
		NDamage = 1000
		CrewKillChance = 10%
		Filter
		{
			OperationalHealth = true
			StructuralHealth = false
			Friendlies = true
		}
	}
	{
		Type = ExplosiveDamage
		TotalDamage = { BaseValue = 1200; EffectScaleExponent = 1 }
		Radius = 2
		Delay = .05
		Filter
		{
			OperationalHealth = false
			StructuralHealth = true
			Friendlies = true
			Crew = false
		}
	}
]

DeathMediaEffects = &/COMMON_EFFECTS/MedPartDestroyed

HitResponse
{
	HitEffects = &~/DeathHitEffects
	MediaEffects = &~/DeathMediaEffects
	Chance = 0
	ChancePerNDamage = 0
	RequireDirectHit = true
	DamageTypeOverrides
	{
		fire
		{
			ChancePerNDamage = 2.5%
			NDamage = &<./Data/statuses/fire/fire.rules>/DAMAGE_PER_TICK
		}
	}
}

NuggetSprites
[
	{
		File = "mine_part1.png"
		NormalsFile = "mine_part1_normals.png"
		Size = [1, 1]
		Offset = [.25, 0]
		UVRotation = 1
	}
	{
		File = "mine_part2.png"
		NormalsFile = "mine_part2_normals.png"
		Size = [1, 1]
		Offset = [.25, 0]
		UVRotation = 1
	}
]

