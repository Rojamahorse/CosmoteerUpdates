Part : <../base_part_terran.rules>/Part
{
	NameKey = "Parts/ThermalDilationPump"
	IconNameKey = "Parts/ThermalDilationPumpIcon"
	ID = cosmoteer.thermal_dilation_pump
	EditorGroups []
	EditorParentParts = [ ["cosmoteer.resonance_beam_turret", -1] ]
	DescriptionKey = "Parts/ThermalDilationPumpDesc"
	Resources
	[
		[steel, 16]
		[coil2, 2]
		[diamond, 1]
	]
	Size = [2, 2]
	IsRotateable = true
	SelectionPriority = 0
	MaxHealth = 2000
	ReceivableBuffs : ^/0/ReceivableBuffs [ ThermalActivity ]
	TypeCategories = [ uses_power, thermal_pump ]
	BlockedTravelCells
	[
		[0, 1], [1, 1]
	]
	AllowedDoorLocations
	[
		[0, -1], [1, -1]
		[-1, 0], [2, 0]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Point
			MipLevels = max
		}
		Size = [56, 56]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, BatteryStorage, ScorchedToggle]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 2
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 8000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 500
			OperationalToggle = CommandConsumptionToggle
		}

		True { Type=StaticToggle; ToggleOn=true; }
		BaseDilationPerPort { Type=StaticValue; Value=0.25; }
		BasePumpDilation
		{
			Type = ToggleValueSelector
			Toggle = IsOperational
			BlueprintToggle = True
			ToggleOnValue = BaseDilationPerPort
			ToggleOffValue = Zero
			IncludeInBlueprints = true
		}

		// dilationFactor = (1 / ((beams - 1) * utilizationScale + 1)^(1-efficiency)
		MultiUtilizationEfficiencyExponent
		{
			Type = StaticValue
			EFFICIENCY = 50%
			Value = 1 - (&EFFICIENCY)
		}
		UtilizationScale
		{
			Type = StaticValue
			Value = 50%
		}

		AdditionalUtilization_Left
		{
			Type = ValueOperation
			Operator = Subtract
			ValueOne = NetworkPumpUtilization_Left
			ValueTwo = One
			MinValue = 0
			IncludeInBlueprints = All
		}
		ScaledAdditionalUtilization_Left
		{
			Type = MultiValue
			Values = [AdditionalUtilization_Left, UtilizationScale]
			Mode = Multiply
			IncludeInBlueprints = All
		}
		ScaledDilationFactor_Left
		{
			Type = MultiValue
			Values = [ScaledAdditionalUtilization_Left, One]
			Mode = Add
			OneOver = true
			IncludeInBlueprints = All
		}

		DilationFactor_Left
		{
			Type = ValueOperation
			Operator = Power
			ValueOne = ScaledDilationFactor_Left
			ValueTwo = MultiUtilizationEfficiencyExponent
			IncludeInBlueprints = All
		}

		PumpDilation_Left
		{
			Type = MultiValue
			Values = [BasePumpDilation, DilationFactor_Left]
			Mode = Multiply
			IncludeInBlueprints = All
		}

		AdditionalUtilization_Right : AdditionalUtilization_Left
		{
			ValueOne = NetworkPumpUtilization_Right
		}
		ScaledAdditionalUtilization_Right : ScaledAdditionalUtilization_Left
		{
			Values = [AdditionalUtilization_Right, UtilizationScale]
		}
		ScaledDilationFactor_Right : ScaledDilationFactor_Left
		{
			Values = [ScaledAdditionalUtilization_Right, One]
		}

		DilationFactor_Right : DilationFactor_Left
		{
			ValueOne = ScaledDilationFactor_Right
		}

		PumpDilation_Right : PumpDilation_Left
		{
			Values = [BasePumpDilation, DilationFactor_Right]
		}

		NetworkedDilation_Left
		{
			Type = NetworkValue
			ValueSource = PumpDilation_Left
			Categories = [ thermal_dilation ]
			IncludeInBlueprints = true
		}
		NetworkedDilation_Right : NetworkedDilation_Left
		{
			ValueSource = PumpDilation_Right
		}

		AdditionalTurretHeatGeneration
		{
			Type = ToggleValueSelector
			Toggle = IsOperational
			BlueprintToggle = True
			ToggleOffValue = Zero
			ToggleOnValue = AdditionalTurretHeatGeneration_Active
			IncludeInBlueprints = true
		}
		Zero
		{
			Type = StaticValue
			Value = 0
		}
		One
		{
			Type = StaticValue
			Value = 1
		}
		AdditionalTurretHeatGeneration_Active
		{
			Type = StaticValue
			Value = 100
		}
		NetworkedActivity_Left
		{
			Type = NetworkValue
			ValueSource = AdditionalTurretHeatGeneration
			Categories = [ thermal_activity ]
			IncludeInBlueprints = true
		}
		NetworkedActivity_Right = &NetworkedActivity_Left

		NetworkPumpUtilization_Left
		{
			Type = NetworkValueReceiver
			AllowUncategorized = false
			Categories = [ thermal_pump_utilization ]
			Mode = Add
			IncludeInBlueprints = true
		}
		NetworkPumpUtilization_Right = &NetworkPumpUtilization_Left
		TotalUtilization
		{
			Type = MultiValue
			Values = [ NetworkPumpUtilization_Left, NetworkPumpUtilization_Right ]
			Mode = Add
		}

		UtilizationToggle
		{
			Type = ThresholdToggle
			ValueFrom = TotalUtilization
			MinAmount = 0
			MaxAmount = 0
			Invert = true
		}

		IsUtilized
		{
			Type = MultiToggle
			Toggles = [ IsOperational, UtilizationToggle ]
			Mode = All
		}

		PowerDrainFactor_Left
		{
			Type = MultiValue
			Values = [ DilationFactor_Left, NetworkPumpUtilization_Left ]
			Mode = Multiply
		}
		PowerDrainFactor_Right : PowerDrainFactor_Left
		{
			Values = [ DilationFactor_Right, NetworkPumpUtilization_Right ]
		}
		TotalPowerDrainFactor
		{
			Type = MultiValue
			Values = [ PowerDrainFactor_Left, PowerDrainFactor_Right ]
			Mode = Add
		}

		UtilizationBuff
		{
			Type = SelfBuffProvider
			BuffType = ThermalActivity
			BuffAmount = 1
			BuffMultiplier = TotalPowerDrainFactor
		}

		PowerDrain
		{
			Type = ResourceConverter
			OperationalToggle = IsUtilized
			FromStorage = BatteryStorage
			FromQuantity
			{
				BaseValue = 250
				BuffType = ThermalActivity
				BuffMode = Multiply
			}
			MinFromQuantityForConversion = 1
			Interval = 1
		}

		Port_BottomLeft
		{
			Type = NetworkPort
			Location = [0, 1]
			Direction = Down
			Types = [ thermal, thermal_out ]
			IncompatibleTypes = [ thermal_out ]
			RouteSource = NetworkedDilation_Left
			RouteEndpoint = NetworkedDilation_Left
			BlueprintRouteSource = NetworkedDilation_Left
			BlueprintRouteEndpoint = NetworkedDilation_Left
			Overlay
			{
				OverlayIcon = "ThermalPort"
				RouteLine = "Thermal"
				DrawRouteHub = false
				ConnectedEdgeIcon = "ThermalDot"
				HighlightPartOnPrimaryConnection = true
    			PartHighlightColor = [255, 217, 0, 61]
			}
		}

		Port_BottomRight : Port_BottomLeft
		{
			Location = [1, 1]
			RouteSource = NetworkedDilation_Right
			RouteEndpoint = NetworkedDilation_Right
			BlueprintRouteSource = NetworkedDilation_Right
			BlueprintRouteEndpoint = NetworkedDilation_Right
		}

		Router
		{
			Type = NetworkRouter
			IncludeInBlueprints = All
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[NetworkedDilation_Left, NetworkedActivity_Left, 0]
						[NetworkedDilation_Left, NetworkPumpUtilization_Left, 0]

						[NetworkedDilation_Right, NetworkedActivity_Right, 0]
						[NetworkedDilation_Right, NetworkPumpUtilization_Right, 0]
					]
				}
			]
		}

		DestroyedEffects
		{
			Type = DeathEffects
			Location = [1, 1]
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
		}

		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = IsOperational
			DoodadToggle = IsUtilized
			Floor
