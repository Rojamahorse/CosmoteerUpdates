		{
			Type = BlueprintSprite
			Offset = [0.5, 0]
			Toggle = Port_BottomRight
			File = "blueprints_connected.png"
			Size = [1, 2]
			MirrorU = true
		}
/*		Right_Pipe_Unconnected_Blueprints
		{
			Type = BlueprintSprite
			Offset = [0.5, 0]
			Toggle = Port_BottomRight
			Invert = true
			File = "blueprints_unconnected.png"
			Size = [1, 2]
			MirrorU = true
		}
*/

		//------------------------ PIPE CONNECTOR ------------------------
		Dont_Draw_Pipe_Connector_Into_This_Part { Type = Graphics }	//When this fake component is present, the Heat Pipes dont draw a Pipe Conector to this part.

		//Draw a Pipe Connector Down Left if possible
		PipeConnectorDownLeft_DrawToggle : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorDown_DrawToggle
		{
			PartLocation = [0, 2]
		}
		PipeConnectorDownLeft_Toggle : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorDown_Toggle
		{
			Toggles = [Port_BottomLeft, {Toggle = PipeConnectorDownLeft_DrawToggle, invert = true}]
		}
		PipeConnectorDownLeft_Components : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorDown_Components
		{
			Toggle = PipeConnectorDownLeft_Toggle
			Components
			{
				PipesConnectorDownLeft_Graphics : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorDown_Components/Components/PipesConnectorDown_Graphics
				{
					Location = [0.5, 2.5]
				}
			}
		}

		//Draw a Pipe Connector Down Right if possible
		PipeConnectorDownRight_DrawToggle : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorDown_DrawToggle
		{
			PartLocation = [1, 2]
		}
		PipeConnectorDownRight_Toggle : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorDown_Toggle
		{
			Toggles = [Port_BottomRight, {Toggle = PipeConnectorDownRight_DrawToggle, invert = true}]
		}
		PipeConnectorDownRight_Components : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorDown_Components
		{
			Toggle = PipeConnectorDownRight_Toggle
			Components
			{
				PipesConnectorDownRight_Graphics : <./Data/ships/terran/heat_pipe_adaptive/pipe_connector/heat_pipe_connector_toggles.rules>/PipeConnectorDown_Components/Components/PipesConnectorDown_Graphics
				{
					Location = [1.5, 2.5]
				}
			}
		}
		//---------------------- END PIPE CONNECTOR ----------------------
	}

	Stats
	{
		ThermalDilation = (&~/Part/Components/BaseDilationPerPort/Value) * 100 * 2
//		ThermalPumpMultiEfficiency = (&~/Part/Components/MultiUtilizationEfficiencyFactor/Value) * 100
		TurretExtraHeatGeneration = (&~/Part/Components/AdditionalTurretHeatGeneration_Active/Value) * 2

		PowerUsageContinuous = (&~/Part/Components/PowerDrain/FromQuantity/BaseValue) / (&~/Part/Components/PowerDrain/Interval) / 1000 * 2
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		RecPower = &PowerUsageContinuous
	}

	StatsNotesKey = "Stats/ThermalDilationPumpNotes"
}