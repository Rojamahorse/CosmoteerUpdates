		Stats
		{
			ThrusterForce = (&~/Part/ThrusterForce) * (&~/OVERCLOCK/THRUST_FACTOR)
			ThrusterHeatGeneration = &~/OVERCLOCK/THRUST_HEAT_PER_SECOND
			ThrusterPowerUsage = (&~/Part/FuelUsage) * (&~/OVERCLOCK/MAX_POWER_USAGE_FACTOR) / 1000
		}
		StatsByCategory
		[
			{
				NameKey = "StatCategories/OverclockedBoost"
				Stats
				{
					ThrusterForce = (&~/Part/BoostedThrusterForce) * (&~/OVERCLOCK/BOOST_THRUST_FACTOR)
					BASE_THRUSTER_POWER_USAGE = (&~/Part/BoostedFuelUsage) * (&~/OVERCLOCK/MAX_POWER_USAGE_FACTOR) / 1000
					ThrusterPowerUsageRamp = [&../BASE_THRUSTER_POWER_USAGE, (&../BASE_THRUSTER_POWER_USAGE) * (&~/OVERCLOCK/BOOST_MAX_POWER_USAGE_FACTOR)]
					ThrusterPowerUsageRampTime = (&~/OVERCLOCK/BOOST_POWER_RAMP_TIME)
					BaseHeatFactor = [(&~/OVERCLOCK/BASE_BOOST_HEAT_FACTOR) * 100, (&~/OVERCLOCK/THRUST_HEAT_PER_SECOND) * (&~/OVERCLOCK/BASE_BOOST_HEAT_FACTOR)]
					BoostHeatFactorPerBattery = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_BATTERY) * 100
					BoostHeatFactorPerSecond = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_SECOND) * 100
					BoostHeatFactorBatteryThreshold = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_POWER_THRESHOLD) / 1000
				}
				Features
				[
					CanReceivePower
				]
			}
		]
	}
}