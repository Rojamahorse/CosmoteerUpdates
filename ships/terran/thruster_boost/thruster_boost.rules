		Overclock_ThrustEffectsBoosted : ThrustEffectsBoosted
		{
			InvertOperationalToggle = false
			MediaEffects
			[
				// Particles
				&../^/0/MediaEffects/0
				&../^/0/MediaEffects/1
				&../^/0/MediaEffects/2
				&../^/0/MediaEffects/3
				&../^/0/MediaEffects/4

				// SFX loop
				: ../^/0/MediaEffects/5
				{
					Db = (&~/OVERCLOCK/BOOST_AUDIO_VOLUME_DB)
					Speed = (&~/OVERCLOCK/AUDIO_SPEED_FACTOR)
					// MaxConcurrentVolume = (&^/0/MaxConcurrentVolume) * db2vol("&~/OVERCLOCK/BOOST_AUDIO_VOLUME_DB")
				}

				: /COMMON_SOUNDS/ThrusterRumble
				{
					Sound = "sounds/boost_thruster_overclocked.wav"
				}
			]
			EndMediaEffects
			[
				: ../^/0/EndMediaEffects/0
				{
					Speed = (&^/0/Speed) * (&~/OVERCLOCK/AUDIO_SPEED_FACTOR)
					Db = (&^/0/Db) + db2vol("&~/OVERCLOCK/BOOST_AUDIO_VOLUME_DB")
					// MaxConcurrentVolume = (&^/0/MaxConcurrentVolume) * db2vol("&~/OVERCLOCK/BOOST_AUDIO_VOLUME_DB")
				}
			]
		}

