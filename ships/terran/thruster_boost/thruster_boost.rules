		PeakHeatGenerationValue
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/THRUST_HEAT_PER_SECOND) * (&~/OVERCLOCK/BASE_BOOST_HEAT_FACTOR)
		}
