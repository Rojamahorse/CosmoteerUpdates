OVERCLOCK
{
	THRUST = 7200
	THRUST_FACTOR = (&THRUST) / (&~/Part/ThrusterForce)
	
	MAX_POWER_USAGE_FACTOR = 175%
	POWER_USAGE_FACTOR = 1 / (&THRUST_FACTOR) * (&MAX_POWER_USAGE_FACTOR)
	THRUST_HEAT_PER_SECOND = 675

	BOOST_THRUST = 24000
	BOOST_THRUST_FACTOR = (&BOOST_THRUST) / (&~/Part/BoostedThrusterForce)

	BASE_BOOST_HEAT_FACTOR = 150%
	BOOST_HEAT_FACTOR_PER_BATTERY = 24%
	BOOST_HEAT_FACTOR_PER_SECOND = -6%
	BOOST_HEAT_FACTOR_POWER_THRESHOLD = (&~/Part/Components/RealBatteryStorage/MaxResources)

	BOOST_MAX_POWER_USAGE_FACTOR = 175%
	BOOST_POWER_RAMP_TIME = 2

	AUDIO_SPEED_FACTOR = 120%
	AUDIO_VOLUME_DB = 3
	BOOST_AUDIO_VOLUME_DB = 2
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Part : <../base_large_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/ThrusterBoost"
	IconNameKey = "Parts/ThrusterBoostIcon"
	ID = cosmoteer.thruster_boost // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Flight"
	DescriptionKey = "Parts/ThrusterBoostDesc"
	Resources
	[
		[steel, 56]
		[coil2, 10]
		[tristeel, 8]
	]
	TypeCategories = [thruster, uses_power]
	SignificanceToggle = ScorchedToggle
	Size = [2, 5]
	PhysicalRect = [0, 0, 2, 3]
	SaveRect = &PhysicalRect
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "thrusters"
	MaxHealth = 6000
	ProhibitBelow = 18
	ThrusterForce = 3600
	ThrustIncreaseTime
	{
		BaseValue = 2
		Modifiers
		[
			{
				Type = Buff
				BuffType = Engine
				ModificationMode = Divide
			}
			{
				Type = BuffRemap
				BuffType = Overclock
				ModificationMode = Divide
				RemapFrom = [0, 1]
				RemapTo = [1, (&~/OVERCLOCK/THRUST_FACTOR)]
			}
		]
	}
	ThrustDecreaseTime = 0
	ThrustRecoveryTime = 2
	FuelUsage = 200
	BoostedThrusterForce = 9600
	BoostedThrustIncreaseTime = 0
	BoostedThrustDecreaseTime = 0
	BoostedThrustRecoveryTime = 0
	BoostedFuelUsage = 450
	BoostedPowerDrain = { BaseValue=-10; BuffType=Engine; BuffMode=Multiply; }
	BoostedPowerDrainInterval = 0.1
	BOOSTED_BASE_POWER_DRAIN_PER_SEC = (&BoostedPowerDrain/BaseValue) / (&BoostedPowerDrainInterval)
	ReceivableBuffs : ^/0/ReceivableBuffs [Engine, EnginePowerDistribution, EngineHeatCollection, ThermalActivity, BoostOverclockPowerRamp]
	AllowedDoorLocations
	[
		[-1, 0]
		[0, -1]
		[1, -1]
		[2, 0]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [42.66, 106.66]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, CommandToggle, RealBatteryStorage, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 6
		}
		CommandToggle
		{
			Type = CommandToggle
		}

		BoostToggle
		{
			Type = UIToggle
			ToggleID = "thruster_boost"
			Default = 0
			AutoOffTrigger = AutoBoostOffTrigger
			OperationalToggle = IsOperational
			RememberValue = false
		}

		RealBatteryStorage // Can't call this "BatteryStorage" because we don't want it fillable via the engine room when in boost mode. We define a proxy to it below.
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 6000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
			ToggleOnResources = (&MaxResources) - 999
			ToggleOffResources = 0
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1
		}

		BoostProgressBar
		{
			Type = ProgressBar
			OperationalToggle = BoostToggle
			ShowProgressFor = RealBatteryStorage
			LowColor = [255, 255, 255]
			HighColor = [255, 255, 255]
			FullColor = [255, 255, 255]
			ValueRange = [0, &~/Part/Components/RealBatteryStorage/MaxResources]
		}

		FullAmmoToggle
		{
			Type = MultiResourceStorage
			ResourceType = battery
			ResourceStorages = [RealBatteryStorage]
			ToggleOnResources = &../RealBatteryStorage/MaxResources
			ToggleOffResources = (&ToggleOnResources) - 1
		}

		BoostOffInstantDrainToggles
		{
			Type = MultiToggle
			Toggles = [BoostToggle, CommandConsumptionToggle]
			Mode = All
		}

		BoostOffInstantDrainTrigger
		{
			Type = ToggleTrigger
			Toggle = BoostOffInstantDrainToggles
			TriggerWhenOn = false
			TriggerWhenOff = true
			OperationalToggle = FullAmmoToggle
			InvertOperationalToggle = true
		}

		BoostOffInstantDrain
		{
			Type = ResourceChange
			Trigger = BoostOffInstantDrainTrigger
			ResourceStorage = RealBatteryStorage
			Amount = -999999
		}

		AutoBoostOffTrigger
		{
			Type = MultiTrigger
			Triggers = [ BatteryDepletedTrigger, OverclockDisabledTrigger ]
		}

		BatteryDepletedTrigger
		{
			Type = ToggleTrigger
			Toggle = RealBatteryStorage
			TriggerWhenOn = false
			TriggerWhenOff = true
		}

		CanReceivePower
		{
			Type = MultiToggle
			Toggles
			[
				{ Toggle = BoostToggle; Invert = true }
				IsOverclocked
			]
			Mode = Any
		}

		BatteryStorage
		{
			Type = ResourceStorageProxy
			ProxyToggle = CanReceivePower
			ResourceType = battery
			ComponentID = RealBatteryStorage
		}
		ToggledBatteryConsumer
		{
			Type = ToggledComponents
			Toggle = PowerDistributionBuffToggle
			Invert = true
			IncludeInBlueprints = true
			Components
			{
				BatteryConsumer
				{
					Type = ResourceConsumer
					ResourceType = battery
					Storage = BatteryStorage
					DefaultPriority = &/PRIORITIES/Thruster_Supply
					ResupplyThreshold = 500
					OperationalToggle = CommandConsumptionToggle
				}
			}
		}

		PowerDistributionBuffToggle
		{
			Type = BuffToggle
			BuffType = EnginePowerDistribution
		}

		IsOverclockedBoosting
		{
			Type = MultiToggle
			Toggles = [ IsOverclocked, BoostToggle ]
			Mode = All
		}

		Overclock_OnBoostPowerUsed
		{
			Type = ValueChangeTrigger
			OperationalToggle = IsOverclockedBoosting
			ValueSource = RealBatteryStorage
			TriggerOnIncrease = false
		}

		Overclock_TotalBoostPowerUsed
		{
			Type = ValueAccumulator
			OperationalToggle = IsOverclockedBoosting
			NonOperationalBehaviour = Reset
			AccumulatingToggle = Overclock_IsThrusterActive
			THRUST_DISSIPATION_PER_SECOND = -(&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_SECOND) / (&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_BATTERY)
			DISSIPATION_PER_SECOND = (&THRUST_DISSIPATION_PER_SECOND)
			DissipationRate
			{
				BaseValue = (&../DISSIPATION_PER_SECOND) * 1000
				Modifiers
				[
					{
						Type = ScaledBuff
						BuffType = Engine
						Scale = -(&~/Part/BOOSTED_BASE_POWER_DRAIN_PER_SEC)
						ModificationMode = Add
					}
				]
			}
			MinValue = 0
			AccumulationTriggers
			[
				{
					Trigger = Overclock_OnBoostPowerUsed
					// Negative to flip the sign of the negative resource change value
					Value = { BaseValue = -1; EffectScaleExponent = 1; }
					AllowWhenNonOperational = false
				}
			]
		}
		Overclock_RampingBoostPowerUseFactor
		{
			Type = ValueAccumulator
			OperationalToggle = IsOverclockedBoosting
			NonOperationalBehaviour = Reset
			AccumulatingToggle = Overclock_IsThrusterActive
			AccumulationRate = 1 / (&~/OVERCLOCK/BOOST_POWER_RAMP_TIME)
			DissipationRate = &AccumulationRate
			MinValue = 0
			MaxValue = 1
		}
		Overclock_BoostPowerUseBuff
		{
			Type = SelfBuffProvider
			BuffType = BoostOverclockPowerRamp
			BuffMultiplier = Overclock_RampingBoostPowerUseFactor
		}
		Overclock_BoostPowerUseBar
		{
			Type = ProgressBar
			OperationalToggle = IsOverclockedBoosting
			ShowProgressFor = Overclock_RampingBoostPowerUseFactor
			LowColor = [201, 239, 0]
			HighColor = [201, 239, 0]
			FullColor = [201, 239, 0]
		}

		Overclock_BoostHeatFactorPowerThreshold
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_POWER_THRESHOLD)
		}

		Overclock_BoostPowerUsedOverThreshold
		{
			Type = ValueOperation
			Operator = Subtract
			ValueOne = Overclock_TotalBoostPowerUsed
			ValueTwo = Overclock_BoostHeatFactorPowerThreshold
			MinValue = 0
		}

		Overclock_BoostHeatFactorPerPower
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/BOOST_HEAT_FACTOR_PER_BATTERY) / 1000
		}

		Overclock_BoostPowerUsedAdditionalHeatFactor
		{
			Type = MultiValue
			Values = [Overclock_BoostHeatFactorPerPower, Overclock_BoostPowerUsedOverThreshold]
			Mode = Multiply
		}
		Overclock_BoostBaseHeatFactor
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/BASE_BOOST_HEAT_FACTOR)
		}
		Overclock_BaseHeatFactor
		{
			Type = ToggleValueSelector
			Toggle = BoostToggle
			ToggleOffValue = One
			ToggleOnValue = Overclock_BoostBaseHeatFactor
		}
		Overclock_BoostPowerUsedHeatFactor
		{
			Type = MultiValue
			Values = [One, Overclock_BoostPowerUsedAdditionalHeatFactor]
			Mode = Add
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_CombinedHeatInput
		{
			Type = MultiResourceStorage
			ResourceType = heat
			ResourceStorages = [ NetworkHeatInput ]
			ViaBuffs
			{
				IncomingBuffTypes = [ EngineHeatCollection ]
				ComponentIDs = [ EngineHeatCollectionStorage ]
			}
		}

		// Overriding to use the combined heat input
		HeatDistributionStorage : ^/0/HeatDistributionStorage
		{
			ResourceStorages = [Overclock_CombinedHeatInput, OverflowHeatStorage]
		}

		Overclock_ThrusterHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/THRUST_HEAT_PER_SECOND) * (&Interval))
			ToQuantity
			{
				BaseValue = (&../HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
				BuffType = ThermalActivity
				BuffMode = Multiply
			}
			ToStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}

		Overclock_ActivationBuff
		{
			Type = SelfBuffProvider
			BuffType = ThermalActivity
			BuffMultiplier = Overclock_HeatProductionFactor
		}

		Overclock_HeatProductionFactor
		{
			Type = MultiValue
			Values = [Overclock_BoostPowerUsedHeatFactor, Overclock_SmoothedThrusterActivation]
			Mode = Multiply
		}

		Overclock_SmoothedThrusterActivation
		{
			Type = SmoothedValue
			ValueSource = Overclock_NormalizedThrusterActivation
			MaxDelta = 1 / (&../Overclock_ThrusterHeatProducer/Interval)
		}

		Overclock_NormalizedThrusterActivation
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_CombinedThrusterActivation
			ValueTwo = Overclock_MaxActivation
		}

		Overclock_CombinedThrusterActivation
		{
			Type = MultiValue
			Values = [MainThrusterProxy, MainThrusterBoostedProxy]
			Mode = Add
		}
		Overclock_IsThrusterActive
		{
			Type = ThresholdToggle
			ValueFrom = Overclock_CombinedThrusterActivation
			MinAmount = 0
			MaxAmount = 0
			Invert = true
		}

		Overclock_MaxActivation
		{
			Type = BuffableValue
			Value = &~/Part/Components/BoostOffComponents/Components/MainThruster/MaxActivation
		}

		Port_Thermal_Left : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}
		Port_Thermal_LeftUp : Port_Thermal_Left
		{
			Direction = Up
		}
		Port_Thermal_RightUp : Port_Thermal_LeftUp
		{
			Location = [1, 0]
		}
		Port_Thermal_Right : Port_Thermal_Left
		{
			Location = [1, 0]
			Direction = Right
		}

		BoostOffComponents
		{
			Type = ToggledComponents
			Toggle = BoostToggle
			Invert = true
			IncludeInBlueprints = true
			Components
			{
				MainThruster
				{
					Type = Thruster
					Location = [1, 4.5]// Relative to upper-left corner of unrotated part.
					Rotation = 90d// Relative to unrotated part.
					SoftOperationalToggle = IsOperational
					Force = &~/Part/ThrusterForce
					MinActivation = 0
					MaxActivation
					{
						BaseValue=1;
						Modifiers
						[
							{
								Type = Buff
								BuffType = Engine
								ModificationMode = Multiply
							}
							{
								Type = BuffRemap
								BuffType = Overclock
								ModificationMode = Multiply
								RemapFrom = [0, 1]
								RemapTo = [1, (&~/OVERCLOCK/THRUST_FACTOR)]
							}
						]
					}
					MinUncommandedActivation = &MinActivation
					MaxUncommandedActivation = &MaxActivation
					ActivationIncreaseTime = &~/Part/ThrustIncreaseTime
					ActivationDecreaseTime = &~/Part/ThrustDecreaseTime
					ActivationRecoveryTime = &~/Part/ThrustRecoveryTime
					FuelStorage = RealBatteryStorage
					FuelUsagePerSecond
					{
						BaseValue = &~/Part/FuelUsage
						Modifiers
						[
							{
								Type = BuffRemap
								BuffType = Overclock
								ModificationMode = Multiply
								RemapFrom = [0, 1]
								RemapTo = [1, (&~/OVERCLOCK/POWER_USAGE_FACTOR)]
							}
						]
					}
				}

				RampProgressBar
				{
					Type = ProgressBar
					ShowProgressFor = MainThruster
					ValueRange = [0, &../../MainThruster/MaxActivation]
					LowColor = [255, 127, 0]
					HighColor = [255, 127, 0]
					FullColor = [255, 127, 0]
				}
				BoostOffGraphics
				{
					Type = Graphics
					Location = [1, 2]
					OperationalToggle = IsOperational
					AnimationSpeedFactor = MainThruster
					AnimationSpeedFactorRenormalize = [0.75, 2.0]
					OperationalDoodad
					{
						Layer = "doodads_high"
						DamageLevels
						[
							{
								AnimationFiles
								[
									"../thruster_large/doodads_on1.png"
									"../thruster_large/doodads_on2.png"
									"../thruster_large/doodads_on3.png"
									"../thruster_large/doodads_on4.png"
									"../thruster_large/doodads_on5.png"
									"../thruster_large/doodads_on6.png"
									"../thruster_large/doodads_on7.png"
									"../thruster_large/doodads_on8.png"
								]
								Size = [2, 2]
								AnimationInterval = 0.075
							}
							{
								AnimationFiles
								[
									"../thruster_large/doodads_on1_33.png"
									"../thruster_large/doodads_on2_33.png"
									"../thruster_large/doodads_on3_33.png"
									"../thruster_large/doodads_on4_33.png"
									"../thruster_large/doodads_on5_33.png"
									"../thruster_large/doodads_on6_33.png"
									"../thruster_large/doodads_on7_33.png"
									"../thruster_large/doodads_on8_33.png"
								]
								Size = [2, 2]
								AnimationInterval = 0.075
							}
							{
								AnimationFiles
								[
									"../thruster_large/doodads_on1_66.png"
									"../thruster_large/doodads_on2_66.png"
									"../thruster_large/doodads_on3_66.png"
									"../thruster_large/doodads_on4_66.png"
									"../thruster_large/doodads_on5_66.png"
									"../thruster_large/doodads_on6_66.png"
									"../thruster_large/doodads_on7_66.png"
									"../thruster_large/doodads_on8_66.png"
								]
								Size = [2, 2]
								AnimationInterval = 0.075
							}
						]
					}
					OperationalLighting
					{
						Layer = "lights_add"
						Offset = [0, 0.5]
						DamageLevels
						[
							{
								AnimationFiles
								[
									"lights.png"
									"lights2.png"
								]
								Size = [2, 5]
								AnimationInterval = 0.1
							}
						]
					}
					OperationalRoofDoodad
					{
						Layer = "roof_doodads"
						Offset = [0, -0.5]
						DamageLevels
						[
							{
								File = "roof_glows.png"
								Size = [1, 3]
							}
							{
								File = "roof_glows_33.png"
								Size = [1, 3]
							}
							{
								File = "roof_glows_66.png"
								Size = [1, 3]
							}
						]
					}
					OperationalRoofLighting
					{
						Layer = "roof_lights_fancy"
						Offset = [0, 0.35]
						DamageLevels
						[
							{
								File = "./Data/ships/common/light_blob.png"
								Size = [3.5, 3.5]
								Z = 1.30 // Controls the "height" of the light for the purposes of normal mapping.
								VertexColor = [255*1.0,116*1.0, 24*1.0]
							}
						]
					}
				}
				BoostOffGraphics2
				{
					Type = Graphics
					Location = [1, 1.25]
					OperationalToggle = IsOperational
					OperationalDoodad
					{
						Layer = "doodads_high"
						DamageLevels
						[
							{
								File = "doodads_boost_off.png"
								Size = [1, 1]
							}
							{
								AnimationFiles
								[
									"doodads_boost_off1_33.png"
									"doodads_boost_off2_33.png"
									"doodads_boost_off3_33.png"
									"doodads_boost_off4_33.png"
									"doodads_boost_off5_33.png"
									"doodads_boost_off6_33.png"
									"doodads_boost_off7_33.png"
									"doodads_boost_off8_33.png"
								]
								Size = [1, 1]
								AnimationInterval = 0.075
							}
							{
								AnimationFiles
								[
									"doodads_boost_off1_66.png"
									"doodads_boost_off2_66.png"
									"doodads_boost_off3_66.png"
									"doodads_boost_off4_66.png"
									"doodads_boost_off5_66.png"
									"doodads_boost_off6_66.png"
									"doodads_boost_off7_66.png"
									"doodads_boost_off8_66.png"
								]
								Size = [1, 1]
								AnimationInterval = 0.075
							}
						]
					}
					NonOperationalDoodad
					{
						Layer = "doodads_high"
						DamageLevels
						[
							{
								File = "doodads_boost_off.png"
								Size = [1, 1]
							}
							{
								File = "doodads_boost_off_33.png"
								Size = [1, 1]
							}
							{
								File = "doodads_boost_off_66.png"
								Size = [1, 1]
							}
						]
					}
				}

				BurstTrigger
				{
					Type = ThresholdTrigger
					AmountFrom = MainThruster
					MinAmount = .5
				}

				BurstEffects
				{
					Type = TriggeredEffects
					ChainedTo = MainThruster
					Trigger = BurstTrigger
					FactorMediaEffectsIntensityWith = MainThruster
					MinMediaEffectsIntensity = 1%
					AnchorMediaEffects = true
					MediaEffects
					[
						&<../thruster_large/particles/thruster_sparks_large.rules>
						: /COMMON_SOUNDS/ThrusterBurst
						{
							RandomSounds = ["../thruster_large/sounds/large_thruster_start_01.wav",
											"../thruster_large/sounds/large_thruster_start_02.wav"]
							Speed = 1
							Volume = 1
						}
					]
				}
			}
		}

		BoostOnComponents
		{
			Type = ToggledComponents
			Toggle = BoostToggle
			Components
			{
				MainThrusterBoosted
				{
					Type = Thruster
					Location = [1, 4.5]// Relative to upper-left corner of unrotated part.
					Rotation = 90d// Relative to unrotated part.
					SoftOperationalToggle = IsOperational
					Force = &~/Part/BoostedThrusterForce
					MinActivation = 0
					MaxActivation : ~/Part/Components/BoostOffComponents/Components/MainThruster/MaxActivation
					{
						Modifiers
						[
							&../^/0/Modifiers/0
							// Overclock modifier
							: ../^/0/Modifiers/1
							{
								RemapTo = [1, (&~/OVERCLOCK/BOOST_THRUST_FACTOR)]
							}
						]
					}
					MinUncommandedActivation = &MinActivation
					MaxUncommandedActivation = &MaxActivation
					ActivationIncreaseTime = &~/Part/BoostedThrustIncreaseTime
					ActivationDecreaseTime = &~/Part/BoostedThrustDecreaseTime
					ActivationRecoveryTime = &~/Part/BoostedThrustRecoveryTime
					FuelStorage = RealBatteryStorage
					FuelUsagePerSecond : ~/Part/Components/BoostOffComponents/Components/MainThruster/FuelUsagePerSecond
					{
						BaseValue = &~/Part/BoostedFuelUsage
						Modifiers : ^/0/Modifiers
						[
							: ^/0/0 {
								BuffType = BoostOverclockPowerRamp
								RemapTo = [1, (&~/OVERCLOCK/BOOST_MAX_POWER_USAGE_FACTOR)]
							}
						]
					}
				}

