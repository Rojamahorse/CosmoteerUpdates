		ThrustEffects
		{
			Type = ContinuousEffects
			Location = [1, 4.5+14/64]
			Rotation = 90d
			OperationalToggle = IsOverclocked
			InvertOperationalToggle = true
			FactorMediaEffectsIntensityWith = MainThrusterProxy
			IntensityTweenDuration = 0.1
			MinMediaEffectsIntensity = 1%
			PlayEndMediaOnNonOperational = false
			MediaEffects
			[
				&<../thruster_large/particles/thruster_plume_large.rules>
				&<../thruster_large/particles/thruster_plume_light_large.rules>
				&<../thruster_large/particles/thruster_fire_large.rules>
				&<../thruster_large/particles/thruster_smoke_large.rules>
				&<../thruster_large/particles/thruster_sparks_large.rules>

				: /COMMON_SOUNDS/ThrusterRumble
				{
					Sound = "../thruster_large/sounds/large_thruster_loop_01.wav"
					Volume = 1
					Speed = 1
					MaxConcurrentVolume = 1
				}

				: /COMMON_SOUNDS/ThrusterRumbleFadeIn
				{
					Sound = "../thruster_large/sounds/large_thruster_loop_02.wav"
					Volume = 1
					Speed = 1
					MaxConcurrentVolume = 1
				}
			]
			EndMediaEffects
			[
				: /COMMON_SOUNDS/ThrusterBurst
				{
					RandomSounds = ["../thruster_large/sounds/large_thruster_finish_01.wav",
									"../thruster_large/sounds/large_thruster_finish_02.wav"]
					Volume = 1
					Speed = 1
				}
			]
		}

		Overclock_ThrustEffects : ThrustEffects
		{
			InvertOperationalToggle = false
			MediaEffects
			[
				// Particles
				&../^/0/MediaEffects/0
				&../^/0/MediaEffects/1
				&../^/0/MediaEffects/2
				&../^/0/MediaEffects/3
				&../^/0/MediaEffects/4

				// SFX loop
				: ../^/0/MediaEffects/5
				{
					Volume = (&^/0/Volume) * db2vol("&~/OVERCLOCK/AUDIO_VOLUME_DB")
					Speed = (&^/0/Speed) * (&~/OVERCLOCK/AUDIO_SPEED_FACTOR)
					MaxConcurrentVolume = (&^/0/MaxConcurrentVolume) * db2vol("&~/OVERCLOCK/AUDIO_VOLUME_DB")
				}
				: ../^/0/MediaEffects/6
				{
					Volume = (&^/0/Volume) * db2vol("&~/OVERCLOCK/AUDIO_VOLUME_DB")
					Speed = (&^/0/Speed) * (&~/OVERCLOCK/AUDIO_SPEED_FACTOR)
					MaxConcurrentVolume = (&^/0/MaxConcurrentVolume) * db2vol("&~/OVERCLOCK/AUDIO_VOLUME_DB")
				}

				: /COMMON_SOUNDS/ThrusterRumble
				{
					RandomSounds
					[
						"../thruster_small/sounds/thruster_overclocked_01.wav"
						"../thruster_small/sounds/thruster_overclocked_02.wav"
						"../thruster_small/sounds/thruster_overclocked_03.wav"
						"../thruster_small/sounds/thruster_overclocked_04.wav"
					]
					Speed = 2.5
					Db = -5
				}
			]
			EndMediaEffects
			[
				: ../^/0/EndMediaEffects/0
				{
					Speed = (&^/0/Speed) * (&~/OVERCLOCK/AUDIO_SPEED_FACTOR)
					Volume = (&^/0/Volume) * db2vol("&~/OVERCLOCK/AUDIO_VOLUME_DB")
					// MaxConcurrentVolume = (&^/0/MaxConcurrentVolume) * db2vol("&~/OVERCLOCK/AUDIO_VOLUME_DB")
				}
			]
		}

