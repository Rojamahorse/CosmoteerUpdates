OVERCLOCK
{
	BONUS_FORCE = 500
	THRUST_HEAT_PER_SECOND = 250
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Part : <../base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/ThrusterRocketExtender"
	IconNameKey = "Parts/ThrusterRocketExtenderIcon"
	ID = cosmoteer.thruster_rocket_extender // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroup = "Flight"
	DescriptionKey = "Parts/ThrusterRocketExtenderDesc"
	Resources
	[
		[steel, 60]
		[coil2, 15]
	]
	TypeCategories = [thruster, uses_power]
	Size = [3, 2]
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "thrusters"
	MaxHealth = 6000
	ReceivableBuffs : ^/0/ReceivableBuffs [Engine, EnginePowerDistribution, EngineHeatCollection, Rocket, RocketExtraForce, RocketOperation, RocketBatteryConnection, ThermalActivity]
	BlockedTravelCells
	[
		[1, 1]
	]
	ForceManhattanPathInPart = true
	AllowedDoorLocations
	[
		[0, -1]
		[2, -1]
		[-1, 0]
		[-1, 1]
		[3, 0]
		[3, 1]
		[0, 2]
		[2, 2]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 48]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, CommandToggle, RocketOperationBuffToggle, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		IsConnected
		{
			Type = MultiToggle
			Toggles = [PowerToggle, IsConnectedProxy]
			Mode = All
		}
		IsConnectedProxy
		{
			Type = ToggleProxy
			PartLocation = [0, 2]
			ComponentID = IsConnected
			PartCriteria
			{
				IDs = [cosmoteer.thruster_rocket_nozzle, cosmoteer.thruster_rocket_extender]
				Rot = 0
				Left = 0
				Right = 3
				Top = 2
			}
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandToggle
		{
			Type = CommandToggle
		}

		LocalBatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		LeftBatteryStorage
		{
			Type = ResourceStorageProxy
			ResourceType = battery
			PartLocation = [-1, 0]
			ComponentID = LocalBatteryStorage
			PartCriteria
			{
				ID = cosmoteer.thruster_rocket_battery
				Rot = 0
				Top = 0
				Bottom = 2
				Right = 0
			}
		}
		RightBatteryStorage
		{
			Type = ResourceStorageProxy
			ResourceType = battery
			PartLocation = [3, 0]
			ComponentID = LocalBatteryStorage
			PartCriteria
			{
				ID = cosmoteer.thruster_rocket_battery
				Rot = 0
				Top = 0
				Bottom = 2
				Left = 3
			}
		}
		ExtendableBatteryStorage
		{
			Type = MultiResourceStorage
			ResourceType = battery
			ResourceStorages = [LocalBatteryStorage, LeftBatteryStorage, RightBatteryStorage]
		}
		PrevPowerToggle
		{
			Type = ToggleProxy
			PartLocation = [0, -1]
			ComponentID = PowerToggle
			PartCriteria
			{
				ID = cosmoteer.thruster_rocket_extender
				Rot = 0
				Left = 0
				Right = 3
				Bottom = 0
			}
		}
		PrevCombinedBatteryStorage
		{
			Type = ResourceStorageProxy
			ResourceType = battery
			PartLocation = [0, -1]
			ComponentID = CombinedBatteryStorage
			ProxyToggle = PrevPowerToggle
			PartCriteria
			{
				ID = cosmoteer.thruster_rocket_extender
				Rot = 0
				Left = 0
				Right = 3
				Bottom = 0
			}
		}
		ToggledExtendableBatteryStorage
		{
			Type = ResourceStorageProxy
			ResourceType = battery
			ComponentID = ExtendableBatteryStorage
			ProxyToggle = ExtendableBatteryStorage
			LimitMaxResources = &../LocalBatteryStorage/MaxResources
		}
		CombinedBatteryStorage
		{
			Type = MultiResourceStorage
			ResourceType = battery
			ResourceStorages = [ToggledExtendableBatteryStorage, PrevCombinedBatteryStorage]
			AddMode = DistributeProportionallyByCapacity
			RemoveMode = DistributeProportionallyByCapacity
		}

		LocalPowerDistributionBuffToggle
		{
			Type = BuffToggle
			BuffType = EnginePowerDistribution
		}
		LeftPowerDistributionBuffToggle
		{
			Type = ToggleProxy
			PartLocation = [-1, 0]
			ComponentID = LocalPowerDistributionBuffToggle
			PartCriteria
			{
				ID = cosmoteer.thruster_rocket_battery
				Rot = 0
				Top = 0
				Right = 0
			}
		}
		RightPowerDistributionBuffToggle
		{
			Type = ToggleProxy
			PartLocation = [3, 0]
			ComponentID = LocalPowerDistributionBuffToggle
			PartCriteria
			{
				ID = cosmoteer.thruster_rocket_battery
				Rot = 0
				Top = 0
				Left = 3
			}
		}
		ExtendablePowerDistributionBuffToggle
		{
			Type = MultiToggle
			Toggles = [LocalPowerDistributionBuffToggle, LeftPowerDistributionBuffToggle, RightPowerDistributionBuffToggle]
			Mode = Any
		}
		ToggledBatteryConsumer
		{
			Type = ToggledComponents
			Toggle = ExtendablePowerDistributionBuffToggle
			Invert = true
			IncludeInBlueprints = true
			Components
			{
				BatteryConsumer
				{
					Type = ResourceConsumer
					ResourceType = battery
					Storage = ExtendableBatteryStorage
					DefaultPriority = &/PRIORITIES/Thruster_Supply
					ResupplyThreshold = 500
					OperationalToggle = IsConnected
				}
			}
		}

		RocketBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = Rocket
			BuffAmount = { BaseValue=0; BuffType=Rocket; BuffMode=Add; }
			BuffArea = [0, 2, 3, 1]
			OperationalToggle = IsOperational
			ChainsFromBuffType = Rocket
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 3
				Top = 2
			}
		}

		EngineBuffProvider
		{
			Type = SelfBuffProvider
			BuffType = Rocket
			ChainsFromBuffType = Engine
			BuffAmount = { BaseValue=100%; BuffType=Engine; BuffMode=Multiply; }
			OperationalToggle = ExtendableBatteryStorage
		}

		RocketOperationBuffToggle
		{
			Type = BuffToggle
			BuffType = RocketOperation
		}

		RocketOperationBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = RocketOperation
			BuffAmount = { BaseValue=1; BuffType=RocketOperation; BuffMode=Multiply; }
			BuffArea = [0, -1, 3, 1]
			OperationalToggle = IsOperational
			ChainsFromBuffType = RocketOperation
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 3
				Bottom = 0
			}
		}

		RocketExtraForceReceivedValue
		{
			Type = BuffableValue
			Value = { BaseValue = 0; BuffType = RocketExtraForce; BuffMode = Add; }
		}
		RocketExtraForceSelfValue
		{
			Type = BuffableValue
			Value = { BaseValue = 0; BuffType = Overclock; BuffMode = Lerp; MinValue = 0; MaxValue = &~/OVERCLOCK/BONUS_FORCE }
		}
		RocketExtraForceTotalBuffValue
		{
			Type = MultiValue
			Values = [RocketExtraForceReceivedValue, RocketExtraForceSelfValue]
			Mode = Add
		}
		RocketExtraForceBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = RocketExtraForce
			BuffMultiplier = RocketExtraForceTotalBuffValue
			BuffArea = [0, 2, 3, 1]
			OperationalToggle = IsOperational
			ChainsFromBuffType = RocketExtraForce
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 3
				Top = 2
			}
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}
		
		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_EngineHeatCollectionBuffToggle
		{
			Type = BuffToggle
			BuffType = EngineHeatCollection
		}
		ForceOverclockTrigger
		{
			Type = ToggleTrigger
			Toggle = Overclock_EngineHeatCollectionBuffToggle
			AllowOperationalBypass = true
			TriggerWhenOff = false
		}

		// Overriding to allow forcing on / locking
		OverclockModeToggle : ^/0/OverclockModeToggle
		{
			AutoOnTrigger = ForceOverclockTrigger
			OperationalToggle = Overclock_EngineHeatCollectionBuffToggle
			InvertOperationalToggle = true
		}

		Overclock_CombinedHeatInput
		{
			Type = MultiResourceStorage
			ResourceType = heat
			ResourceStorages = [ NetworkHeatInput ]
			ViaBuffs
			{
				IncomingBuffTypes = [ EngineHeatCollection ]
				ComponentIDs = [ EngineHeatCollectionStorage ]
			}
		}
		
		// Overriding to use the combined heat input
		HeatDistributionStorage : ^/0/HeatDistributionStorage
		{
			ResourceStorages = [Overclock_CombinedHeatInput, OverflowHeatStorage]
		}

		Overclock_ThrustHeatProducer
		{
			Type = ResourceConverter
			OperationalToggle = IsOperationalOverclocked
			HEAT_PER_INTERVAL = ceil((&~/OVERCLOCK/THRUST_HEAT_PER_SECOND) * (&Interval))
			ToQuantity
			{
				BaseValue = (&../HEAT_PER_INTERVAL) * (&~/HEAT_TO_RESOURCE)
				BuffType = ThermalActivity
				BuffMode = Multiply
			}
			ToStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Interval = 0.5
		}
		
		Overclock_ActivationBuff
		{
			Type = SelfBuffProvider
			BuffType = ThermalActivity
			BuffMultiplier = Overclock_SmoothedThrusterActivation
		}
		
		Overclock_SmoothedThrusterActivation
		{
			Type = SmoothedValue
			ValueSource = Overclock_ThrusterActivation
			MaxDelta = 1 / (&../Overclock_ThrustHeatProducer/Interval)
		}
		Overclock_ThrusterActivation
		{
			Type = BuffableValue
			Value
			{
				BaseValue = -1
				MinValue = 0
				MaxValue = 1
				BuffType = RocketOperation
				BuffMode = Add
			}
		}

		Port_Thermal_Left0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 0]
			Direction = Left
		}
		Port_Thermal_Left1 : Port_Thermal_Left0
		{
			Location = [0, 1]
		}
		Port_Thermal_Up0 : Port_Thermal_Left0
		{
			Location = [0, 0]
			Direction = Up
		}
		Port_Thermal_Up1 : Port_Thermal_Up0
		{
			Location = [2, 0]
		}
		Port_Thermal_Right0 : Port_Thermal_Left0
		{
			Location = [2, 0]
			Direction = Right
		}
		Port_Thermal_Right1 : Port_Thermal_Right0
		{
			Location = [2, 1]
		}
		Port_Thermal_Down0 : Port_Thermal_Left0
		{
			Location = [0, 1]
			Direction = Down
		}
		Port_Thermal_Down1 : Port_Thermal_Down0
		{
			Location = [2, 1]
		}

		Graphics
		{
			Type = Graphics
			Location = [1.5, 1]
			OperationalToggle = IsOperational
			AnimationToggle = ExtendableBatteryStorage
			AnimationSpeedFactor = MainThruster
			AnimationSpeedFactorRenormalize = [0.75, 2.0]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [3, 2]
					}
					{
						File = "floor_33.png"
						Size = [3, 2]
					}
					{
						File = "floor_66.png"
						Size = [3, 2]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_high"
				Offset = [0, 0.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
							"doodads_on5.png"
							"doodads_on6.png"
							"doodads_on7.png"
							"doodads_on8.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.075
					}
					{
						AnimationFiles
						[
							"doodads_on1_33.png"
							"doodads_on2_33.png"
							"doodads_on3_33.png"
							"doodads_on4_33.png"
							"doodads_on5_33.png"
							"doodads_on6_33.png"
							"doodads_on7_33.png"
							"doodads_on8_33.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.075
					}
					{
						AnimationFiles
						[
							"doodads_on1_66.png"
							"doodads_on2_66.png"
							"doodads_on3_66.png"
							"doodads_on4_66.png"
							"doodads_on5_66.png"
							"doodads_on6_66.png"
							"doodads_on7_66.png"
							"doodads_on8_66.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.075
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"lights.png"
							"lights2.png"
						]
						Size = [3, 2]
						AnimationInterval = 0.1
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [3, 2]
					}
					{
						File = "walls_33.png"
						Size = [3, 2]
					}
					{
						File = "walls_66.png"
						Size = [3, 2]
					}
				]
			}
			OperationalRoofDoodad
			{
				Layer = "roof_doodads"
				DamageLevels
				[
					{
						File = "roof_glows.png"
						Size = [3, 2]
					}
					{
						File = "roof_glows_33.png"
						Size = [3, 2]
					}
					{
						File = "roof_glows_66.png"
						Size = [3, 2]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [0, 28/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [3, 3]
						Z = 2.50 // Controls the "height" of the light for the purposes of normal mapping.
						VertexColor = [255*1.0,116*1.0, 24*1.0]
					}
				]
			}
		}

		RoofComponents
		{
			Type = ToggledComponents
			Toggle = PrevPowerToggle
			Components
			{
				RoofGraphics
				{
					Type = Graphics
					Location = [1.5, 1]
					Roof
					{
						Layer = "roofs"
						DamageLevels
						[
							{
								File = "roof.png"
								NormalsFile = "roof_normals.png"
								Size = [3, 2]
							}
							{
								File = "roof_33.png"
								NormalsFile = "roof_normals_33.png"
								Size = [3, 2]
							}
							{
								File = "roof_66.png"
								NormalsFile = "roof_normals_66.png"
								Size = [3, 2]
							}
						]
					}
				}
			}
		}
		RoofTipComponents
		{
			Type = ToggledComponents
			Toggle = PrevPowerToggle
			Invert = true
			Components
			{
				RoofTipGraphics
				{
					Type = Graphics
					Location = [1.5, 1]
					Roof
					{
						Layer = "roofs"
						DamageLevels
						[
							{
								File = "roof_tip.png"
								NormalsFile = "roof_normals_tip.png"
								Size = [3, 2]
							}
							{
								File = "roof_tip_33.png"
								NormalsFile = "roof_normals_tip_33.png"
								Size = [3, 2]
							}
							{
								File = "roof_tip_66.png"
								NormalsFile = "roof_normals_tip_66.png"
								Size = [3, 2]
							}
						]
					}
				}
			}
		}

		BatterySprites
		{
			Type = ResourceSprites
			Location = [96/64, 75/64]
			ResourceStorage = LocalBatteryStorage
			Layer = "doodads_low"
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
					Offset = [-45/64, 0]
				}
				{
					File = "batteries2.png"
					Size = [3, 1]
				}
			]
		}

		MainThruster
		{
			Type = ValueProxy
			PartLocation = [0, 2]
			ComponentID = MainThruster
			PartCriteria
			{
				IDs = [cosmoteer.thruster_rocket_nozzle, cosmoteer.thruster_rocket_extender]
				Rot = 0
				Left = 0
				Right = 3
				Top = 2
			}
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/MedPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [1.5, 1]
		}

		ThrusterHum
		{
			Type = ContinuousEffects
			Location = [1.5, 1]
			OperationalToggle = IsOperational
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				: /COMMON_SOUNDS/ThrusterHum
				{
					Volume = .3
					Speed = .75
					MaxConcurrentVolume = 1
				}
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}

				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}

				// Missing component
				{
					Toggle = IsConnected
					ShowInBuildMode = true
					AtlasSprite
					{
						File = &/INDICATORS/MissingComponent
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = ExtendableBatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				
				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 2]
		}
		
		PeakHeatGenerationStatValue
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/THRUST_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationStatValue
		}
	}

	Stats
	{
		PowerCapacity = (&~/Part/Components/LocalBatteryStorage/MaxResources) / 1000
		ThrusterBuff = (&~/Part/Components/EngineBuffProvider/BuffAmount/BaseValue) * 100

		RecPower = &<../thruster_rocket_nozzle/thruster_rocket_nozzle.rules>/Part/Stats/RecPower
		RecCrew = &<../thruster_rocket_nozzle/thruster_rocket_nozzle.rules>/Part/Stats/RecCrew
	}
	
	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		Stats
		{
			ThrusterBonusForce = (&~/OVERCLOCK/BONUS_FORCE)
			ThrusterHeatGeneration = &~/OVERCLOCK/THRUST_HEAT_PER_SECOND
		}
	}
}