		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [4, 5]
		}

		PeakHeatGenerationValue
		{
			Type = StaticValue
			SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Part/SecondaryToolTip/StatsByCategory/0/Stats/ROF)
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND) + (&SHOT_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}
	}

	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		AmmoCapacity = (&~/Part/Components/AmmoStorage/GridRect/2) * (&~/Part/Components/AmmoStorage/GridRect/3) * (&<./Data/resources/bullet/bullet.rules>/MaxStackSize) + (&~/Part/Components/LoadedAmmo1/MaxResources) + (&~/Part/Components/LoadedAmmo2/MaxResources)

		RecAmmo = &../StatsByCategory/0/Stats/AmmoPerSecond
		RecCrew = (&CrewRequired) + (&RecAmmo) * 2

		CrewStunDuration = [0, &~/Part/Components/StunEffect/HitEffects/0/Duration/BaseValue]
		CrewStunRadius = &~/Part/Components/StunEffect/HitEffects/0/Radius/BaseValue
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/BulletDeck"
			Stats
			{
				DamagePerShot = &~/Part/Components/Emitters_NonOverclocked/Components/BaseEmitter/Bullet/Components/Hit/HitOperational/HitEffects/0/Damage/BaseValue
				DamagePerSecond = (&DamagePerShot) * (&ROF)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				Penetration = &~/Part/Components/Emitters_NonOverclocked/Components/BaseEmitter/Bullet/Components/Hit/Penetration
				FireChance = (&~/Part/Components/Emitters_NonOverclocked/Components/BaseEmitter/Bullet/Components/Hit/PenetratingOperational/HitEffects/1/StatusChance/BaseValue) * 100
				ROF = 1 / (&~/Part/Components/ShootAlternatingComponents_NonOverclocked/Components/FireTimer/Duration)
				Range = &~/Part/Components/Emitters_NonOverclocked/Components/BaseEmitter/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				Spread = deg(&~/Part/Components/Emitters_NonOverclocked/Components/BaseEmitter/Spread/1)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = &~/Part/Components/Emitters_NonOverclocked/Components/BaseEmitter/Bullet/Speed
				ShotHP = &~/Part/Components/Emitters_NonOverclocked/Components/BaseEmitter/Bullet/Components/Targetable/Health
				AmmoPerShot = &~/Part/Components/Emitters_NonOverclocked/Components/BaseEmitter/ResourcesUsed
				AmmoPerSecond = (&AmmoPerShot) * (&ROF)
				ShotAmmoUsage = [&../AmmoPerShot, &../AmmoPerSecond]
			}
		}
	]

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		Stats
		{
			CrewStunDuration = [0, &~/OVERCLOCK/CREW_STUN_DURATION]
			CrewStunRadius = &~/OVERCLOCK/CREW_STUN_RADIUS
		}
		StatsByCategory
		[
			{
				NameKey = "StatCategories/BulletDeckOverclocked"
				Stats
				{
					DamagePerShot = &~/OVERCLOCK/BULLET/DAMAGE_POOL
					DamagePerSecond = (&DamagePerShot) * (&ROF)
					Damage = [&../DamagePerShot, &../DamagePerSecond]
					PenetrationDamagePool = [infinity, &../DamagePerShot]
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					HeatGeneration = (&~/OVERCLOCK/HEAT_PER_SECOND)
					FIRE_INTERVAL = ((&~/Part/Components/ShootAlternatingComponents_NonOverclocked/Components/FireTimer/Duration) / (&~/OVERCLOCK/FIRE_RATE_FACTOR))
					ROF = 1 / (&FIRE_INTERVAL)
					Spread = deg(&~/OVERCLOCK/HALF_SPREAD)
					Range = &~/OVERCLOCK/BULLET/Range
					ShotSpeed = &~/OVERCLOCK/BULLET/Speed
//					ShotHP = &~/OVERCLOCK/BULLET/HEALTH
				}
			}
		]
	}
}