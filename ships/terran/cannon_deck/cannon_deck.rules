					Type = AreaCrewStun
					Duration = { BaseValue=0.5; BuffType=Overclock; BuffMode=Lerp; MinValue=&BaseValue; MaxValue=&~/OVERCLOCK/CREW_STUN_DURATION; }
					Falloff = 1
					Radius = { BaseValue=6; BuffType=Overclock; BuffMode=Lerp; MinValue=&BaseValue; MaxValue=&~/OVERCLOCK/CREW_STUN_RADIUS; }
