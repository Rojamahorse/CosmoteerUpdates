		Indicators
		{
			Type = IndicatorSprites
			Location = [2,2]
			Layer = "indicators"
			Indicators
			[
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
				}
				{
					Toggle = BatteryStorage
					Delay = &~/Part/Components/Turret/FireInterval
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
				{
					Toggle = FireSafetyToggle
					ShowWhenToggleOn = false
					AtlasSprite : /INDICATORS/FullHeat
					{
						Size = [1, 1]
					}
				}
			]
		}

