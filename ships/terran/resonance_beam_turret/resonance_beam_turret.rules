	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000

		RecPower = &../StatsByCategory/0/Stats/PowerUsageContinuous
		RecCrew = (&CrewRequired) + (&RecPower) * 4

		HeatCapacity = (&~/Part/Components/HeatStorage/MaxResources) / (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
		OverclockTransitionTime = &~/Part/Components/OverclockStateTween/OnTweenDuration
		HeatDissipation = (&~/Part/Components/HeatDissipationConverter/FromQuantity) / (&~/Part/Components/HeatDissipationConverter/Interval) / (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
//		HeatFireThreshold = &~/Part/Components/OverflowHeatStorage/TriggerThreshold
//		HeatFireChance = &~/Part/Components/FireFromHeatEffect/HitEffects/0/FireChance
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/ResonanceBeam"
			Stats
			{
				HitInterval = &~/Part/Components/BeamEmitter/HitInterval
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed/BaseValue)
				Range = &~/Part/Components/BeamEmitter/Range/BaseValue
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				PowerPerShot = (&~/Part/Components/BeamEmitter/ResourcesUsed) / 1000
				PowerUsageContinuous = (&PowerPerShot) / (&~/Part/Components/Turret/FireInterval)
				ResonanceTurretHeatGeneration = (&~/Part/Components/BaseHeatGeneration/Value)

				HeatPerTileContinuous = (&~/Part/Components/BeamEmitter/BASE_HEAT) / (&HitInterval)
				ResonanceHeatPool = [(&~/Part/Components/BeamEmitter/BASE_HEAT_POOL) / (&../HitInterval), &~/Part/Components/BeamEmitter/HEAT_POOL_AMP_EXPONENT]
				DilationHeatSpreadDistance = &~/Part/Components/BeamEmitter/BASE_HEAT_SPREAD_BUDGET
//				HitShieldHeatFactor = (&~/Part/Components/BeamEmitter/SHIELD_HEAT_FACTOR) * 100

				SHIELD_OVERLOAD_BASE = (&~/Part/Components/BeamEmitter/SHIELD_OVERLOAD_BASE)
				SHIELD_OVERLOAD_PER_AMP = (&~/Part/Components/BeamEmitter/SHIELD_OVERLOAD_PER_AMP)
				SHIELD_OVERLOAD_PER_DILATION = (&~/Part/Components/BeamEmitter/SHIELD_OVERLOAD_PER_DILATION)
				ShieldDamagePowerCost = [ (&../SHIELD_OVERLOAD_BASE) * 100, (&../SHIELD_OVERLOAD_PER_AMP) * 100, (&../SHIELD_OVERLOAD_PER_DILATION) * 100 ]

				BaseAmplification = (&~/Part/Components/BaseAmplification/Value) * 100
				BaseDilation = (&~/Part/Components/BaseDilation/Value) * 100
			}
		}
