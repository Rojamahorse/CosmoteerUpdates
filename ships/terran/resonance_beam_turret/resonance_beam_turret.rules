Part : <../base_part_terran.rules>/Part
{
	NameKey = "Parts/ResonanceBeamTurret"
	IconNameKey = "Parts/ResonanceBeamTurretIcon"
	ID = cosmoteer.resonance_beam_turret
	OtherIDs = []
	EditorGroups = [ "WeaponsEnergy" ]
	DescriptionKey = "Parts/ResonanceBeamTurretDesc"
	Resources
	[
		[steel, 60]
		[coil2, 15]
		[tristeel, 10]
		[diamond, 2]
	]
	Size = [4,4]
	PhysicalRect = [0, 0, 4, 4]
	SaveRect = &PhysicalRect
	SelectionPriority = 1
	SelectionTypeByRotation = true
	MaxHealth = 12500
	TypeCategories = [weapon, uses_power, is_crewed, heat_resistant]
	ReceivableBuffs : ^/0/ReceivableBuffs [ThermalIntensity, ThermalRadius, ThermalShieldPiercing, ThermalActivity, Overclock]
	Flammable = false
	ProhibitedBy : ^/0/ProhibitedBy [tall]
	ProhibitRects
	[
		[tall, [-2, -2, 8, 2]]
		[tall, [-2, 0, 2, 6]]
		[tall, [4, 0, 2, 6]]
		[tall, [0, 4, 1, 2]]
		[tall, [3, 4, 1, 2]]
	]
	BlockedTravelCells
	[
		[1, 0], [2, 0]
		[1, 1], [2, 1]
	]
	ForceManhattanPathInPart = true
	BlockedTravelCellDirections
	[
		{
			Key = [1, 2]
			Value = [Right]
		}
		{
			Key = [2, 2]
			Value = [Left]
		}
	]
	AllowedDoorLocations
	[
		[0, -1]
		[3, -1]
		[-1,  1]
		[-1,  2]
		[ 4,  1]
		[ 4,  2]
		[ 1,  4]
		[ 2,  4]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Point
			MipLevels = max
		}
		Size = [61.3, 92]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 8
		}

		// Heat safety
		HeatProducedPerInterval
		{
			Type = BuffableValue
			Value = &../HeatGenerationConverter/ToQuantity
		}
		HeatProductionIntervalsPerEmission
		{
			Type = StaticValue
			Value = "ceil((&../BeamEmitter/Duration) / (&../HeatGenerationConverter/Interval))"
		}
		HeatProducedPerEmission
		{
			Type = MultiValue
			Values = [ HeatProducedPerInterval, HeatProductionIntervalsPerEmission ]
			Mode = Multiply
		}

		AnticipatedSelfHeatProduction
		{
			Type = ValueProxy
			ProxyToggle = IsFiring
			ComponentID = HeatProducedPerEmission
		}
		Networked_AnticipatedSelfHeatProduction
		{
			Type = NetworkValue
			ValueSource = AnticipatedSelfHeatProduction
			Categories = [ anticipated_heat_generation ]
		}
		Network_AnticipatedHeatProduction
		{
			Type = NetworkValueReceiver
			Mode = Add
			AllowUncategorized = false
			Categories = [ anticipated_heat_generation ]
		}
		AnticipatedRemainingHeatCapacity
		{
			Type = ValueOperation
			Operator = Subtract
			ValueOne = { ID = NetworkHeatInput; ValueID = "RemainingCapacity" }
			ValueTwo = Network_AnticipatedHeatProduction
		}
		EmissionsUntilHeatFull
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = AnticipatedRemainingHeatCapacity
			ValueTwo = HeatProducedPerEmission
			NaNFallbackValue = 1;
		}
		HasCapacityForBeamDurationHeatProduction
		{
			Type = ThresholdToggle
			ValueFrom = EmissionsUntilHeatFull
			MinAmount = 1
		}

//		HeatProductionIntervalsUntilFull
//		{
//			Type = ValueOperation
//			Operator = Divide
//			ValueOne = { ID = NetworkHeatInput; ValueID = "RemainingCapacity" }
//			ValueTwo = HeatProducedPerInterval
//			NaNFallbackValue = 1
//		}
//		HasCapacityForBeamDurationHeatProduction
//		{
//			Type = ThresholdToggle
//			ValueFrom = HeatProductionIntervalsUntilFull
//			// The number of heat production ticks that could occur from a single beam emitter trigger
//			MinAmount = "ceil((&../BeamEmitter/Duration) / (&../HeatGenerationConverter/Interval))"
//		}

		SafetyToggle
		{
			Type = UIToggle
			ToggleID = "thermal_safety"
			Default = 1
		}

//		OverclockModeToggle
//		{
//			Type = UIToggle
//			ToggleID = "thermal_overclock"
//			Default = 0
//		}
		OverclockModeToggle { Type = StaticToggle; ToggleOn = false; }

		SafeModeFireToggle
		{
			Type = MultiToggle
			Mode = All
			Toggles
			[
				SafetyToggle,
				HasCapacityForBeamDurationHeatProduction
			]
		}
		FireSafetyToggle
		{
			Type = MultiToggle
			Mode = Any
			Toggles
			[
				{
					Toggle = SafetyToggle
					Invert = true
				}
				SafeModeFireToggle
			]
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		FirePermissionToggle
		{
			Type = MultiToggle
			Mode = All
			Toggles  [FireSafetyToggle, FireModeToggle]
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 24000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}

		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 500
			OperationalToggle = PowerToggle
		}

		IsFiringTimer
		{
			Type = Timer
			Duration = &../BeamEmitter/Duration
			StartTrigger = BeamEmitter
			ResetTrigger = BeamEmitter
			StartExpired = true
			InvertToggle = true
		}

		IsFiring
		{
			Type = MultiToggle
			Toggles = [IsFiringTimer]
			Mode = All
		}

		HeatStorage
		{
			Type = ResourceStorage
			ResourceType = heat
			MAX_STATUS_HEAT = 5000
			MaxResources = (&MAX_STATUS_HEAT) * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
			InitToMaxResources = 0
			IgnoreResourcesForInitToMax = true
		}

		NetworkedHeatStorage
		{
			Type = NetworkResourceStore
			ResourceType = heat
			ResourceStorage = HeatStorage
			Categories = [ thermal_storage ]
		}

		NetworkHeatInput
		{
			Type = NetworkResourceInput
			ResourceType = heat
			Mode = DistributeProportionallyByAvailable
			Categories = [ thermal_storage ]
		}

		OverflowHeatStorage
		{
			Type = ResourceConsumingStorage
			ResourceType = heat
			TriggerThreshold = 0
			ProvidedValuePerResource = (&<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO)
		}

		HeatDistributionStorage
		{
			Type = MultiResourceStorage
			ResourceType = heat
			ResourceStorages = [NetworkHeatInput, OverflowHeatStorage]
			AddMode = InOrder
			RemoveMode = InReverseOrder
		}

		HeatGenerationConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsFiring
			ToStorage = HeatDistributionStorage
			ToQuantity
			{
				BaseValue = (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO) * (&../Interval)
				BuffType = ThermalActivity
				BuffMode = Multiply
			}
			Interval = 0.5
		}

		NetworkHeatOutput
		{
			Type = NetworkResourceOutput
			ResourceType = heat
			Mode = DistributeProportionallyByAvailable
		}

		HeatDissipationConverter
		{
			Type = ResourceConverter
			FromStorage = NetworkHeatOutput
			MinFromQuantityForConversion = 1
			BASE_DISSIPATION = 50
			DISSIPATION_PER_SECOND = (&BASE_DISSIPATION) / (&Interval)
			FromQuantity = (&BASE_DISSIPATION) * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
			Interval = 0.5
		}

		OverclockStateTween
		{
			Type = ValueTween
			IsOnToggle = OverclockModeToggle
			OnTweenDuration = 5;
			OffTweenDuration = 5;
		}
		OverclockBuff
		{
			Type = SelfBuffProvider
			BuffType = Overclock
			BuffMultiplier = OverclockStateTween
		}
		OverclockPowerUsageFactor
		{
			Type = ValueLerp
			InputValue = OverclockStateTween
			OutputRange = [1, 1.5]
		}
		OverclockUtilizationFactor
		{
			Type = ValueLerp
			InputValue = OverclockStateTween
			OutputRange = [1, 1.1]
		}

		BasePumpUtilization
		{
			Type = ValueTween
			IsOnToggle = IsFiring
			OnValue = 1
			OnTweenDuration = 0.001
			OffTweenDuration = 0.001
		}
		PumpUtilization
		{
			Type = MultiValue
			Values = [ BasePumpUtilization, OverclockUtilizationFactor ]
			Mode = Multiply
		}

		NetworkedPumpUtilization
		{
			Type = NetworkValue
			ValueSource = PumpUtilization
			Categories = [ thermal_pump_utilization ]
		}

		Network_PumpHeatGeneration
		{
			Type = NetworkValueReceiver
			AllowUncategorized = false
			Categories = [ thermal_activity ]
			Mode = Add
		}

		BaseHeatGeneration
		{
			Type = StaticValue
			Value = 600
		}
		CombinedHeatGeneration
		{
			Type = MultiValue
			Mode = Add
			Values = [ BaseHeatGeneration, Network_PumpHeatGeneration ]
		}
		Overclock_HeatFactor
		{
			Type = ValueLerp
			InputValue = OverclockStateTween
			OutputRange = [1, 1.75]
		}
		HeatGenerationValue
		{
			Type = MultiValue
			Values = [ CombinedHeatGeneration, Overclock_HeatFactor ]
			Mode = Multiply
		}

		NetworkAmplification
		{
			Type = NetworkValueReceiver
			AllowUncategorized = false
			Categories = [ thermal_amplification ]
			Mode = Add
		}
		NetworkDilation
		{
			Type = NetworkValueReceiver
			AllowUncategorized = false
			Categories = [ thermal_dilation ]
			Mode = Add
		}

		BaseAmplification
		{
			Type = StaticValue
			Value = 100%
		}

		BaseDilation
		{
			Type = StaticValue
			Value = 50%
		}

		OverclockAmplificationFactor
		{
			Type = ValueLerp
			InputValue = OverclockStateTween
			OutputRange = [1, 1.75]
		}
		OverclockDilationFactor
		{
			Type = ValueLerp
			InputValue = OverclockStateTween
			OutputRange = [1, 0.85]
		}

		CombinedAmplification
		{
			Type = MultiValue
			Values = [ BaseAmplification, NetworkAmplification ]
			Mode = Add
		}
		CombinedDilation
		{
			Type = MultiValue
			Values = [ BaseDilation, NetworkDilation ]
			Mode = Add
		}

		AmplificationValue
		{
			Type = MultiValue
			Values = [ CombinedAmplification, OverclockAmplificationFactor ]
			Mode = Multiply
		}
		DilationValue
		{
			Type = MultiValue
			Values = [ CombinedDilation, OverclockDilationFactor ]
			Mode = Multiply
		}

		Zero
		{
			Type = StaticValue
			Value = 0
		}
		One
		{
			Type = StaticValue
			Value = 1
		}
		NegOne
		{
			Type = StaticValue
			Value = -1
		}

		ThermalIntensityBuff
		{
			Type = SelfBuffProvider
			BuffType = ThermalIntensity
			BuffAmount = 1
			BuffMultiplier = AmplificationValue
		}
		ThermalRadiusBuff
		{
			Type = SelfBuffProvider
			BuffType = ThermalRadius
			BuffAmount = 1
			BuffMultiplier = DilationValue
		}
		ThermalActivityBuff
		{
			Type = SelfBuffProvider
			BuffType = ThermalActivity
			BuffAmount = 1
			BuffMultiplier = HeatGenerationValue
		}

		ThermalShieldPiercingDenominatorOffset
		{
			Type = StaticValue
			Value = 250
		}
		ThermalShieldPiercingExponent
		{
			Type = StaticValue
			Value = 0.85
		}
		ThermalShieldPiercingIntensity
		{
			Type = ValueOperation
			Operator = Power
			ValueOne = AmplificationValue
			ValueTwo = ThermalShieldPiercingExponent
		}
		ThermalShieldPiercingDenominator
		{
			Type = MultiValue
			Values = [ThermalShieldPiercingIntensity, ThermalShieldPiercingDenominatorOffset]
			Mode = Add
		}
		ThermalShieldPiercingMultiplier
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = ThermalShieldPiercingIntensity
			ValueTwo = ThermalShieldPiercingDenominator
			NaNFallbackValue = 0
		}
		ThermalShieldPiercingBuff
		{
			Type = SelfBuffProvider
			BuffType = ThermalShieldPiercing
			BuffAmount = 1
			BuffMultiplier = ThermalShieldPiercingMultiplier
		}

		OverheatEffects
		{
			Type = TriggeredEffects
			Location = [2, 2]
			Trigger = OverflowHeatStorage
			FactorHitEffectsWith = OverflowHeatStorage
			HitEffects = &<./Data/ships/terran/base_part_terran_overclock.rules>/Part/Components/OverheatEffects/HitEffects
		}

		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 85/64
			IsHigh = true
		}

		Targeter
		{
			Type = UITargeter
			TargeterID = thermal_aim
			Weapons = [Turret, FixedWeapon]
		}

		Turret
		{
			Type = TurretWeapon
			Location = [2, 2]
			Rotation = -90d
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FirePermissionToggle = FirePermissionToggle
			TargetingEmitter = BeamEmitter
			FireInterval = .2
			FiringArc = 270d
			RotateSpeed
			{
				BaseValue = 60d
				Modifiers
				[
					{
						Type = Buff
						BuffType = Overclock
						ModificationMode = Lerp
						MinValue = &../../BaseValue
						MaxValue = 120d
					}
				]
			}
			FireThresholdAngle = 2d
			AIFirepowerRating = 7500
			IgnoreFriendlyShipLowLOSChecks = true
			HoldTargetAfterCancel = 3
			SuppressShipWideExplicitTargetsWhenTargetingShipRelativePoints = true
			SuppressDirectControlWhenTargetingShipRelativePoints = true
			SaveShipRelativeTargets = true

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}

		FixedWeapon
		{
			Type = FixedWeapon
			ChainedTo = Turret
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = &../Turret/FireInterval
			AIFirepowerRating = 0
			TargetingEmitter = BeamEmitter
			DefaultDirectControlBinding = 0
			FirePermissionToggle = FirePermissionToggle
			IgnoreFriendlyShipLowLOSChecks = true

			AutoTarget = &../Turret/AutoTargets/0
		}

		BeamEmitter : <./Data/shots/resonance_beam/resonance_beam.rules>
		{
			Type = BeamEmitter
			ChainedTo = Turret
			FireTrigger = FixedWeapon
			GetTargetFrom = Turret
			Location = [1.2, 0]
			OperationalToggle = IsOperational
			Duration = 1
			ResourceStorage = BatteryStorage
			ResourcesUsed = 350
			ResourceScaleFactor = OverclockPowerUsageFactor
			MinResourcesUsed = 1
		}

		CrewLocation1
		{
			Type = CrewLocation
			Location = [69/64, 129/64]
			Rotation = 101d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [187/64, 129/64]
			Rotation = -101d
		}
		CrewLocation3
		{
			Type = CrewLocation
			Location = [82/64, 178/64]
			Rotation = 50.5d
		}
		CrewLocation4
		{
			Type = CrewLocation
			Location = [174/64, 178/64]
			Rotation = -50.5d
		}

		PartCrew
		{
			Type = PartCrew
			Crew = 4
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle]
			HighPriorityPrerequisites = [BatteryStorage]
			CrewDestinations
			[
				&../../CrewLocation1/Location
				&../../CrewLocation2/Location
				&../../CrewLocation3/Location
				&../../CrewLocation4/Location
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
				CrewLocation3
				CrewLocation4
			]
		}



		Port_TopLeft
		{
			Type = NetworkPort
			Types = [ thermal ]
			Location = [1, 0]
			Direction = Up
			RouteSource = NetworkHeatInput
			RouteEndpoint = NetworkHeatInput
			BlueprintRouteSource = BlueprintNetworkNode
			BlueprintRouteEndpoint = BlueprintNetworkNode
			Overlay
			{
				OverlayIcon = "ThermalPort"
				RouteLine = "Thermal"
				DrawRouteHub = false
				ConnectedEdgeIcon = "ThermalDot"
				HighlightPartOnPrimaryConnection = true
    			PartHighlightColor = [255, 217, 0, 61]
			}
		}
		Port_TopRight : Port_TopLeft
		{
			Location = [2, 0]
		}

		Port_RightTop : Port_TopLeft
		{
			Location = [3, 1]
			Direction = Right
		}
		Port_RightBottom : Port_RightTop
		{
			Location = [3, 2]
		}

		Port_BottomRight : Port_TopLeft
		{
			Location = [2, 3]
			Direction = Down
		}
		Port_BottomLeft : Port_BottomRight
		{
			Location = [1, 3]
		}

		Port_LeftBottom : Port_TopLeft
		{
			Location = [0, 2]
			Direction = Left
		}
		Port_LeftTop : Port_LeftBottom
		{
			Location = [0, 1]
		}

		BlueprintNetworkNode
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
		}

		Router
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[NetworkHeatInput, NetworkHeatOutput, 0]
						[NetworkHeatInput, NetworkedHeatStorage, 0]
						[NetworkHeatInput, NetworkedPumpUtilization, 0]
						[NetworkHeatInput, Network_PumpHeatGeneration, 0]
						[NetworkHeatInput, NetworkAmplification, 0]
						[NetworkHeatInput, NetworkDilation, 0]
						[NetworkHeatInput, Networked_AnticipatedSelfHeatProduction, 0]
						[NetworkHeatInput, Network_AnticipatedHeatProduction, 0]
					]
				}
			]
		}

		DestroyedHeatEffects
		{
			Type = DeathEffects
			Location = [2, 2]
			IncludeWhenUnderConstruction = false

			HitEffects
			[
				{
					Type = GridStatusApplication
					StatusType = cosmoteer.heat
					HitPartSourceRectType = Normal
					StatusValue = 0
					StatusValuePool
					{
						BaseValue = &~/Part/Components/HeatStorage/MAX_STATUS_HEAT
						EffectScaleExponent = 1
					}
					MaxCost = 3
					EmptyTileCost = Infinity
					ValueFalloff = 1
					FalloffPadding = 1
					Filter
					{
						Self = true
					}
				}
			]
		}
		DestroyedMediaEffects
		{
			Type = DeathEffects
			Location = [2, 2]
			MediaEffects = &/COMMON_EFFECTS/HugePartDestroyed
		}

		Graphics
		{
			Type = Graphics
			Location = [2, 2]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [4,4]
					}
					{
						File = "floor_33.png"
						Size = [4,4]
					}
					{
						File = "floor_66.png"
						Size = [4,4]
					}
				]
			}
			OperationalDoodad
			{
				Layer ="doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
							"doodads_on5.png"
							"doodads_on6.png"
							"doodads_on7.png"
							"doodads_on8.png"
						]
						Size = [3, 4]
						AnimationInterval = 0.10
					}
					{
						AnimationFiles
						[
							"doodads_on1_33.png"
							"doodads_on2_33.png"
							"doodads_on3_33.png"
							"doodads_on4_33.png"
							"doodads_on5_33.png"
							"doodads_on6_33.png"
							"doodads_on7_33.png"
							"doodads_on8_33.png"
						]
						Size = [3, 4]
						AnimationInterval = 0.10
					}
					{
						AnimationFiles
						[
							"doodads_on1_66.png"
							"doodads_on2_66.png"
							"doodads_on3_66.png"
							"doodads_on4_66.png"
							"doodads_on5_66.png"
							"doodads_on6_66.png"
							"doodads_on7_66.png"
							"doodads_on8_66.png"
						]
						Size = [3, 4]
						AnimationInterval = 0.10
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"

				DamageLevels
				[
					{
						File = "doodads_off.png"
						Size = [3, 4]
					}
					{
						File = "doodads_off_33.png"
						Size = [3, 4]
					}
					{
						File = "doodads_off_66.png"
						Size = [3, 4]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4, 4]
					}
					{
						File = "walls_33.png"
						Size = [4, 4]
					}
