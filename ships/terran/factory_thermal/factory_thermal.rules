OVERCLOCK
{
	HEAT_PER_CONVERSION = 110
	SPEED_FACTOR = 300%
	POWER_USE_FACTOR = 150%
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Part : <../base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/FactoryThermal"
	IconNameKey = "Parts/FactoryThermalIcon"
	ID = cosmoteer.factory_thermal
	EditorGroup = "Production"
	EditorParentParts = [ "cosmoteer.missile_launcher" ]
	DescriptionKey = "Parts/FactoryThermalDesc"
	Resources
	[
		[steel, 80]
		[coil2, 46]
		[tristeel, 11]
	]
	Size = [3, 3]
	IsFlippable = true
	SelectionPriority = 1
	MaxHealth = 9000
	TypeCategories = [provides_launcher_parts, uses_copper, uses_sulfur, uses_power]
	ReceivableBuffs : ^/0/ReceivableBuffs [Factory]
	BlockedTravelCells
	[
		[1, 0]
		[1, 1]
	]
	ForceManhattanPathInPart = true
	AllowedDoorLocations
	[
		[-1, 1]
		[-1, 2]
		[0, 3]
		[1, 3]
		[2, 3]
		[3, 2]
		[3, 1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, NonJunkToggle, BatteryStorage, CopperSplitter, SulfurSplitter, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 1
		}

		CopperStorage
		{
			Type = TypedResourceGrid
			ResourceType = copper
			GridRect = [0, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [17/64, 9/64, 5/64, 5/64]
			AllowExternalPickupAndDelivery = true
		}
		CopperConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = copper
			Storage = CopperStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}
		CopperSplitter
		{
			Type = InlineResourceConverter
			ResourceType = copper
			FromStorage = CopperStorage
			FromQuantity = 1
			ToQuantity = 20
		}

		SulfurStorage
		{
			Type = TypedResourceGrid
			ResourceType = sulfur
			GridRect = [2, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [5/64, 9/64, 17/64, 5/64]
			AllowExternalPickupAndDelivery = true
		}
		SulfurConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = sulfur
			Storage = SulfurStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}
		SulfurSplitter
		{
			Type = InlineResourceConverter
			ResourceType = sulfur
			FromStorage = SulfurStorage
			FromQuantity = 1
			ToQuantity = 20
		}

		MissileStorage
		{
			Type = TypedResourceGrid
			ResourceType = missile_part_thermal
			GridRect = [0, 2, 3, 1]
			Layer = "doodads_low"
			SpriteInset = [9/64, 6/64, 9/64, 16/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -.4]
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 4000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/BatteryDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			ResupplyThreshold = 500
			OperationalToggle = CommandConsumptionToggle
		}

		ResourceConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
			    {
			        Storage = CopperSplitter
			        Quantity = 1
			    }
			    {
			        Storage = SulfurSplitter
			        Quantity = 1
			    }
			    {
			        Storage = BatteryStorage
			        Quantity
			        {
			        	BaseValue = 125
			        	Modifiers
			        	[
			        		: ~/MODIFIERS/OVERCLOCK_LERP
			        		{
			        			MinValue = &../../BaseValue
			        			MaxValue = (&MinValue) * (&~/OVERCLOCK/POWER_USE_FACTOR)
			        		}
			        	]
			        }
			        MinQuantityForConversion = 1
			    }
			]
			ToStorage = MissileStorage
			ToQuantity = 1
			Interval
			{
				BaseValue = 0.3
				Modifiers
				[
					{ Type = Buff; BuffType = Factory; ModificationMode = Divide; }
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
			CheckResourceLimits = true
		}

		ConvertEffects
		{
			Type = TriggeredEffects
			Trigger = ResourceConverter
			Location = [1.5, 1.5]
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInteriorDetail
				{
					RandomSounds = ["sounds/missile_factory_putdown_01.wav",
									"sounds/missile_factory_putdown_02.wav",
									"sounds/missile_factory_putdown_03.wav",
									"sounds/missile_factory_putdown_04.wav",
									"sounds/missile_factory_putdown_05.wav"]
					Volume = 1
					Db = -2
					Speed = 1
					SpeedVariation = .05
				}
			]
		}

		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Factory
			BuffAmount = 25%
			GridDistance = 1
			OperationalToggle = BatteryStorage
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_ConversionHeatProducer
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_ResourceConverterProxy
			Amount = (&~/OVERCLOCK/HEAT_PER_CONVERSION) * (&~/HEAT_TO_RESOURCE)
		}

		Overclock_ResourceConverterProxy
		{
			Type = TriggerProxy
			ProxyToggle = IsOverclocked
			ComponentID = ResourceConverter
		}

		Port_Thermal_Left0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 1]
			Direction = Left
		}
		Port_Thermal_Left1 : Port_Thermal_Left0
		{
			Location = [0, 2]
		}
		Port_Thermal_Down0 : Port_Thermal_Left0
		{
			Location = [0, 2]
			Direction = Down
		}
		Port_Thermal_Down1 : Port_Thermal_Down0
		{
			Location = [1, 2]
		}
		Port_Thermal_Down2 : Port_Thermal_Down0
		{
			Location = [2, 2]
		}
		Port_Thermal_Right0 : Port_Thermal_Left0
		{
			Location = [2, 1]
			Direction = Right
		}
		Port_Thermal_Right1 : Port_Thermal_Right0
		{
			Location = [2, 2]
		}

		CopperSprites : <../factory_emp/factory_emp.rules>/Part/Components/CopperSprites
		{
			Location = [0.5-8/64, 0.5+2/64]
			Rotation = 90d
		}

		SulfurSprites : <../factory_he/factory_he.rules>/Part/Components/SulfurSprites {}

		FloorSprite
		{
			Type = Sprite
			OnlyWithFlip = false
			Location = [1.5, 1.5]
			Layer = "floors"
			DamageLevels
			[
				{
					File = "floor.png"
					Size = [3, 3]
				}
				{
					File = "floor_33.png"
					Size = [3, 3]
				}
				{
					File = "floor_66.png"
					Size = [3, 3]
				}
			]
		}

		FloorSpriteFlipped
		{
			Type = Sprite
			OnlyWithFlip = true
			Location = [1.5, 1.5]
			Layer = "floors"
			DamageLevels
			[
				{
					File = "floor_flipped.png"
					Size = [3, 3]
				}
				{
					File = "floor_flipped_33.png"
					Size = [3, 3]
				}
				{
					File = "floor_flipped_66.png"
					Size = [3, 3]
				}
			]
		}

		BeltSpeedFactor
		{
			Type = BuffableValue
			Value
			{
				BaseValue = 1
				Modifiers
				[
					{
						Type = Buff
						BuffType = Factory
						ModificationMode = Multiply
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
					}
				]
			}
		}

		Graphics
		{
			Type = Graphics
			Location = [1.5, 1.5]
			OperationalToggle = IsOperational
			DoodadToggle = ResourceConverter
			AnimationSpeedFactor = BeltSpeedFactor
			ToggleOnDoodad
			{
				Layer = "walls" //Wall layer so the robotic arm sprites are draw over the resources sprites
				Offset = [0, -.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
							"doodads_on5.png"
							"doodads_on6.png"
							"doodads_on7.png"
							"doodads_on8.png"
						]
						Size = [3, 2]
						AnimationInterval = 0.075
					}
					{
						AnimationFiles
						[
							"doodads_on1_33.png"
							"doodads_on2_33.png"
							"doodads_on3_33.png"
							"doodads_on4_33.png"
							"doodads_on5_33.png"
							"doodads_on6_33.png"
							"doodads_on7_33.png"
							"doodads_on8_33.png"
						]
						Size = [3, 2]
						AnimationInterval = &../0/AnimationInterval
					}
					{
						AnimationFiles
						[
							"doodads_on1_66.png"
							"doodads_on2_66.png"
							"doodads_on3_66.png"
							"doodads_on4_66.png"
							"doodads_on5_66.png"
							"doodads_on6_66.png"
							"doodads_on7_66.png"
							"doodads_on8_66.png"
						]
						Size = [3, 2]
						AnimationInterval = &../0/AnimationInterval
					}
				]
			}
			ToggleOffDoodad
			{
				Layer = "walls" //Wall layer so the robotic arm sprites are draw over the resources sprites
				Offset = [0, -.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_idle1.png"
							"doodads_idle2.png"
							"doodads_idle3.png"
							"doodads_idle4.png"
							"doodads_idle5.png"
							"doodads_idle6.png"
							"doodads_idle7.png"
							"doodads_idle8.png"
						]
						Size = [3, 2]
						AnimationInterval = (&~/Part/Components/Graphics/ToggleOnDoodad/DamageLevels/0/AnimationInterval) * 1.5
						AnimationStartTime = WhenSpawned
					}
					{
						AnimationFiles
						[
							"doodads_idle1_33.png"
							"doodads_idle2_33.png"
							"doodads_idle3_33.png"
							"doodads_idle4_33.png"
							"doodads_idle5_33.png"
							"doodads_idle6_33.png"
							"doodads_idle7_33.png"
							"doodads_idle8_33.png"
						]
						Size = [3, 2]
						AnimationInterval = &../0/AnimationInterval
						AnimationStartTime = WhenSpawned
					}
					{
						AnimationFiles
						[
							"doodads_idle1_66.png"
							"doodads_idle2_66.png"
							"doodads_idle3_66.png"
							"doodads_idle4_66.png"
							"doodads_idle5_66.png"
							"doodads_idle6_66.png"
							"doodads_idle7_66.png"
							"doodads_idle8_66.png"
						]
						Size = [3, 2]
						AnimationInterval = &../0/AnimationInterval
						AnimationStartTime = WhenSpawned
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "walls" //Wall layer so the robotic arm sprites are draw over the resources sprites
				Offset = [0, -.5]
				DamageLevels
				[
					{
						File = "doodads_off.png"
						Size = [3, 2]
					}
					{
						File = "doodads_off_33.png"
						Size = [3, 2]
					}
					{
						File = "doodads_off_66.png"
						Size = [3, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [3, 3]
					}
					{
						File = "walls_33.png"
						Size = [3, 3]
					}
					{
						File = "walls_66.png"
						Size = [3, 3]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [3, 3]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [0, -29/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [4, 4]
						Z = 0.5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.5, 0, 0]
					}
				]
			}
		}

		RoofDoorOpenToggle
		{
			Type = CrewDestinationProximityToggle
			Distance = 3
		}
		RoofDoorSprite
		{
			Type = OpenCloseSprite
			Location = [1.5, 1.5]
			OperationalToggle = RoofDoorOpenToggle
			Layer = "roofs"
			OpenDamageLevels
			[
				{
					AnimationFiles
					[
						"roof1.png"
						"roof2.png"
						"roof3.png"
						"roof4.png"
						"roof5.png"
						"roof6.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals1.png"
						"roof_normals2.png"
						"roof_normals3.png"
						"roof_normals4.png"
						"roof_normals5.png"
						"roof_normals6.png"
					]
