		BatterySprites : <../factory_he/factory_he.rules>/Part/Components/BatterySprites {}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [1.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}
		
		OperationSoundLoop
		{
			Type = ContinuousEffects
			Location = [1, 1]
			OperationalToggle = IsOperational
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "sounds/he_missile_factory_idle.wav"
					Volume = 1
					MaxConcurrentVolume = 1
					Speed = 1
					MaxConcurrent = 1
				}
			]
		}

		ScorchedToggle
		{
			Type = StatusToggle
			MinStatusValue = 1
			StatusType = cosmoteer.scorched
			Invert = true
			IncludeWhenUnderConstruction = true
		}
		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &~/Part/Components/DestroyedEffects/Location
			MediaEffects = &~/Part/Components/DestroyedEffects/MediaEffects
			HitEffects = &~/Part/Components/DestroyedEffects/HitEffects
		}

		DestroyedEffects
		{
			Type = DeathEffects
			OperationalToggle = ScorchedToggle
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1.5, 1.5]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 64500
					Radius = 5
					Delay = .05
					StatusChancePerNDamage = 100%
					StatusValue = 1
					StatusValueType = Interpolated
					NDamage = 1000
					CrewKillChance = 50%
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 20000
					Radius = 4
					Delay = .05
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
						Crew = false
					}
				}
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1.5]
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [1,2,3,4]
				}

				// No Copper.
				{
					Toggle = CopperSplitter
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// No sulfur.
				{
					Toggle = SulfurSplitter
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}

				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			OnlyWithFlip = false
			File = "blueprints.png"
			Size = [3, 3]
		}

		BlueprintsFlipped
		{
			Type = BlueprintSprite
			OnlyWithFlip = true
			File = "blueprints_flipped.png"
			Size = [3, 3]
		}

		Overclock_HeatProductionInterval
		{
			Type = BuffableValue
			Value = &~/Part/Components/ResourceConverter/Interval
			IncludeInBlueprints = true
		}
		Overclock_HeatPerConversion { Type = StaticValue; Value = &~/OVERCLOCK/HEAT_PER_CONVERSION; }
		HeatGenerationValue
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_HeatPerConversion
			ValueTwo = Overclock_HeatProductionInterval
			NaNFallbackValue = 0
			IncludeInBlueprints = Normal
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = HeatGenerationValue
		}
	}

	Stats
	{
		PartsPerMissile = &<../missile_launcher/thermal/missile_launcher_thermal.rules>/BASE/MissileStorage/MaxResources
		MissileProduction = (&~/Part/Components/ResourceConverter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) / (&PartsPerMissile)
		PartCapacity = (&~/Part/Components/MissileStorage/GridRect/2) * (&~/Part/Components/MissileStorage/GridRect/3) * (&<./Data/resources/missile_part_thermal/missile_part_thermal.rules>/MaxStackSize)
		MissilePartCapacity = [&../PartCapacity, (&../PartCapacity) / (&../PartsPerMissile)]
		CopperCapacity = (&~/Part/Components/CopperStorage/GridRect/2) * (&~/Part/Components/CopperStorage/GridRect/3) * (&<./Data/resources/copper/copper.rules>/MaxStackSize)
		CopperPerMissile = (&~/Part/Components/CopperSplitter/FromQuantity) / (&~/Part/Components/CopperSplitter/ToQuantity) / (&~/Part/Components/ResourceConverter/ToQuantity) * (&PartsPerMissile)
		CopperPerSecond = (&~/Part/Components/CopperSplitter/FromQuantity) / (&~/Part/Components/CopperSplitter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		MissileCopperUsage = [&../CopperPerMissile, &../CopperPerSecond]
		SulfurCapacity = (&~/Part/Components/SulfurStorage/GridRect/2) * (&~/Part/Components/SulfurStorage/GridRect/3) * (&<./Data/resources/sulfur/sulfur.rules>/MaxStackSize)
		SulfurPerMissile = (&~/Part/Components/SulfurSplitter/FromQuantity) / (&~/Part/Components/SulfurSplitter/ToQuantity) / (&~/Part/Components/ResourceConverter/ToQuantity) * (&PartsPerMissile)
		SulfurPerSecond = (&~/Part/Components/SulfurSplitter/FromQuantity) / (&~/Part/Components/SulfurSplitter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		MissileSulfurUsage = [&../SulfurPerMissile, &../SulfurPerSecond]
		PowerPerMissile = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/ToQuantity) * (&PartsPerMissile) / 1000
		PowerPerSecond = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) / 1000
		MissilePowerUsage = [&../PowerPerMissile, &../PowerPerSecond]
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100

		RecPower = &PowerPerSecond
		RecCrew = (&RecPower) * 4
	}

	StatsByCategory
	[
		&<../missile_launcher/thermal/missile_launcher_thermal.rules>/MissileStats
	]

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/FactoryThermalOverclockDesc"
		Stats
		{
			MissileProduction = (&~/Part/Stats/MissileProduction) * (&~/OVERCLOCK/SPEED_FACTOR)
			MissileCopperUsage = [(&~/Part/Stats/MissileCopperUsage/0), (&~/Part/Stats/MissileCopperUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
			MissileSulfurUsage = [(&~/Part/Stats/MissileSulfurUsage/0), (&~/Part/Stats/MissileSulfurUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
			POWER_PER_MISSILE = (&~/Part/Stats/MissilePowerUsage/0) * (&~/OVERCLOCK/POWER_USE_FACTOR)
			POWER_PER_SECOND = (&~/Part/Stats/MissilePowerUsage/1) * (&~/OVERCLOCK/POWER_USE_FACTOR) * (&~/OVERCLOCK/SPEED_FACTOR)
			MissilePowerUsage = [&../POWER_PER_MISSILE, &../POWER_PER_SECOND]
			CONVERSION_OUTPUT = (&~/Part/Components/ResourceConverter/ToQuantity)
			HEAT_PER_MISSILE = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&CONVERSION_OUTPUT) * (&~/Part/Stats/PartsPerMissile)
			HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) * (&~/OVERCLOCK/SPEED_FACTOR)
			MissileHeatGeneration = [&../HEAT_PER_MISSILE, &../HEAT_PER_SECOND]
		}
	}
}

MODIFIERS
{
	OVERCLOCK_LERP
	{
		Type = Buff
		BuffType = Overclock
		ModificationMode = Lerp
	}
}