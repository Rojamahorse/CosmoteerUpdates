							}
						]
					}
				}

				OCLights_Graphics
				{
					Type = Graphics
					OperationalToggle = IsOperational
					DoodadToggle = IsOverclocked
					Location = [1.5, 1.5]
					ToggleOnDoodad
					{
						Layer = "lights_add"
