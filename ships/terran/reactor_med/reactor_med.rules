								[
									"lights1.png"
									"lights2.png"
									"lights3.png"
									"lights4.png"
									"lights5.png"
									"lights6.png"
									"lights7.png"
									"lights8.png"
								]
								Size = [3, 3]
								AnimationInterval = 0.065
							}
							{
								AnimationFiles
								[
									"lights1.png"
									"lights2.png"
									"lights3.png"
									"lights4.png"
									"lights5.png"
									"lights6.png"
									"lights7.png"
									"lights8.png"
								]
								Size = [3, 3]
								AnimationInterval = 0.065/1.75
							}
							{
								AnimationFiles
								[
									"lights1.png"
									"lights2.png"
									"lights3.png"
									"lights4.png"
									"lights5.png"
									"lights6.png"
									"lights7.png"
									"lights8.png"
								]
								Size = [3, 3]
								AnimationInterval = 0.065/2.5
							}
						]
					}
				}
			}
		}

		ReactorLights_Overclocked_Components
		{
			Type = ToggledComponents
			Toggle = IsOverclocked
			Components
			{
