					Size = [3, 3]
				}
				{
					File = "batteries8.png"
					Size = [3, 3]
				}
			]
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = [1.5, 1.5]
			HitEffects
			[
				{
					Type = ExplosiveResourceDrain
					ResourceType = battery
					TotalDrain = { BaseValue = 150000; EffectScaleExponent = 1 }
					Radius = 14
					Delay = .05
					ExpandDuration = .2
					ExpandStartRadius = 3
					ExpandLoss = 100%
					Filter
					{
						Friendlies = true
					}
					MediaEffectsOnDrainFactor = .0005
					MediaEffectsOnDrain
					[
						&<./Data/shots/missile_emp/particles/missile_emp_hit_sizzle.rules>
						&<./Data/shots/missile_emp/particles/missile_emp_lightning.rules>
						&<./Data/shots/missile_emp/particles/missile_emp_drain.rules>

						: /BASE_SOUNDS/AudioExterior
						{
							RandomSounds = ["../reactor_small/sounds/disruptor_discharge_01.wav",
											"../reactor_small/sounds/disruptor_discharge_02.wav",
											"../reactor_small/sounds/disruptor_discharge_03.wav",
											"../reactor_small/sounds/disruptor_discharge_04.wav"]
							Volume = 1
							SpeedVariation = .15
						}
					]
				}
			]
			MediaEffects : /COMMON_EFFECTS/BigPartScorched
			[
				&<./Data/shots/missile_emp/particles/missile_emp_hit_orb.rules>
				&<./Data/shots/missile_emp/particles/missile_emp_hit_bolts.rules>
				&<./Data/shots/missile_emp/particles/missile_emp_hit_shockwave.rules>
			]
		}

		DestroyedEffects
		{
			Type = DeathEffects
			Location = [1.5, 1.5]

			MediaEffects
			[
				&<particles/reactor_explode_med.rules>
				&<particles/reactor_explode_flash_med.rules>
				&<particles/reactor_shockwave_med.rules>
				&<./Data/common_effects/particles/explosions/big_part_explode_debris.rules>
				&<./Data/common_effects/particles/explosions/huge_part_explode_smoke.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["destroyed/reactor_destroyed_01.wav", "destroyed/reactor_destroyed_02.wav", "destroyed/reactor_destroyed_03.wav"]
					Volume = 1
					SpeedVariation = .25
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .5
					Duration = 3
				}
			]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 270000
					Radius = 10
					Delay = .05
					ExpandDuration = .175
					ExpandStartRadius = 3
					ExpandLoss = 100%
					StatusType = cosmoteer.fire
					StatusChancePerNDamage = 50%
					StatusValue = 1
					StatusValueType = Interpolated
					ImpulsePerNDamage = 10
					NDamage = 1000
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 60000
					Radius = 7
					Delay = .05
					ExpandDuration = .125
					ExpandStartRadius = 3
					ExpandLoss = 100%
					ImpulsePerNDamage = 5
					NDamage = 1000
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
					}
				}
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1.5, 1.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2]
				}
				// Out of power.
				{
					Toggle = CombinedBatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [3, 3]
		}

		PeakHeatGenerationStatValue
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationStatValue
		}
	}

	Stats
	{
		PowerGeneration = (&~/Part/Components/BatteryProducer/ToQuantity/BaseValue) / (&~/Part/Components/BatteryProducer/Interval/BaseValue) / 1000
		BatterySize = (&~/Part/Components/CombinedBatteryStorage/MaxResourcesPickUp) / 1000
		BatteryFillTime = 1000 / (&~/Part/Components/CombinedBatteryStorage/PickUpRate)
		PowerCapacity = (&~/Part/Components/CombinedBatteryStorage/MaxResources) / 1000
	}

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/ReactorMedOverclockDesc"
		Stats
		{
			PowerCapacity = (&~/Part/Stats/PowerCapacity) * (1 + (&~/OVERCLOCK/EXTRA_CAPACITY_FACTOR))
			PowerGeneration = (&~/Part/Stats/PowerGeneration) * (&~/OVERCLOCK/POWER_GENERATION_FACTOR)
			PowerHeatGeneration = [&~/OVERCLOCK/HEAT_PER_BATTERY, &~/OVERCLOCK/HEAT_PER_SECOND]
		}
	}
}