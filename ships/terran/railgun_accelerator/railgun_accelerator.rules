Part : <../base_med_part_terran.rules>/Part
{
	NameKey = "Parts/RailgunAccelerator"
	IconNameKey = "Parts/RailgunAcceleratorIcon"
	ID = cosmoteer.railgun_accelerator // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorParentParts = [ "cosmoteer.railgun_launcher" ]
	DescriptionKey = "Parts/RailgunAcceleratorDesc"
	Resources
	[
		[steel, 76]
		[coil2, 12]
		[tristeel, 10]
	]
	Size = [2, 3]
	Density = 6
	SelectionTypeID = "railgun"
	SelectionPriority = 1
	SelectionTypeByRotation = true
	MaxHealth = 6000
	TypeCategories = [weapon, uses_power, railgun_ammo, railgun, railgun_power, non_flammable]
	ReceivableBuffs : ^/0/ReceivableBuffs [Railgun, RailgunOperation, RailgunReverseOperation, Overclock]
	AllowedDoorLocations
	[
		[-1, 0]
		[-1, 2]
		[2, 0]
		[2, 2]
	]
	HasNonContiguousPathing = true
	BlockedTravelCellDirections
	[
		{
			Key = [0, 0]
			Value = [Right]
		}
		{
			Key = [1, 0]
			Value = [Left]
		}
		{
			Key = [0, 1]
			Value = [Right]
		}
		{
			Key = [1, 1]
			Value = [Left]
		}
		{
			Key = [0, 2]
			Value = [Right]
		}
		{
			Key = [1, 2]
			Value = [Left]
		}
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [46, 69]
	}
	Components : ^/0/Components
	{
		BuffOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, BatteryStorage, RailgunOperationBuffToggle, ScorchedToggle]
			Mode = All
		}
		IsOperational
		{
			Type = MultiToggle
			Toggles = [BuffOperational, RailgunReverseOperationBuffToggle]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 1
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 2000
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 500
			OperationalToggle = PowerToggle
		}

		RailgunBuffToggle
		{
			Type = BuffToggle
			BuffType = Railgun
		}

		RailgunOperationBuffToggle
		{
			Type = BuffToggle
			BuffType = RailgunOperation
		}

		RailgunBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = Railgun
			BuffAmount = { BaseValue=1; BuffType=Railgun; BuffMode=Add; }
			BuffArea = [0, -1, 2, 1]
			OperationalToggle = RailgunBuffToggle
			ChainsFromBuffType = Railgun
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
		}

		RailgunOperationBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = RailgunOperation
			BuffArea = [0, -1, 2, 1]
			OperationalToggle = BuffOperational
			ChainsFromBuffType = RailgunOperation
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
		}

		RailgunReverseOperationBuffToggle
		{
			Type = BuffToggle
			BuffType = RailgunReverseOperation
		}

		ReverseBuffOperationProvider
		{
			Type = AreaBuffProvider
			BuffType = RailgunReverseOperation
			BuffArea = [0, 3, 2, 1]
			OperationalToggle = RailgunReverseOperationBuffToggle
			ChainsFromBuffType = RailgunReverseOperation
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 2
				Top = 3
			}
		}

		LoadedAmmo
		{
			Type = ResourceStorageProxy
			ResourceType = bullet
			PartLocation = [0, 3]
			PartCriteria
			{
				Category = railgun_ammo
				Rot = 0
				Left = 0
				Right = 2
				Top = 3
			}
			ComponentID = LoadedAmmo
		}

		Weapon // This is called "Weapon" to allow chaining with the launcher.
		{
			Type = TriggerProxy
			PartLocation = [0, -1]
			PartCriteria
			{
				Category = railgun_power
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
			ComponentID = Weapon
		}

		ProjectileStartTrigger
		{
			Type = TriggerProxy
			PartLocation = [0, -1]
			PartCriteria
			{
				Category = railgun_power
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
			ComponentID = ProjectileStartTrigger
		}

		EmissionTriggered // This is called "EmissionTriggered" to allow chaining with the launcher.
		{
			Type = TriggerProxy
			PartLocation = [0, -1]
			PartCriteria
			{
				Category = railgun_power
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
			ComponentID = EmissionTriggered
		}

		PowerDrainOnShoot
		{
			Type = ResourceChange
			Trigger = EmissionTriggered
			ResourceStorage = BatteryStorage
			Amount = -500
		}

		Router
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[Network_OverclockStateValue, Network_OverflowHeatStorage, 0]
						[Network_OverclockStateValue, Network_ChargedModules, 0]
						[Network_OverclockStateValue, Network_ChargeValue, 0]
					]
				}
				{
					Type = Simple
					Routes
					[
						[Port_Rail_Up, Port_Thermal_TopLeft, 0]
						[Port_Rail_Up, Port_Thermal_TopRight, 0]
						[Port_Rail_Up, Port_Thermal_BottomLeft, 0]
						[Port_Rail_Up, Port_Thermal_BottomRight, 0]
					]
				}
			]
		}

		OverflowHeatStorage : <./Data/ships/terran/base_med_part_terran_overclock.rules>/Part/Components/OverflowHeatStorage {}
		OverheatEffects : <./Data/ships/terran/base_med_part_terran_overclock.rules>/Part/Components/OverheatEffects {}

		Network_OverflowHeatStorage
		{
			Type = NetworkResourceStore
			ResourceType = heat
			ResourceStorage = OverflowHeatStorage
			AllowProviding = false
			Categories = [ railgun_heat_overflow ]
		}

		OverclockBuffProvider
		{
			Type = SelfBuffProvider
			BuffType = Overclock
			BuffMultiplier = Network_OverclockStateValue
		}

		Network_OverclockStateValue
		{
			Type = NetworkValueReceiver
			Categories = [ overclock ]
			Mode = Max
			AllowUncategorized = false
		}
		IsOverclocked
		{
			Type = ThresholdToggle
			ValueFrom = Network_OverclockStateValue
			MinAmount = 0
			MaxAmount = 0
			Invert = true
		}

		Network_ChargedModules
		{
			Type = NetworkValueReceiver
			Categories = [ railgun_charge_modules ]
			Mode = Max
			AllowUncategorized = false
		}

		Network_ChargeValue
		{
			Type = NetworkValueReceiver
			Categories = [ railgun_charge ]
			Mode = Max
			AllowUncategorized = false
		}

		BlueprintNetwork_IsOverclocked
		{
			Type = NetworkToggleReceiver
			Categories = [ overclock ]
			Mode = Any
			AllowUncategorized = false
			IncludeInBlueprints = true
			IncludeInPhysical = false
		}

		Port_Rail_Up
		{
			Type = NetworkPort
			Location = [0, 0]
			Direction = Up
			Types = [ railgun_up ]
			CompatibleTypes = [ railgun_down ]
			RouteSource = Network_OverclockStateValue
			RouteEndpoint = Network_OverclockStateValue
			BlueprintRouteSource = BlueprintNetwork_IsOverclocked
			BlueprintRouteEndpoint = BlueprintNetwork_IsOverclocked
			Overlay
			{
				RouteDrawMode = Never
				IconDrawMode = Never
			}
		}

		Port_Rail_Down : Port_Rail_Up
		{
			Type = NetworkPort
			Location = [0, 2]
			Direction = Down
			Types = [ railgun_down ]
			CompatibleTypes = [ railgun_up ]
		}

		Port_Thermal_TopLeft : <./Data/ships/terran/base_med_part_terran_overclock.rules>/Part/BASE_THERMAL_PORT
		{
			OperationalToggle = IsOverclocked
			BlueprintOperationalToggle = BlueprintNetwork_IsOverclocked
			Location = [0, 0]
			Direction = Left
			RouteSource = Network_OverclockStateValue
			BlueprintRouteSource = BlueprintNetwork_IsOverclocked
			Overlay : ^/0/Overlay
			{
				SpreadHighlightThroughNetwork = BlueprintNetwork_IsOverclocked
			}
		}
		Port_Thermal_TopRight : Port_Thermal_TopLeft
		{
			Location = [1, 0]
			Direction = Right
		}
		Port_Thermal_BottomLeft : Port_Thermal_TopLeft
		{
			Location = [0, 2]
			Direction = Left
		}
		Port_Thermal_BottomRight : Port_Thermal_TopLeft
		{
			Location = [1, 2]
			Direction = Right
		}

		StructureGraphics
		{
			Type = Graphics
			Location = [1, 1.5]
			Floor
			{
				Layer = "structure"
				DamageLevels
				[
					{
						File = "../railgun_launcher/structure.png"
						NormalsFile = "../railgun_launcher/structure_normals.png"
						Size = [1, 3]
					}
					{
						File = "../railgun_launcher/structure_33.png"
						NormalsFile = "../railgun_launcher/structure_normals_33.png"
						Size = [1, 3]
					}
					{
						File = "../railgun_launcher/structure_66.png"
						NormalsFile = "../railgun_launcher/structure_normals_66.png"
						Size = [1, 3]
					}
				]
			}
		}


		Graphics
		{
			Type = Graphics
			Location = [1, 1.5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "../railgun_launcher/floor.png"
						Size = [2, 3]
					}
					{
						File = "../railgun_launcher/floor_33.png"
						Size = [2, 3]
					}
					{
						File = "../railgun_launcher/floor_66.png"
						Size = [2, 3]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "weapons"
				DamageLevels
				[
					{
						File = "weapon.png"
						NormalsFile = "weapon_normals.png"
						Size = [2, 3]
					}
					{
						File = "weapon_33.png"
						NormalsFile = "weapon_normals_33.png"
						Size = [2, 3]
					}
					{
						File = "weapon_66.png"
						NormalsFile = "weapon_normals_66.png"
						Size = [2, 3]
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "weapons"
				DamageLevels
				[
					{
						File = "weapon.png"
						NormalsFile = "weapon_normals.png"
						Size = [2, 3]
					}
					{
						File = "weapon_33.png"
						NormalsFile = "weapon_normals_33.png"
						Size = [2, 3]
					}
					{
						File = "weapon_66.png"
						NormalsFile = "weapon_normals_66.png"
						Size = [2, 3]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"lights1.png"
							"lights2.png"
							"lights3.png"
							"lights4.png"
							"lights5.png"
							"lights6.png"
						]
						Size = [2, 3]
						AnimationInterval = 0.1
						AnimationStartTime = Zero
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "../railgun_launcher/walls.png"
						Size = [2, 3]
					}
					{
						File = "../railgun_launcher/walls_33.png"
						Size = [2, 3]
					}
					{
						File = "../railgun_launcher/walls_66.png"
						Size = [2, 3]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [2, 3]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [2, 3]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [2, 3]
					}
				]
			}
		}

		RailgunBuffValue
		{
			Type = BuffableValue
			Value = { BaseValue = 1; BuffType = Railgun; BuffMode = Multiply; }
		}
		Overclock_Charge_Lights_Intensity
		{
			Type = ValueOperation
			Operator = Subtract
			ValueOne = Network_ChargedModules
			ValueTwo = RailgunBuffValue
			MinValue = 0
			MaxValue = 1.5
		}
		FrameOffset { Type = StaticValue; Value = 1.5; }
		Overclock_Charge_Lights_Intensity_Normalize
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_Charge_Lights_Intensity
			ValueTwo = FrameOffset
			MinValue = 0
			MaxValue = 1
		}
		Overclock_Charge_Lights
		{
			Type = ValueSprites
			Location = [1, 1.5]
			ValueFrom = Overclock_Charge_Lights_Intensity_Normalize
			Layer = "lights_add"
			ResourceLevels
			[
				{
					//Blank Frame
				}
				{
					File = "OClights1.png"
					Size = [2, 1]
					Offset = [0, 1]
				}
				{
					File = "OClights2.png"
					Size = [2, 1]
					Offset = [0, 1]
				}
				{
					File = "OClights3.png"
					Size = [2, 2]
					Offset = [0, 0.5]
				}
				{
					File = "OClights4.png"
					Size = [2, 2]
					Offset = [0, 0.5]
				}
				{
					File = "OClights5.png"
					Size = [2, 3]
				}
				{
					File = "OClights6.png"
					Size = [2, 3]
				}
				{
					File = "OClights7.png"
					Size = [2, 3]
				}
				{
					File = "OClights8.png"
					Size = [2, 3]
				}
			]
		}

		BatterySprites
		{
			Type = ResourceSprites
			Location = [1, 2.5]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			ResourceLevels
			[
				{
					File = "../railgun_launcher/batteries1.png"
					Size = [1, 1]
					Offset = [-0.5, 0]
				}
				{
					File = "../railgun_launcher/batteries2.png"
					Size = [2, 1]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [1, 2.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1, 1.5]
		}

		RecursiveDeath1
		{
			Type = DeathEffects
			Location = [1, -.5]

			HitEffects
			[
				{
					Type = AreaDamage
					Damage = 3000
					Radius = .6
					Falloff = 0
					Delay = .15
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
			]
		}

		RecursiveDeath2 : RecursiveDeath1
		{
			Location = [1, 3.5]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 1.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3]
				}
				// Missing component
				{
					Toggle = RailgunBuffToggle
					ShowInBuildMode = true
					AtlasSprite
					{
						File = &/INDICATORS/MissingComponent
						Size = [1, 1]
					}
				}

				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [3]
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					Delay = &<../railgun_launcher/railgun_launcher.rules>/Part/Components/Weapon/FireInterval
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 3]
		}
	}

	Stats
	{
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		PowerPerShot = -(&~/Part/Components/PowerDrainOnShoot/Amount) / 1000
		PowerPerSecond = (&PowerPerShot) / (&<../railgun_launcher/railgun_launcher.rules>/Part/Components/Weapon/FireInterval)
		ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]

		RecPower = &PowerPerSecond
		RecCrew = (&RecPower) * 4
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/RailgunBuff"
			Stats
			{
				Multiplier = (&<./Data/buffs/buffs.rules>/RailgunShot/Multiplier) * 100
				Exponent = (&<./Data/buffs/buffs.rules>/RailgunShot/Exponent)
				BaseValue = ((&<./Data/buffs/buffs.rules>/RailgunShot/BaseValue) - 1) * 100
				RailgunBuff
				[
					(&../BaseValue) + (&../Multiplier) * (1 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (2 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (3 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (4 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (5 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (6 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (7 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (8 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (9 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (10 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (11 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (12 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (13 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (14 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (15 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (16 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (17 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (18 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (19 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (20 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (21 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (22 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (23 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (24 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (25 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (26 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (27 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (28 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (29 ^ (&../Exponent))
					(&../BaseValue) + (&../Multiplier) * (30 ^ (&../Exponent))
				]
			}
		}
	]
}