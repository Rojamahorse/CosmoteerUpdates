	Right_Pipe_Components : Left_Pipe_Components
	{
		Toggle = Port_Thermal_Right
		Components
		{
			Right_Pipes_Graphics : ../../Left_Pipe_Components/Components/Left_Pipes_Graphics
			{
				Location = [1.5, 1.5]
				Rotation = -90d
			}
		}
	}
	//---------------------- END PIPE CONNECTOR ----------------------
}

MISSILE_PART = missile_part_thermal

BASE
{
	MissileStorage
	{
		Type = ResourceStorage
		ResourceType = &~/MISSILE_PART
		MaxResources = 4
		ToggleOnResources = 4
		ToggleOffResources = 3
		DelayBeforeReadyToUse = .5
		DropResourcesWhenDestroyed = true
		DropResourcesWhenRemoved = true
	}

	HeatStorage
	{
		Type = ResourceStorage
		ResourceType = heat
		MaxResources = (&~/HEAT_PER_MISSILE) * (&~/HEAT_TO_RESOURCE)
		ToggleOnResources = (&MaxResources)
		ToggleOffResources = (&MaxResources) - 1
	}

	Weapon
	{
		Type = TurretWeapon // This has an arc of 0, but we don't want to use FixedWeapon because that will only shoot at things directly in the LOS.
		Rotation = -90d
		OperationalToggle = IsOperational
		AutoFireToggle = AutoFireToggle
		FireInterval = 0 // Uses common reload timer.
		FiringArc = 0d;
		ValidArc = 360d;
		FireThresholdAngle = 180d;
		RotateSpeed = 0d
		AllowFireWithBlockedLOS = true
		// TODO
		//AIFirepowerRating = &~/MissileStats/Stats/DamagePerSecond
		FirePermissionToggle = FirePermissionToggle

		AutoTargets
		[
			{
				TargetType = ShipParts
				Toggle = AutoTargetToggle
				EnableInDirectControlMode = true
			}
		]
	}

	Emitter
	{
		Type = BulletEmitter
		OperationalToggle = IsOperational
		Location = [.5, 0]
		Bullet = &<./Data/shots/missile_thermal/missile_thermal.rules>
		TargetLeadPrediction = false
		Recoil = 50
	}
    
	LaunchEffect
	{
		Type = TriggeredEffects

		MediaEffects
		[
			&<../particles/missile_launcher_shoot.rules>
			&<../particles/missile_launcher_shoot_flash.rules>

			: /BASE_SOUNDS/AudioExterior
			{
				Sound = "../shoot.wav"
				SpeedVariation = .25
			}
		]
	}
}

MissileStats
{
	NameKey = "StatCategories/MissileThermal"
	Stats
	{
		HeatCapacity = (&~/HEAT_PER_MISSILE)
		HeatSpreadDistance = &~/BASE/Emitter/Bullet/Components/Hit/HitOperational/HitEffects/0/MaxCost
		ROF = 1 / (&<../missile_launcher.rules>/Part/Components/CommonReloadTimerThermal/Duration)
		Range = &~/BASE/Emitter/Bullet/Range
		Arc = deg(&~/BASE/Weapon/ValidArc)
		ShotLaunchSpeed = &~/BASE/Emitter/Bullet/Speed
		Acceleration = &~/BASE/Emitter/Bullet/Components/Acceleration/Acceleration
		ShotGuidance = deg(&~/BASE/Emitter/Bullet/Components/Homing/TurnVelocity)
		ShotHP = &~/BASE/Emitter/Bullet/Components/Targetable/Health
		MissileParts = &~/BASE/MissileStorage/MaxResources
	}
}