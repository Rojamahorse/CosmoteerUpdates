	Indicators
	{
		Type = IndicatorSprites
		Location = [1, 2]
		Indicators
		[
			// Turned off.
			{
				Toggle = PowerToggle
				AtlasSprite
				{
					File = &/INDICATORS/PowerOff
					Size = [1, 1]
				}
				HidesIndicators = [1,2,3]
			}

			// Out of missiles.
			{
				Toggle = PartsPrereq
				Delay = &<../missile_launcher.rules>/Part/Components/CommonReloadTimerHE/Duration
				AtlasSprite
				{
					File = &/INDICATORS/NoThermalMissiles
					Size = [1, 1]
				}
			}
			
			// Not enough heat
			{
				Toggle = HeatPrereq
				AtlasSprite : /INDICATORS/NoHeat
				{
					Size = [1, 1]
				}
			}

			// No crew.
			{
				Toggle = PartCrew
				AtlasSprite
				{
					File = &/INDICATORS/NoCrew
					Size = [1, 1]
				}
			}
		]
	}

	//------------------------ PIPE CONNECTOR ------------------------
