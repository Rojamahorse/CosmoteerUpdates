HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

HEAT_PER_MISSILE = 7000

EditorIcon
{
	Texture
	{
		File = "icon_thermal.png"
		SampleMode = Linear
	}
	Size = [40, 80]
}

Components
{
	MissileStorageA : ~/BASE/MissileStorage {}
	MissileStorageB : ~/BASE/MissileStorage {}
	MissileStorageC : ~/BASE/MissileStorage {}
	
	CombinedMissileStorage
	{
		Type = MultiResourceStorage
		ResourceType = &~/MISSILE_PART
		ResourceStorages = [MissileStorageA, MissileStorageB, MissileStorageC]
		AddMode = PrioritizeLeastEmptyCapacity
		RemoveMode = PrioritizeMostEmptyCapacity
		ReceiveResourceMediaEffects = &/COMMON_EFFECTS/MissileLoad
		UITileRect = [.5 + 7/64, 1 + 7/64, 1 - 14/64, 1 - 14/64]
	}
	
	Consumer
	{
		Type = ResourceConsumer
		ResourceType = &~/MISSILE_PART
		Storage = CombinedMissileStorage
		DefaultPriority = &/PRIORITIES/Weapon_Supply
		OverridePriorityKey = ThermalMissileStorage
		OperationalToggle = PowerToggle
		ConsumptionToggleButtonOffset = [0, -.4]
	}
	
	HeatStorageA : ~/BASE/HeatStorage {}
	HeatStorageB : ~/BASE/HeatStorage {}
	HeatStorageC : ~/BASE/HeatStorage {}
	
	CombinedHeatStorage
	{
		Type = MultiResourceStorage
		ResourceType = heat
		ResourceStorages = [ HeatStorageA, HeatStorageB, HeatStorageC ]
		AddMode = PrioritizeLeastEmptyCapacity
		RemoveMode = PrioritizeMostEmptyCapacity
	}
	
	HeatConverter
	{
		Type = ResourceConverter
		OperationalToggle = PowerToggle
		
		MISSILE_FILL_TIME = 3
		INTERVALS_TO_FILL = (&MISSILE_FILL_TIME) / (&Interval)
		HEAT_PER_INTERVAL = ceil("(&~/BASE/HeatStorage/MaxResources) / (&INTERVALS_TO_FILL)")
		
		FromStorage = NetworkHeatOutput
		MinFromQuantityForConversion = &HEAT_PER_INTERVAL
		FromQuantity = &HEAT_PER_INTERVAL
		ToStorage = CombinedHeatStorage
		MinToQuantityForConversion = 1
		ToQuantity = &HEAT_PER_INTERVAL
		Interval = 0.5
	}
	
	PrereqA
	{
		Type = MultiToggle
		Toggles = [ MissileStorageA, HeatStorageA ]
		Mode = All
	}
	PrereqB : PrereqA
	{
		Toggles = [ MissileStorageB, HeatStorageB ]
	}
	PrereqC : PrereqA
	{
		Toggles = [ MissileStorageC, HeatStorageC ]
	}
	
	PartsPrereq
	{
		Type = MultiToggle
		Toggles = [ MissileStorageA, MissileStorageB, MissileStorageC ]
		Mode = Any
	}
	
	HeatPrereq
	{
		Type = MultiToggle
		Toggles = [ HeatStorageA, HeatStorageB, HeatStorageC ]
		Mode = Any
	}
	
	MissilesPrereq
	{
		Type = MultiToggle
		Toggles = [PrereqA, PrereqB, PrereqC]
		Mode = Any
	}

	ReloadProgressBar
	{
		Type = ProgressBar
		OperationalToggle = IsOperational
		ShowProgressFor = CommonReloadTimerThermal
		Invert = true
	}
	
	WeaponA : ~/BASE/Weapon
	{
		Location = [.5, 1]
		ShowExplicitTarget = false
		Emitter = EmitterA
	}

	EmitterA : ~/BASE/Emitter
	{
		ChainedTo = WeaponA
		FireTrigger = WeaponA
		GetTargetFrom = WeaponA
		ResourceUsage
		[
			{
				ResourceStorage = MissileStorageA
				ResourcesUsed = (&~/BASE/MissileStorage/MaxResources)
			}
			{
				ResourceStorage = HeatStorageA
				ResourcesUsed = (&~/BASE/HeatStorage/MaxResources)
			}
		]
	}

	WeaponB : ~/BASE/Weapon
	{
		Location = [1, 1]
		Emitter = EmitterB

		CoverageSectorArc
		{
			Texture = &/INDICATORS/VerticalGradient
			VertexColor = [255, 255, 255, 51]
			QuadCount = 64
		}
	}

	EmitterB : ~/BASE/Emitter
	{
		ChainedTo = WeaponB
		FireTrigger = WeaponB
		GetTargetFrom = WeaponB
		ResourceUsage
		[
			{
				ResourceStorage = MissileStorageB
				ResourcesUsed = (&~/BASE/MissileStorage/MaxResources)
			}
			{
				ResourceStorage = HeatStorageB
				ResourcesUsed = (&~/BASE/HeatStorage/MaxResources)
			}
		]
	}

	WeaponC : ~/BASE/Weapon
	{
		Location = [1.5, 1]
		ShowExplicitTarget = false
		Emitter = EmitterC
	}

	EmitterC : ~/BASE/Emitter
	{
		ChainedTo = WeaponC
		FireTrigger = WeaponC
		GetTargetFrom = WeaponC
		ResourceUsage
		[
			{
				ResourceStorage = MissileStorageC
				ResourcesUsed = (&~/BASE/MissileStorage/MaxResources)
			}
			{
				ResourceStorage = HeatStorageC
				ResourcesUsed = (&~/BASE/HeatStorage/MaxResources)
			}
		]
	}

	FirePermissionToggle
	{
		Type = MultiToggle
		Toggles = [CommonReloadTimerHE, FireModeToggle]
		Mode = All
	}

	CommonReloadResetTrigger
	{
		Type = MultiTrigger
		Triggers = [WeaponA, WeaponB, WeaponC]
	}
	
	LaunchEffectA : ~/BASE/LaunchEffect
	{
		ChainedTo = WeaponA
		Trigger = WeaponA
	}

	LaunchEffectB : ~/BASE/LaunchEffect
	{
		ChainedTo = WeaponB
		Trigger = WeaponB
	}

	LaunchEffectC : ~/BASE/LaunchEffect
	{
		ChainedTo = WeaponC
		Trigger = WeaponC
	}
	
	Router
	{
		Type = NetworkRouter
		RouteGenerators
		[
			{
				Type = Bidirectional
				Routes
				[
					[Port_Thermal_Left, Port_Thermal_Right, 0]
					
					[Port_Thermal_Left, NetworkHeatOutput, 0]
					[Port_Thermal_Left, NetworkHeatReceiver, 0]
				]
			}
		]
	}
	
	NetworkHeatOutput
	{
		Type = NetworkResourceOutput
		ResourceType = heat
		Mode = DistributeProportionallyByAvailable
		Categories = [ thermal_storage ]
	}
	
	NetworkHeatReceiver
	{
		Type = NetworkResourceStore
		ResourceType = heat
		ResourceStorage = CombinedHeatStorage
		AllowProviding = false
	}
	
	External_Walls_Graphics
	{
		Type = Graphics
		Location = [1, 1.0]
		Walls
		{
			Layer = "external_walls"
			DamageLevels
			[
				{
					File = "external_walls.png"
					NormalsFile = "external_walls_normals.png"
