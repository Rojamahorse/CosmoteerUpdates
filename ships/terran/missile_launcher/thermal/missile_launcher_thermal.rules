			MissileSpritesB : ../../MissileLoadingSpritesA/Components/MissileSpritesA
			{
				Location = [1, 1.5]
				ResourceStorage = MissileStorageB
			}
		}
	}
	MissileLoadedSpritesB : MissileLoadedSpritesA
	{
		Toggle = MissileStorageB
		Components
		{
			MissileHeatSpritesB : ../../MissileLoadedSpritesA/Components/MissileHeatSpritesA
			{
				Location = [1, 1.5]
				ResourceStorage =  HeatStorageB
			}
			MissileHeatGlowSpritesB : ../../MissileLoadedSpritesA/Components/MissileHeatGlowSpritesA
			{
				Location = [1, 1]
				ResourceStorage =  HeatStorageB
			}
		}
	}

