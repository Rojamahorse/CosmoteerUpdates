				AnimationStartTime = MinValue
				ClampAnimation = true
			}
		}

		WeaponSpriteRight : WeaponSpriteLeft
		{
			Location = [0.5, 0.5]//[1-0.3125, 0.359375]
			ResetAnimationTrigger = ShootRightTriggerProxy
			AtlasSprite : ^/0/AtlasSprite
			{
				MirrorU = true
			}
		}

		BatterySprites
		{
			Type = ResourceSprites
			Location = [1, 3.125]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Offset = [-0.5, -0.5]
					Size = [1, 1]
				}
				{
					File = "batteries2.png"
					Offset = [0, -0.5]
					Size = [2, 1]
				}
				{
					File = "batteries3.png"
					Offset = [0, -0.5]
					Size = [2, 1]
				}
				{
					File = "batteries4.png"
					Offset = [0, -0.5]
					Size = [2, 1]
				}
				{
