OVERCLOCK
{
	HEAT_PER_CONVERSION = 125
	SPEED_FACTOR = 300%
	POWER_USE_FACTOR = 150%
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Part : <../base_med_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/FactoryMine"
	IconNameKey = "Parts/FactoryMineIcon"
	ID = cosmoteer.factory_mine // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = [cosmoteer.mine_factory]
	EditorGroup = "Production"
	EditorParentParts = [ "cosmoteer.missile_launcher" ]
	DescriptionKey = "Parts/FactoryMineDesc"
	Resources
	[
		[steel, 96]
		[coil2, 50]
		[tristeel, 13]
	]
	Size = [4, 3]
	IsFlippable = true
	SelectionPriority = 1
	MaxHealth = 12000
	TypeCategories = [provides_mines, provides_launcher_parts, uses_iron, uses_ammo, uses_power]
	ReceivableBuffs : ^/0/ReceivableBuffs [Factory]
	BlockedTravelCells
	[
		[0, 0]
		[1, 0]
		[2, 0]
		[3, 0]
		[1, 1]
		[2, 1]
	]
	ForceManhattanPathInPart = true
	AllowedDoorLocations
	[
		[-1, 1]
		[-1, 2]
		[0, 3]
		[1, 3]
		[2, 3]
		[3, 3]
		[4, 2]
		[4, 1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 48]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, NonJunkToggle, IronSplitter, AmmoStorage, BatteryStorage, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		NonJunkToggle
		{
			Type = JunkToggle
			OnWhenJunk = false
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 1
		}

		IronStorage
		{
			Type = TypedResourceGrid
			ResourceType = iron
			GridRect = [0, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [17/64, 9/64, 5/64, 5/64]
			AllowExternalPickupAndDelivery = true
		}
		IronConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = iron
			Storage = IronStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}
		IronSplitter
		{
			Type = InlineResourceConverter
			ResourceType = iron
			FromStorage = IronStorage
			FromQuantity = 1
			ToQuantity = 40
		}

		AmmoStorage
		{
			Type = TypedResourceGrid
			ResourceType = bullet
			GridRect = [3, 1, 1, 1]
			Layer = "doodads_low"
			SpriteInset = [5/64, 9/64, 17/64, 5/64]
			ToggleOnResources = 1
			ToggleOffResources = 0
			AllowExternalPickupAndDelivery = true
		}
		AmmoConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = bullet
			Storage = AmmoStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}

		MineStorage
		{
			Type = TypedResourceGrid
			ResourceType = mine_part
			GridRect = [0, 2, 4, 1]
			Layer = "doodads_low"
			SpriteInset = [9/64, 6/64, 9/64, 16/64]
			SuppliesResources = true
			SupplyToggleButtonOffset = [0, -.4]
			InitToMaxResources = 0
			AllowExternalPickupAndDelivery = true
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 4000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Factory_Supply
			ResupplyThreshold = 500
			OperationalToggle = CommandConsumptionToggle
		}

		ResourceConverter
		{
			Type = ResourceConverter
			OperationalToggle = IsOperational
			From
			[
				{
					Storage = IronSplitter
					Quantity = 1
				}
				{
					Storage = AmmoStorage
					Quantity = 1
				}
				{
					Storage = BatteryStorage
					Quantity
			        {
			        	BaseValue = 250
			        	Modifiers
			        	[
			        		: ~/MODIFIERS/OVERCLOCK_LERP
			        		{
			        			MinValue = &../../BaseValue
			        			MaxValue = (&MinValue) * (&~/OVERCLOCK/POWER_USE_FACTOR)
			        		}
			        	]
			        }
					MinQuantityForConversion = 1
				}
			]
			ToStorage = MineStorage
			ToQuantity = 1
			Interval
			{
				BaseValue = 0.5
				Modifiers
				[
					{ Type = Buff; BuffType = Factory; ModificationMode = Divide; }
					{
						Type = BuffRemap
						BuffType = Overclock
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
						ModificationMode = Divide
					}
				]
			}
			CheckResourceLimits = true
		}

		BuildEffects
		{
			Type = TriggeredEffects
			Trigger = ResourceConverter
			Location = [2, 1.5]
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInteriorDetail
				{
					RandomSounds = ["sounds/mine_factory_putdown_01.wav",
									"sounds/mine_factory_putdown_02.wav",
									"sounds/mine_factory_putdown_03.wav",
									"sounds/mine_factory_putdown_04.wav",
									"sounds/mine_factory_putdown_05.wav"]
					Volume = 1
					Db = -2
					Speed = 1
					SpeedVariation = .05
				}
			]
		}

		BuffProvider
		{
			Type = GridBuffProvider
			BuffType = Factory
			BuffAmount = 25%
			GridDistance = 1
			OperationalToggle = BatteryStorage
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_ConversionHeatProducer
		{
			Type = ResourceChange
			OperationalToggle = IsOverclocked
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_ResourceConverterProxy
			Amount = (&~/OVERCLOCK/HEAT_PER_CONVERSION) * (&~/HEAT_TO_RESOURCE)
		}

		Overclock_ResourceConverterProxy
		{
			Type = TriggerProxy
			ProxyToggle = IsOverclocked
			ComponentID = ResourceConverter
		}

		Port_Thermal_Left0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 1]
			Direction = Left
		}
		Port_Thermal_Left1 : Port_Thermal_Left0
		{
			Location = [0, 2]
		}
		Port_Thermal_Down0 : Port_Thermal_Left0
		{
			Location = [0, 2]
			Direction = Down
		}
		Port_Thermal_Down1 : Port_Thermal_Down0
		{
			Location = [1, 2]
		}
		Port_Thermal_Down2 : Port_Thermal_Down0
		{
			Location = [2, 2]
		}
		Port_Thermal_Down3 : Port_Thermal_Down0
		{
			Location = [3, 2]
		}
		Port_Thermal_Right0 : Port_Thermal_Left0
		{
			Location = [3, 1]
			Direction = Right
		}
		Port_Thermal_Right1 : Port_Thermal_Right0
		{
			Location = [3, 2]
		}

		IronSprites : <../factory_he/factory_he.rules>/Part/Components/IronSprites {}

		FloorSprite
		{
			Type = Sprite
			OnlyWithFlip = false
			Location = [2, 1.5]
			Layer = "floors"
			DamageLevels
			[
				{
					File = "floor.png"
					Size = [4, 3]
				}
				{
					File = "floor_33.png"
					Size = [4, 3]
				}
				{
					File = "floor_66.png"
					Size = [4, 3]
				}
			]
		}

		FloorSpriteFlipped
		{
			Type = Sprite
			OnlyWithFlip = true
			Location = [2, 1.5]
			Layer = "floors"
			DamageLevels
			[
				{
					File = "floor_flipped.png"
					Size = [4, 3]
				}
				{
					File = "floor_flipped_33.png"
					Size = [4, 3]
				}
				{
					File = "floor_flipped_66.png"
					Size = [4, 3]
				}
			]
		}

		BeltSpeedFactor
		{
			Type = BuffableValue
			Value
			{
				BaseValue = 1
				Modifiers
				[
					{
						Type = Buff
						BuffType = Factory
						ModificationMode = Multiply
					}
					{
						Type = BuffRemap
						BuffType = Overclock
						ModificationMode = Multiply
						RemapFrom = [0, 1]
						RemapTo = [1, &~/OVERCLOCK/SPEED_FACTOR]
					}
				]
			}
		}

		Graphics
		{
			Type = Graphics
			Location = [2, 1.5]
			OperationalToggle = IsOperational
			DoodadToggle = ResourceConverter
			AnimationSpeedFactor = BeltSpeedFactor
			ToggleOnDoodad
			{
				Layer = "walls" //Wall layer so the robotic arm sprites are draw over the resources sprites
				Offset = [0, -.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
							"doodads_on5.png"
							"doodads_on6.png"
							"doodads_on7.png"
							"doodads_on8.png"
						]
						Size = [4, 2]
						AnimationInterval = 0.0625
					}
					{
						AnimationFiles
						[
							"doodads_on1_33.png"
							"doodads_on2_33.png"
							"doodads_on3_33.png"
							"doodads_on4_33.png"
							"doodads_on5_33.png"
							"doodads_on6_33.png"
							"doodads_on7_33.png"
							"doodads_on8_33.png"
						]
						Size = [4, 2]
						AnimationInterval = &../0/AnimationInterval
					}
					{
						AnimationFiles
						[
							"doodads_on1_66.png"
							"doodads_on2_66.png"
							"doodads_on3_66.png"
							"doodads_on4_66.png"
							"doodads_on5_66.png"
							"doodads_on6_66.png"
							"doodads_on7_66.png"
							"doodads_on8_66.png"
						]
						Size = [4, 2]
						AnimationInterval = &../0/AnimationInterval
					}
				]
			}
			ToggleOffDoodad
			{
				Layer = "walls" //Wall layer so the robotic arm sprites are draw over the resources sprites
				Offset = [0, -.5]
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_idle1.png"
							"doodads_idle2.png"
							"doodads_idle3.png"
							"doodads_idle4.png"
							"doodads_idle5.png"
							"doodads_idle6.png"
							"doodads_idle7.png"
							"doodads_idle8.png"
						]
						Size = [4, 2]
						AnimationInterval = 0.1125
						AnimationStartTime = WhenSpawned
					}
					{
						AnimationFiles
						[
							"doodads_idle1_33.png"
							"doodads_idle2_33.png"
							"doodads_idle3_33.png"
							"doodads_idle4_33.png"
							"doodads_idle5_33.png"
							"doodads_idle6_33.png"
							"doodads_idle7_33.png"
							"doodads_idle8_33.png"
						]
						Size = [4, 2]
						AnimationInterval = &../0/AnimationInterval
						AnimationStartTime = WhenSpawned
					}
					{
						AnimationFiles
						[
							"doodads_idle1_66.png"
							"doodads_idle2_66.png"
							"doodads_idle3_66.png"
							"doodads_idle4_66.png"
							"doodads_idle5_66.png"
							"doodads_idle6_66.png"
							"doodads_idle7_66.png"
							"doodads_idle8_66.png"
						]
						Size = [4, 2]
						AnimationInterval = &../0/AnimationInterval
						AnimationStartTime = WhenSpawned
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "walls" //Wall layer so the robotic arm sprites are draw over the resources sprites
				Offset = [0, -.5]
				DamageLevels
				[
					{
						File = "doodads_off.png"
						Size = [4, 2]
					}
					{
						File = "doodads_off_33.png"
						Size = [4, 2]
					}
					{
						File = "doodads_off_66.png"
						Size = [4, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [4, 3]
					}
					{
						File = "walls_33.png"
						Size = [4, 3]
					}
					{
						File = "walls_66.png"
						Size = [4, 3]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [4, 3]
					}
				]
			}

			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [0, -29/64]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [4.5, 4.5]
						Z = 0.5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.5, 0, 0]
					}
				]
			}
		}

		RoofDoorOpenToggle
		{
			Type = CrewDestinationProximityToggle
			Distance = 3
		}
		RoofDoorSprite
		{
			Type = OpenCloseSprite
			Location = [2, 1.5]
			OperationalToggle = RoofDoorOpenToggle
			Layer = "roofs"
			OpenDamageLevels
			[
				{
					AnimationFiles
					[
						"roof1.png"
						"roof2.png"
						"roof3.png"
						"roof4.png"
						"roof5.png"
						"roof6.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals1.png"
						"roof_normals2.png"
						"roof_normals3.png"
						"roof_normals4.png"
						"roof_normals5.png"
						"roof_normals6.png"
					]
					Size = [4, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
				{
					AnimationFiles
					[
						"roof1_33.png"
						"roof2_33.png"
						"roof3_33.png"
						"roof4_33.png"
						"roof5_33.png"
						"roof6_33.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals1_33.png"
						"roof_normals2_33.png"
						"roof_normals3_33.png"
						"roof_normals4_33.png"
						"roof_normals5_33.png"
						"roof_normals6_33.png"
					]
					Size = [4, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
				{
					AnimationFiles
					[
						"roof1_66.png"
						"roof2_66.png"
						"roof3_66.png"
						"roof4_66.png"
						"roof5_66.png"
						"roof6_66.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals1_66.png"
						"roof_normals2_66.png"
						"roof_normals3_66.png"
						"roof_normals4_66.png"
						"roof_normals5_66.png"
						"roof_normals6_66.png"
					]
					Size = [4, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
			]
			ClosedDamageLevels
			[
				{
					AnimationFiles
					[
						"roof6.png"
						"roof5.png"
						"roof4.png"
						"roof3.png"
						"roof2.png"
						"roof1.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals6.png"
						"roof_normals5.png"
						"roof_normals4.png"
						"roof_normals3.png"
						"roof_normals2.png"
						"roof_normals1.png"
					]
					Size = [4, 3]
					AnimationInterval = 0.06
					AnimationStartTime = MinValue
					ClampAnimation = true
				}
				{
					AnimationFiles
					[
						"roof6_33.png"
						"roof5_33.png"
						"roof4_33.png"
						"roof3_33.png"
						"roof2_33.png"
						"roof1_33.png"
					]
					NormalsAnimationFiles
					[
						"roof_normals6_33.png"
						"roof_normals5_33.png"
						"roof_normals4_33.png"
						"roof_normals3_33.png"
						"roof_normals2_33.png"
						"roof_normals1_33.png"
					]
					Size = [4, 3]
					AnimationInterval = 0.06
