		}

		BatterySprites
		{
			Type = ResourceSprites
			Location = [2, 1.5]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 1]
					OffSet = [-1, 0]
				}
				{
					File = "batteries2.png"
					Size = [1, 1]
					OffSet = [-1, 0]
				}
				{
					File = "batteries3.png"
					Size = [3, 1]
				}
				{
					File = "batteries4.png"
					Size = [3, 1]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [2, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOnLarge
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOffLarge
		}

		OperationSoundLoop
		{
			Type = ContinuousEffects
			Location = [1, 1]
			OperationalToggle = IsOperational
			MaxMediaEffectsZoom = 4
			MediaEffects
			[
				: /BASE_SOUNDS/AudioInterior
				{
					Sound = "sounds/mine_factory_idle.wav"
					Volume = 1
					MaxConcurrentVolume = 1
					Speed = 1
					MaxConcurrent = 1
				}
			]
		}

		ScorchedToggle
		{
			Type = StatusToggle
			MinStatusValue = 1
			StatusType = cosmoteer.scorched
			Invert = true
			IncludeWhenUnderConstruction = true
		}
		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
			TriggerWhenOff = true
		}
		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &~/Part/Components/DestroyedEffects/Location
			MediaEffects = &~/Part/Components/DestroyedEffects/MediaEffects
			HitEffects = &~/Part/Components/DestroyedEffects/HitEffects
		}

		DestroyedEffects
		{
			Type = DeathEffects
			OperationalToggle = ScorchedToggle
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [2, 1.5]

			HitEffects
			[
				{
					Type = ExplosiveDamage
					TotalDamage = 64500
					Radius = 5
					Delay = .05
					StatusChancePerNDamage = 100%
					StatusValue = 1
					StatusValueType = Interpolated
					NDamage = 1000
					CrewKillChance = 50%
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
				{
					Type = ExplosiveDamage
					TotalDamage = 20000
					Radius = 4
					Delay = .05
					Filter
					{
						OperationalHealth = false
						StructuralHealth = true
						Friendlies = true
						Crew = false
					}
				}
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [2, 1.5]
			Indicators
			[
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [1,2,3,4]
				}

				// No iron.
				{
					Toggle = IronSplitter
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// Out of ammo.
				{
					Toggle = AmmoStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoResource
						Size = [1, 1]
					}
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}

				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			OnlyWithFlip = false
			File = "blueprints.png"
			Size = [4, 3]
		}

		BlueprintsFlipped
		{
			Type = BlueprintSprite
			OnlyWithFlip = true
			File = "blueprints_flipped.png"
			Size = [4, 3]
		}

		Overclock_HeatProductionInterval
		{
			Type = BuffableValue
			Value = &~/Part/Components/ResourceConverter/Interval
			IncludeInBlueprints = true
		}
		Overclock_HeatPerConversion { Type = StaticValue; Value = &~/OVERCLOCK/HEAT_PER_CONVERSION; }
		HeatGenerationValue
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_HeatPerConversion
			ValueTwo = Overclock_HeatProductionInterval
			NaNFallbackValue = 0
			IncludeInBlueprints = Normal
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = HeatGenerationValue
		}
	}

	Stats
	{
		PartsPerMine = &<../missile_launcher/mine/missile_launcher_mine.rules>/Components/Emitter1/ResourcesUsed
		MineProduction = (&~/Part/Components/ResourceConverter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) / (&PartsPerMine)
		PartCapacity = (&~/Part/Components/MineStorage/GridRect/2) * (&~/Part/Components/MineStorage/GridRect/3) * (&<./Data/resources/mine_part/mine_part.rules>/MaxStackSize)
		MinePartCapacity = [&../PartCapacity, (&../PartCapacity) / (&../PartsPerMine)]
		IronCapacity = (&~/Part/Components/IronStorage/GridRect/2) * (&~/Part/Components/IronStorage/GridRect/3) * (&<./Data/resources/iron/iron.rules>/MaxStackSize)
		IronPerMine = (&~/Part/Components/IronSplitter/FromQuantity) / (&~/Part/Components/IronSplitter/ToQuantity) / (&~/Part/Components/ResourceConverter/ToQuantity) * (&PartsPerMine)
		IronPerSecond = (&~/Part/Components/IronSplitter/FromQuantity) / (&~/Part/Components/IronSplitter/ToQuantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		MineIronUsage = [&../IronPerMine, &../IronPerSecond]
		AmmoPerMine = (&~/Part/Components/ResourceConverter/From/1/Quantity) / (&~/Part/Components/ResourceConverter/ToQuantity) * (&PartsPerMine)
		AmmoPerSecond = (&~/Part/Components/ResourceConverter/From/1/Quantity) / (&~/Part/Components/ResourceConverter/Interval/BaseValue)
		MineAmmoUsage = [&../AmmoPerMine, &../AmmoPerSecond]
		AmmoCapacity = (&~/Part/Components/AmmoStorage/GridRect/2) * (&~/Part/Components/AmmoStorage/GridRect/3) * (&<./Data/resources/bullet/bullet.rules>/MaxStackSize)
		PowerPerMine = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/ToQuantity) * (&PartsPerMine) / 1000
		PowerPerSecond = (&~/Part/Components/ResourceConverter/From/2/Quantity/BaseValue) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) / 1000
		MinePowerUsage = [&../PowerPerMine, &../PowerPerSecond]
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		FactoryBuff = (&~/Part/Components/BuffProvider/BuffAmount) * 100

		RecPower = &PowerPerSecond
		RecAmmo = &AmmoPerSecond
		RecCrew = (&RecPower) * 4 + (&RecAmmo) * 2
	}

	StatsByCategory
	[
		&<../missile_launcher/mine/missile_launcher_mine.rules>/MineStats
		&<../missile_launcher/mine/missile_launcher_mine.rules>/ShrapnelStats
	]

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/FactoryMineOverclockDesc"
		Stats
		{
			MineProduction = (&~/Part/Stats/MineProduction) * (&~/OVERCLOCK/SPEED_FACTOR)
			MineIronUsage = [(&~/Part/Stats/MineIronUsage/0), (&~/Part/Stats/MineIronUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
			MineAmmoUsage = [(&~/Part/Stats/MineAmmoUsage/0), (&~/Part/Stats/MineAmmoUsage/1) * (&~/OVERCLOCK/SPEED_FACTOR)]
			POWER_PER_MINE = (&~/Part/Stats/MinePowerUsage/0) * (&~/OVERCLOCK/POWER_USE_FACTOR)
			POWER_PER_SECOND = (&~/Part/Stats/MinePowerUsage/1) * (&~/OVERCLOCK/POWER_USE_FACTOR) * (&~/OVERCLOCK/SPEED_FACTOR)
			MinePowerUsage = [&../POWER_PER_MINE, &../POWER_PER_SECOND]
			CONVERSION_OUTPUT = (&~/Part/Components/ResourceConverter/ToQuantity)
			HEAT_PER_MINE = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&CONVERSION_OUTPUT) * (&~/Part/Stats/PartsPerMine)
			HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_CONVERSION) / (&~/Part/Components/ResourceConverter/Interval/BaseValue) * (&~/OVERCLOCK/SPEED_FACTOR);
			MineHeatGeneration = [&../HEAT_PER_MINE, &../HEAT_PER_SECOND]
		}
	}
}

MODIFIERS
{
	OVERCLOCK_LERP
	{
		Type = Buff
		BuffType = Overclock
		ModificationMode = Lerp
	}
}