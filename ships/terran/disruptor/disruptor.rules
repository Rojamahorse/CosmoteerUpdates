OVERCLOCK
{
	BULLET = &<./Data/shots/disruptor_bolt/disruptor_bolt_overclock.rules>
	HEAT_PER_SHOT = 300
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO

Part : <../base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/Disruptor"
	IconNameKey = "Parts/DisruptorIcon"
	ID = cosmoteer.disruptor // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = [electro_bolt, cosmoteer.electro_bolter]
	EditorGroup = "WeaponsEnergy"
	DescriptionKey = "Parts/DisruptorDesc"
	Resources
	[
		[steel, 40]
		[coil, 8]
		[coil2, 4]
	]
	TypeCategories = [weapon, uses_power, is_crewed]
	SignificanceToggle = ScorchedToggle
	Size = [1, 4]
	PhysicalRect = [0, 1, 1, 3]
	SaveRect = &PhysicalRect
	SelectionPriority = 1
	SelectionTypeByRotation = true
	MaxHealth = 5000
	InitialPenetrationResistance = 1
	ProhibitAbove = 1
	AllowedDoorLocations
	[
		[-1, 3]
		[1, 3]
		[0, 4]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [13, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, BatteryStorage, PartCrew, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 2
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		BatteryStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = 6000
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/PowerDeliver
		}
		BatteryConsumer
		{
			Type = ResourceConsumer
			ResourceType = battery
			Storage = BatteryStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			ResupplyThreshold = 1000
			OperationalToggle = CommandConsumptionToggle
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		OverheatEffects : ^/0/OverheatEffects
		{
			Location = [0.5, 1.5]
		}

		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_BulletEmitter
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}

		Port_Thermal_Left : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 3]
			Direction = Left
		}
		Port_Thermal_Right : Port_Thermal_Left
		{
			Direction = Right
		}
		Port_Thermal_Down : Port_Thermal_Left
		{
			Direction = Down
		}

		TurretHolder_Graphics
		{
			Type = Graphics
			Location = [.5, .5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "weapons"
				DamageLevels
				[
					{
						File = "turret_holder.png"
						NormalsFile = "turret_holder_normals.png"
						Size = [1, 1]
					}
					{
						File = "turret_holder_33.png"
						NormalsFile = "turret_holder_normals.png"
						Size = [1, 1]
					}
					{
						File = "turret_holder_66.png"
						NormalsFile = "turret_holder_normals.png"
						Size = [1, 1]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"turret_holder1.png"
							"turret_holder2.png"
							"turret_holder3.png"
							"turret_holder4.png"
							"turret_holder5.png"
							"turret_holder6.png"
							"turret_holder7.png"
							"turret_holder8.png"
						]
						Size = [1, 1]
						AnimationInterval = 0.1
					}
				]
			}
		}

		Graphics
		{
			Type = Graphics
			Location = [.5, 2.5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [1, 3]
					}
					{
						File = "floor_33.png"
						Size = [1, 3]
					}
					{
						File = "floor_66.png"
						Size = [1, 3]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
							"doodads_on5.png"
							"doodads_on6.png"
							"doodads_on7.png"
							"doodads_on8.png"
						]
						Size = [1, 3]
						AnimationInterval = 0.1
					}
					{
						AnimationFiles
						[
							"doodads_on1_33.png"
							"doodads_on2_33.png"
							"doodads_on3_33.png"
							"doodads_on4_33.png"
							"doodads_on5_33.png"
							"doodads_on6_33.png"
							"doodads_on7_33.png"
							"doodads_on8_33.png"
						]
						Size = [1, 3]
						AnimationInterval = 0.1
					}
					{
						AnimationFiles
						[
							"doodads_on1_66.png"
							"doodads_on2_66.png"
							"doodads_on3_66.png"
							"doodads_on4_66.png"
							"doodads_on5_66.png"
							"doodads_on6_66.png"
							"doodads_on7_66.png"
							"doodads_on8_66.png"
						]
						Size = [1, 3]
						AnimationInterval = 0.1
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [1, 3]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [1, 3]
					}
					{
						File = "walls_33.png"
						Size = [1, 3]
					}
					{
						File = "walls_66.png"
						Size = [1, 3]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [1, 3]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [1, 3]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [1, 3]
					}
				]
			}
			OperationalRoofDoodad
			{
				Layer = "roof_doodads"
				DamageLevels
				[
					{
						File = "roof_glows.png"
						Size = [1, 3]
					}
					{
						File = "roof_glows_33.png"
						Size = [1, 3]
					}
					{
						File = "roof_glows_66.png"
						Size = [1, 3]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [0, -1.15]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [2, 2]
						Z = .5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.5, 255*1.5, 0]
					}
				]
			}
		}

		Turret
		{
			Type = TurretWeapon
			Location = [.5, .390625] // Relative to upper-left corner of unrotated part.
			Rotation = -90d // Relative to unrotated part.
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = .5
			FiringArc = 200d
			RotateSpeed = 90d
			FireThresholdAngle = 1d
			AIFirepowerRating = 600
			Emitter = WeaponEmitterSelector
			FirePermissionToggle = FireModeToggle
			AutoTargetCrewSafetyDist = 8
			ToggleOnMode = IsReloaded

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}
		WeaponEmitterSelector
		{
			Type = ToggleEmitterSelector
			Toggle = IsOverclocked
			ToggleOffEmitter = BulletEmitter
			ToggleOnEmitter = Overclock_BulletEmitter
		}
		TurretTriggered_Overclocked
		{
			Type = TriggerProxy
			ComponentID = Turret
			ProxyToggle = IsOverclocked
		}
		TurretTriggered_NonOverclocked : TurretTriggered_Overclocked
		{
			InvertProxyToggle = true
		}

		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOperational, { Toggle=IsOverclocked; Invert=true } ]
			Mode = All
		}

		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperational
			ShowProgressFor = Turret
		}

		BulletEmitter
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger = Turret
			GetTargetFrom = Turret
			Location = [.75, 0]
			OperationalToggle = IsOperationalNonOverclocked
			FireDelay = .3
			Bullet = &<./Data/shots/disruptor_bolt/disruptor_bolt.rules>
			ResourceStorage = BatteryStorage
			ResourcesUsed = 250
			MinResourcesUsed = 1
		}
		Overclock_BulletEmitter : BulletEmitter
		{
			OperationalToggle = IsOperationalOverclocked
			Bullet = &~/OVERCLOCK/BULLET/Bullet
		}

		ChargeEffect_NonOverclocked
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = TurretTriggered_NonOverclocked
			Location = [.85975, 0]
			AnchorMediaEffects = true

			MediaEffects
			[
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["sounds/disruptor_reload_01.wav",
									"sounds/disruptor_reload_02.wav",
									"sounds/disruptor_reload_03.wav"]
					Volume = 1
					Speed = 1
				}
			]
		}
		ChargeEffect_Overclocked : ChargeEffect_NonOverclocked
		{
			Trigger = TurretTriggered_Overclocked
			MediaEffects
			[
				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds
					[
						"sounds/disruptor_overclocked_reload_01.wav"
						"sounds/disruptor_overclocked_reload_02.wav"
						"sounds/disruptor_overclocked_reload_03.wav"
					]
				}
			]
		}

		FireEffect
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = BulletEmitter
			Location = [.9,0]
			AnchorMediaEffects = true

			MediaEffects
			[
				&<particles/disruptor_shoot_rings.rules>
				&<particles/disruptor_shoot_lightning.rules>
				&<particles/disruptor_shoot_flash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["sounds/disruptor_shot_01.wav",
									"sounds/disruptor_shot_02.wav",
									"sounds/disruptor_shot_03.wav",
									"sounds/disruptor_shot_04.wav"]
					Volume = 1
					SpeedVariation = .05
				}
			]
		}

		OverclockFireEffect
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = Overclock_BulletEmitter
			Location = [.9,0]
			AnchorMediaEffects = true

			MediaEffects
			[
				&<particles/disruptor_shoot_rings.rules>
				&<particles/disruptor_shoot_lightning.rules>
				&<particles/disruptor_shoot_flash.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					RandomSounds = ["sounds/disruptor_overclocked_shot_01.wav",
									"sounds/disruptor_overclocked_shot_02.wav",
									"sounds/disruptor_overclocked_shot_03.wav",
									"sounds/disruptor_overclocked_shot_04.wav"]
					Volume = 1
					SpeedVariation = .05
				}
			]
		}

		CrewLocation
		{
			Type = CrewLocation
			Location = [.5, 3.27]
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 1
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle, ScorchedToggle]
			HighPriorityPrerequisites = [BatteryStorage]
			CrewDestinations
			[
				&../../CrewLocation/Location
			]
			CrewLocations
			[
				CrewLocation
			]
		}

		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = .45
			Density = .75
			InitialPenetrationResistance = 3
		}

		TurretGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [.390625, 0]
			Rotation = 90d
			OperationalDoodad
			{
				Layer = "structure"
				DamageLevels
				[
					{
						File = "turret.png"
						NormalsFile = "turret_normals.png"
						Size = [1, 2]
					}
					{
						File = "turret_33.png"
						NormalsFile = "turret_normals.png"
						Size = [1, 2]
					}
					{
						File = "turret_66.png"
						NormalsFile = "turret_normals.png"
						Size = [1, 2]
					}
				]
			}
		}

		WeaponSprite
		{
			Type = Sprite
			ChainedTo = Turret
			OperationalToggle = IsOperational
			Location = [.390625, 0]
			Rotation = 90d
			Layer = "doodads_low"
			ResetAnimationTrigger = Turret
			AtlasSprite
			{
				AnimationFiles
				[
					"weapon2.png"
					"weapon3.png"
					"weapon4.png"
					"weapon5.png"
					"weapon6.png"
					"weapon7.png"
					"weapon8.png"
					"weapon1.png"// Loop back to beginning and clamp there.
				]
				Size = [1, 2]
				AnimationInterval = 0.05//6
				AnimationStartTime = MinValue
				ClampAnimation = true
			}
		}

		AmmoSprites
		{
			Type = ResourceSprites
			Location = [.5, 2]
			ResourceStorage = BatteryStorage
			Layer = "doodads_high"
			ResourceLevels
			[
				{
					File = "batteries1.png"
					Size = [1, 2]
				}
				{
					File = "batteries2.png"
					Size = [1, 2]
				}
				{
					File = "batteries3.png"
					Size = [1, 2]
				}
				{
					File = "batteries4.png"
					Size = [1, 2]
				}
				{
					File = "batteries5.png"
					Size = [1, 2]
				}
				{
					File = "batteries6.png"
					Size = [1, 2]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [.5, 1.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/PowerOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/PowerOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/MedPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/MedPartDestroyed
			Location = [.5, 2]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [.5, 2]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3,4]
				}
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3,4]
				}

				// Out of power.
				{
					Toggle = BatteryStorage
					Delay = &~/Part/Components/Turret/FireInterval
					AtlasSprite
					{
						File = &/INDICATORS/NoPower
						Size = [1, 1]
					}
				}

				// Resetting from overclock
				{
					Toggle = &~/Part/^/0/OVERCLOCK_OPERATIONAL
					AtlasSprite : /INDICATORS/OverclockReset
					{
						Size = [1, 1]
					}
					HidesIndicators = [4]
				}

				// No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [1, 5]
			Offset = [0, -.5]
		}

		PeakHeatGenerationValue
		{
			Type = StaticValue
			SHOT_HEAT_PER_SECOND = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/Part/StatsByCategory/0/Stats/ROF)
			Value = (&SHOT_HEAT_PER_SECOND)
		}
		HeatGenerationStatProvider
		{
			Type = StatProvider
			Stat = HeatGeneration
			OperationalToggle = OverclockModeToggle
			ValueFrom = PeakHeatGenerationValue
		}
	}

	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		PowerCapacity = (&~/Part/Components/BatteryStorage/MaxResources) / 1000
		TurretPenResist = &~/Part/Components/TurretCollider/InitialPenetrationResistance

		RecPower = &../StatsByCategory/0/Stats/PowerPerSecond
		RecCrew = (&CrewRequired) + (&RecPower) * 4
	}

	StatsByCategory
	[
		{
			NameKey = "StatCategories/DisruptorBolt"
			Stats
			{
				DamagePerShot = &~/Part/Components/BulletEmitter/Bullet/Components/Hit/HitOperational/HitEffects/1/Damage/BaseValue
				DamagePerSecond = (&DamagePerShot) * (&ROF)
				Damage = [&../DamagePerShot, &../DamagePerSecond]
				ShieldDamagePerShot = (&~/Part/Components/BulletEmitter/Bullet/Components/Hit/HitShield/HitEffects/0/Amount/BaseValue) / (&<../shield_gen_small/shield_gen_small.rules>/Part/Components/ArcShield/ResourceDrainPerDamage/BaseValue)
				ShieldDamagePerSecond = (&ShieldDamagePerShot) * (&ROF)
				ShieldDamage = [&../ShieldDamagePerShot, &../ShieldDamagePerSecond]
				PowerDrainPerShot = (&~/Part/Components/BulletEmitter/Bullet/Components/Hit/HitOperational/HitEffects/0/Amount/BaseValue) / 1000
				PowerDrainPerSecond = (&PowerDrainPerShot) * (&ROF)
				PowerDrain = [&../PowerDrainPerShot, &../PowerDrainPerSecond]
				ShieldPenetration = &~/Part/Components/BulletEmitter/Bullet/Components/Hit/Penetration
				ROF = 1 / (&~/Part/Components/Turret/FireInterval)
				Range = &~/Part/Components/BulletEmitter/Bullet/Range
				Arc = deg(&~/Part/Components/Turret/FiringArc)
				TurretSpeed = deg(&~/Part/Components/Turret/RotateSpeed)
				ShotSpeed = &~/Part/Components/BulletEmitter/Bullet/Speed
				ShotHP = &~/Part/Components/BulletEmitter/Bullet/Components/Targetable/Health
				PowerPerShot = (&~/Part/Components/BulletEmitter/ResourcesUsed) / 1000
				PowerPerSecond = (&PowerPerShot) * (&ROF)
				ShotPowerUsage = [&../PowerPerShot, &../PowerPerSecond]
			}
		}
	]

	SecondaryToolTip
	{
		TitleKey = "StatCategories/Overclocked"
		DescriptionKey = "Parts/DisruptorOverclockDesc"
		StatsByCategory
		[
			{
				NameKey = "StatCategories/DisruptorBoltOverclocked"
				Stats
				{
					PowerDrain = [0, 0]
					HeatPerShot = (&~/OVERCLOCK/HEAT_PER_SHOT)
					Range = &~/OVERCLOCK/BULLET/RANGE
					Penetration = &~/OVERCLOCK/BULLET/PENETRATION
					ArmorPenetrationResistance = (&~/OVERCLOCK/BULLET/ARMOR_PENETRATION_FACTOR) * 100
				}
				Features
				[
					PenetratesOperational
				]
			}
			{
				NameKey = "StatCategories/OverclockedDisruption"
				Stats
				{
					PowerDrainOverTime = [(&~/OVERCLOCK/BULLET/TOTAL_DRAIN) / 1000, (&~/OVERCLOCK/BULLET/DRAIN_PER_SECOND) / 1000]
					SHIELD_DRAIN_PER_DAMAGE = &<../shield_gen_small/shield_gen_small.rules>/Part/Components/ArcShield/ResourceDrainPerDamage/BaseValue
					ShieldDamageOverTime = [(&~/OVERCLOCK/BULLET/TOTAL_SHIELD_DRAIN) / (&../SHIELD_DRAIN_PER_DAMAGE), (&~/OVERCLOCK/BULLET/SHIELD_DRAIN_PER_SECOND) / (&../SHIELD_DRAIN_PER_DAMAGE)]
					EffectDuration = &~/OVERCLOCK/BULLET/DRAIN_DURATION
				}
			}
		]
	}
}