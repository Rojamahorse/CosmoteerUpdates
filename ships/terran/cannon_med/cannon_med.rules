OVERCLOCK
{
	HEAT_PER_SHOT = 265
	BURST = 3
	BURST_DELAY = 0.1
	FIRE_INTERVAL_FACTOR = 200%
	HALF_SPREAD = 1.5d

	EXTRA_INTERVAL = (&~/Part/Components/Turret/FireInterval) * ((&FIRE_INTERVAL_FACTOR) - 100%)
}
HEAT_TO_RESOURCE = &<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO
HEAT_TO_STATUS = &<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO
BULLET = &~/Part/Components/BulletEmitter/Bullet

Part : <../base_part_terran_overclock.rules>/Part
{
	NameKey = "Parts/CannonMed"
	IconNameKey = "Parts/CannonMedIcon"
	ID = cosmoteer.cannon_med // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	OtherIDs = [med_cannon]
	EditorGroup = "WeaponsProjectile"
	DescriptionKey = "Parts/CannonMedDesc"
	Resources
	[
		[steel, 48]
		[coil, 8]
	]
	TypeCategories = [weapon, uses_ammo, is_crewed]
	SignificanceToggle = ScorchedToggle
	Size = [2, 2]
	PhysicalRect = [0, 1, 2, 1]
	SaveRect = &PhysicalRect
	SelectionPriority = 1
	SelectionTypeByRotation = true
	SelectionTypeID = "cannons"
	MaxHealth = 12000
	InitialPenetrationResistance = 5
	ProhibitAbove = 1
	ReceivableBuffs : ^/0/ReceivableBuffs []
	AllowedDoorLocations
	[
		[-1, 1]
		[2, 1]
		[0, 2]
		[1, 2]
	]
	ExternalWallsByCell
	[
		{
			Key = [0, 1]
			Value = [TopLeft, Bottom, BottomLeft, Left]
		}
		{
			Key = [1, 1]
			Value = [TopRight, Right, BottomRight, Bottom]
		}
	]
	InternalWallsByCell
	[
		{
			Key = [0, 0]
			Value = [Left, TopLeft, Top, TopRight]
		}
		{
			Key = [1, 0]
			Value = [Right, TopRight, Top, TopLeft]
		}
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Point
			MipLevels = max
		}
		Size = [42.66, 64]
	}
	Components : ^/0/Components
	{
		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle, &~/Part/^/0/OVERCLOCK_OPERATIONAL]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 2
		}

		FireModeToggle
		{
			Type = UIToggle
			ToggleID = "fire_mode"
			Default = 1
			ToggledOnChoices = [0, 1, 2]
		}
		AutoTargetToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnModes = [1, 2]
		}
		AutoFireToggle
		{
			Type = ModeToggle
			Mode = FireModeToggle
			OnMode = 2
		}

		LoadedAmmo
		{
			Type = ResourceStorage
			ResourceType = bullet
			MaxResources = 1
			DelayBeforeReadyToUse = .25
			AnticipateMoreResourcesFrom = ["AmmoStorage"]
			ToggleOnResources = 1
			ToggleOffResources = 0
			DropResourcesWhenDestroyed = true
		}
		AmmoStorage
		{
			Type = ResourceStorage
			ResourceType = bullet
			MaxResources = 15
			DropResourcesWhenDestroyed = true
		}
		CombinedAmmo
		{
			Type = MultiResourceStorage
			ResourceType = bullet
			ResourceStorages = [LoadedAmmo, AmmoStorage]
			UITileRect = [.5 + 7/64, .75 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			AddMode = InReverseOrder
		}
		AmmoConsumer
		{
			Type = ResourceConsumer
			ResourceType = bullet
			Storage = CombinedAmmo
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}
		AmmoLoader
		{
			Type = ResourceConverter
			OperationalToggle = ScorchedToggle
			FromStorage = AmmoStorage
			ToStorage = LoadedAmmo
			FromQuantity = 1
			ToQuantity = 1
			Interval = .15
			DelayTrigger = Turret
			DelayAfterTrigger = .5
		}
		LoadEffects
		{
			Type = TriggeredEffects
			Trigger = AmmoLoader
			MediaEffects = &/COMMON_EFFECTS/AmmoLoad
		}

		External_Walls_Graphics
		{
			Type = Graphics
			Location = [1, 0.5]
			Walls
			{
				Layer = "external_walls"
				DamageLevels
				[
					{
						File = "external_walls.png"
						NormalsFile = "external_walls_normals.png"
						Size = [2, 1]
					}
					{
						File = "external_walls_33.png"
						NormalsFile = "external_walls_normals_33.png"
						Size = [2, 1]
					}
					{
						File = "external_walls_66.png"
						NormalsFile = "external_walls_normals_66.png"
						Size = [2, 1]
					}
				]
			}
		}

		Graphics
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [2, 2]
					}
					{
						File = "floor_33.png"
						Size = [2, 2]
					}
					{
						File = "floor_66.png"
						Size = [2, 2]
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						File = "lights.png"
						Size = [2, 2]
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [2, 2]
					}
					{
						File = "walls_33.png"
						Size = [2, 2]
					}
					{
						File = "walls_66.png"
						Size = [2, 2]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [2, 2]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [2, 2]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [2, 2]
					}
				]
			}
			OperationalRoofDoodad
			{
				Layer = "roof_doodads"
				DamageLevels
				[
					{
						File = "roof_glows.png"
						Size = [2, 2]
					}
					{
						File = "roof_glows_33.png"
						Size = [2, 2]
					}
					{
						File = "roof_glows_66.png"
						Size = [2, 2]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [0, -0.03125]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [3, 3]
						Z = 0.5 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.5, 0, 0]
					}
				]
			}
		}

		Turret
		{
			Type = TurretWeapon
			Location = [1, 1] // Relative to upper-left corner of unrotated part.
			Rotation = -90d // Relative to unrotated part.
			OperationalToggle = IsOperational
			AutoFireToggle = AutoFireToggle
			FireInterval = .9
			FiringArc = 115d
			RotateSpeed = 45d
			FireThresholdAngle = 1d
			AIFirepowerRating = &~/Part/StatsByCategory/0/Stats/DamagePerSecond
			Emitter = BulletEmitter
			FirePermissionToggle = FirePermission
			ToggleOnMode = IsReloaded

			AutoTargets
			[
				{
					TargetType = ShipParts
					Toggle = AutoTargetToggle
				}
			]

			BlueprintArcSprite
			{
				Texture = &/INDICATORS/WeaponArc
				Size = [0, 1.5]
				Color = [255, 0, 0, 63]
			}
			BlueprintArcRadius = 10
			BlueprintArcSpriteSegments = 64

			CoverageSectorArc
			{
				Texture = &/INDICATORS/VerticalGradient
				VertexColor = [255, 255, 255, 51]
				QuadCount = 64
			}
		}
		FirePermission
		{
			Type = MultiToggle
			Mode = All
			Toggles = [ FireModeToggle, IsReadyToFire ]
		}
		IsReadyToFire
		{
			Type = MultiToggle
			Mode = Any
			Toggles
			[
				{ Toggle = IsOverclocked; Invert = true; }
				Overclock_FireTimer
			]
		}

		Overclock_ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperationalOverclocked
			ShowProgressFor = Overclock_ReloadProgressValue
			ValueRange = [0, 1 + (&~/Part/Components/Overclock_FireTimerScaleStaticValue/Value)]
		}

		Overclock_ReloadProgressValue
		{
			Type = LazyMultiValue
			Values = [Turret, Overclock_ScaledFireTimerValue]
			Mode = Add
		}

		Overclock_ScaledFireTimerValue
		{
			Type = LazyMultiValue
			Values = [ Overclock_FireTimerInverted, Overclock_FireTimerScaleStaticValue ]
			Mode = Multiply
		}
		Overclock_FireTimerScaleStaticValue
		{
			Type = StaticValue
			Value = (&~/OVERCLOCK/EXTRA_INTERVAL) / (&~/Part/Components/Turret/FireInterval)
		}

		Overclock_FireTimerInverted
		{
			Type = LazyMultiValue
			Values = [ Overclock_FireTimer ]
			Mode = Add
			Invert = true
		}

		Overclock_FireTimer
		{
			Type = Timer
			OperationalToggle = IsOperational
			Duration = (&~/OVERCLOCK/EXTRA_INTERVAL)
			StartTrigger = Overclock_StartFireTimer
			ResetTrigger = Turret
		}

		Overclock_StartFireTimer
		{
			Type = ToggleTrigger
			Toggle = Overclock_CanProgressFireTimer
			TriggerWhenOff = false
		}

		Overclock_CanProgressFireTimer
		{
			Type = MultiToggle
			Toggles [ IsOperationalOverclocked, Turret ]
			Mode = All
		}

		IsOperationalNonOverclocked
		{
			Type = MultiToggle
			Toggles = [ IsOperational, { Toggle=IsOverclocked; Invert=true } ]
			Mode = All
		}

		ReloadProgressBar
		{
			Type = ProgressBar
			OperationalToggle = IsOperationalNonOverclocked
			ShowProgressFor = Turret
		}

		Overclock_BulletEmitterProxy
		{
			Type = TriggerProxy
			ComponentID = BulletEmitter
			ProxyToggle = IsOverclocked
		}

		BulletEmitter
		{
			Type = BulletEmitter
			ChainedTo = Turret
			FireTrigger = Turret
			GetTargetFrom = Turret
			Location = [2, 0]
			OperationalToggle = IsOperational
			Bullet = &<./Data/shots/bullet_med/bullet_med.rules>
			Spread
			[
				{
					BaseValue = -2.5d
					Modifiers
					[
						{
							Type = BuffRemap
							BuffType = Overclock
							ModificationMode = Replace
							RemapFrom = [0, 1]
							RemapTo = [&../../../BaseValue, -(&~/OVERCLOCK/HALF_SPREAD)]
						}
					]
				}
				: 0
				{
					BaseValue = -(&^/0/BaseValue)
					Modifiers
					[
						: ../^/0/Modifiers/0
						{
							RemapTo = [&../../../BaseValue, (&~/OVERCLOCK/HALF_SPREAD)]
						}
					]
				}
			]
			ResourceStorage = LoadedAmmo
			ResourcesUsed = 1
			Recoil = 20
			AntiPhasingRaycastDistance = 1.5
			Burst
			{
				BaseValue = 1
				Modifiers
				[
					{
						Type = Buff
						BuffType = Overclock
						ModificationMode = Lerp
						MinValue = 1
						MaxValue = (&~/OVERCLOCK/BURST)
					}
				]
			}
			BurstDelay = (&~/OVERCLOCK/BURST_DELAY)
		}

		FireEffect
		{
			Type = TriggeredEffects
			ChainedTo = Turret
			Trigger = BulletEmitter
			Location = [2, 0]

			MediaEffects
			[
				&<particles/cannon_shoot_med.rules>
				&<particles/cannon_shoot_med_flash.rules>
				&<particles/cannon_shoot_med_flare.rules>
				&<particles/cannon_smoke_med.rules>

				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "shoot.wav"
					Volume = .75
					SpeedVariation = .25
				}

				: /BASE_SHAKE
				{
					ShakeAmount = .025
					Duration = .25
				}
			]
		}

		CrewLocation
		{
			Type = CrewLocation
			ChainedTo = Turret
			Location = [-.25, .375+0.015625]
			Rotation = 90d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 1
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [PowerToggle, ScorchedToggle]
			HighPriorityPrerequisites = [CombinedAmmo]
			CrewDestinations
			[
				[1.375, 1.25]
			]
			CrewLocations
			[
				CrewLocation
			]
		}

		TurretCollider
		{
			Type = CircleCollider
			Location = &../Turret/Location
			Radius = 0.72
			Density = 1.5
		}

		OverclockStateValue
		{
			Type = ToggleValueSelector
			Toggle = OverclockModeToggle
			ToggleOffValue = Zero
			ToggleOnValue = One
		}

		Zero { Type = StaticValue; Value = 0; }
		One { Type = StaticValue; Value = 1; }

		Overclock_ShotHeatProducer
		{
			Type = ResourceChange
			ResourceStorage = &~/Part/^/0/HEAT_TARGET_STORAGE
			Trigger = Overclock_BulletEmitterProxy
			Amount = (&~/OVERCLOCK/HEAT_PER_SHOT) * (&~/HEAT_TO_RESOURCE)
		}

		Port_Thermal_Left0 : ~/Part/^/0/BASE_THERMAL_PORT
		{
			Location = [0, 1]
			Direction = Left
		}
		Port_Thermal_Down0 : Port_Thermal_Left0
		{
			Location = [0, 1]
			Direction = Down
		}
		Port_Thermal_Down1 : Port_Thermal_Down0
		{
			Location = [1, 1]
		}
		Port_Thermal_Right0 : Port_Thermal_Left0
		{
			Location = [1, 1]
			Direction = Right
		}

		TurretGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [0, 0]
			Rotation = 90d
			OperationalToggle = IsOperational
			DoodadToggle = LoadedAmmo
			ShowToggledDoodadsWhenNotOperational = true
			ToggleOnDoodad
			{
				Layer = "doodads_high"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"bullet_door1.png"
							"bullet_door2.png"
							"bullet_door3.png"
						]
						Size = [1, 1]
						//Offset = [0, -0.25]
						AnimationInterval = 0.0666
						ClampAnimation = true
					}
				]
			}
			Floor
			{
				Layer = "turrets"
				DamageLevels
				[
					{
						File = "turret_floor.png"
						Size = [2, 2]
					}
					{
						File = "turret_floor_33.png"
						Size = [2, 2]
					}
					{
						File = "turret_floor_66.png"
						Size = [2, 2]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"console_on1.png"
							"console_on2.png"
							"console_on3.png"
							"console_on4.png"
							"console_on5.png"
							"console_on6.png"
							"console_on7.png"
							"console_on8.png"
						]
						Size = [1, 1]
						Offset = [0.375, -0.25]
						AnimationInterval = 0.125
					}
					{
						AnimationFiles
						[
							"console_on1_33.png"
							"console_on2_33.png"
							"console_on3_33.png"
							"console_on4_33.png"
							"console_on5_33.png"
							"console_on6_33.png"
							"console_on7_33.png"
							"console_on8_33.png"
						]
						Size = [1, 1]
						Offset = [0.375, -0.25]
						AnimationInterval = 0.125
					}
					{
						AnimationFiles
						[
							"console_on1_66.png"
							"console_on2_66.png"
							"console_on3_66.png"
							"console_on4_66.png"
							"console_on5_66.png"
							"console_on6_66.png"
							"console_on7_66.png"
							"console_on8_66.png"
						]
						Size = [1, 1]
						Offset = [0.375, -0.25]
						AnimationInterval = 0.125
					}
				]
			}
			NonOperationalDoodad
			{
				Layer = "doodads_low"
				DamageLevels
				[
					{
						File = "console_off.png"
						Size = [1, 1]
						Offset = [0.375, -0.25]
					}
					{
						File = "console_off_33.png"
						Size = [1, 1]
						Offset = [0.375, -0.25]
					}
					{
						File = "console_off_66.png"
						Size = [1, 1]
						Offset = [0.375, -0.25]
					}
				]
			}
		}

		BarrelGraphics
		{
			Type = Graphics
			ChainedTo = Turret
			Location = [.5, 0]
			Rotation = 90d
			ResetAnimationTrigger = BulletEmitter

			OperationalDoodad
			{
				Layer = "weapons"
				DamageLevels
				[
					{
						AnimationFiles
						[
							//"barrel2.png"
							"barrel3.png"
							"barrel4.png"
							"barrel5.png"
							"barrel6.png"
							"barrel7.png"
							"barrel8.png"
							"barrel1.png"// Loop back to beginning and clamp there.
						]
						NormalsAnimationFiles
						[
							//"barrel_normals2.png"
							"barrel_normals3.png"
							"barrel_normals4.png"
							"barrel_normals5.png"
							"barrel_normals6.png"
							"barrel_normals7.png"
							"barrel_normals8.png"
							"barrel_normals1.png"
						]
						Size = [1, 3]
						AnimationInterval = 0.0625
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
					{
						AnimationFiles
						[
							//"barrel2_33.png"
							"barrel3_33.png"
							"barrel4_33.png"
							"barrel5_33.png"
							"barrel6_33.png"
							"barrel7_33.png"
							"barrel8_33.png"
							"barrel1_33.png"// Loop back to beginning and clamp there.
						]
						NormalsAnimationFiles
						[
							//"barrel_normals2.png"
							"barrel_normals3.png"
							"barrel_normals4.png"
							"barrel_normals5.png"
							"barrel_normals6.png"
							"barrel_normals7.png"
							"barrel_normals8.png"
							"barrel_normals1.png"
						]
						Size = [1, 3]
						AnimationInterval = 0.0625
						AnimationStartTime = MinValue
						ClampAnimation = true
					}
					{
						AnimationFiles
						[
							//"barrel2_66.png"
							"barrel3_66.png"
							"barrel4_66.png"
							"barrel5_66.png"
							"barrel6_66.png"
							"barrel7_66.png"
							"barrel8_66.png"
							"barrel1_66.png"// Loop back to beginning and clamp there.
						]
						NormalsAnimationFiles
						[
							//"barrel_normals2.png"
							"barrel_normals3.png"
							"barrel_normals4.png"
							"barrel_normals5.png"
							"barrel_normals6.png"
							"barrel_normals7.png"
							"barrel_normals8.png"
