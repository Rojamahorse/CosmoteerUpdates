Part : <../base_part_terran.rules>/Part
{
	NameKey = "Parts/RailgunLoader"
	IconNameKey = "Parts/RailgunLoaderIcon"
	ID = cosmoteer.railgun_loader // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorParentParts = [ "cosmoteer.railgun_launcher" ]
	DescriptionKey = "Parts/RailgunLoaderDesc"
	Resources
	[
		[steel, 60]
		[coil2, 30]
		[tristeel, 10]
	]
	Size = [2, 3]
	Density = 4
	SelectionTypeID = "railgun"
	SelectionPriority = 1
	SelectionTypeByRotation = true
	MaxHealth = 6000
	TypeCategories = [weapon, uses_ammo, is_crewed, railgun, railgun_ammo]
	ReceivableBuffs : ^/0/ReceivableBuffs [RailgunReverseOperation]
	AllowedDoorLocations
	[
		[-1, 2]
		[0, 3]
		[1, 3]
		[2, 2]
	]
	ForceManhattanPathInPart = true
	BlockedTravelCells
	[
		[0, 0]
		[1, 0]
	]
	BlockedTravelCellDirections
	[
		{
			Key = [0, 1]
			Value = [Right]
		}
		{
			Key = [1, 1]
			Value = [Left]
		}
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [46, 69]
	}
	Components : ^/0/Components
	{
		BuffOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle]
			Mode = All
		}
		IsOperational
		{
			Type = MultiToggle
			Toggles = [BuffOperational, RailgunReverseOperationBuffToggle]
			Mode = All
		}

		CommandConsumptionToggle
		{
			Type = MultiToggle
			Toggles = [PowerToggle, ScorchedToggle]
			Mode = All
		}

		RailgunReverseOperationBuffToggle
		{
			Type = BuffToggle
			BuffType = RailgunReverseOperation
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = CommandConsumptionToggle
			CommandPoints = 4
		}

		OverclockBuff
		{
			Type = SelfBuffProvider
			BuffType = Overclock
			BuffMultiplier = Network_OverclockStateValue
		}

		OverclockToggle
		{
			Type = BuffToggle
			BuffType = Overclock
			MinBuffValue = 0
			MaxBuffValue = 0
			Invert = true
		}

		LoadedAmmo
		{
			Type = ResourceStorage
			ResourceType = bullet
			MaxResources = 6
			DelayBeforeReadyToUse = .25
			AnticipateMoreResourcesFrom = [AmmoStorage]
			ToggleOnResources = 6
			ToggleOffResources = 5
			UITileRect = [.5 + 7/64, .3 + 7/64, 1 - 14/64, 1 - 14/64]
			ReceiveResourceMediaEffects = &/COMMON_EFFECTS/AmmoDeliver
			DropResourcesWhenDestroyed = true
		}

		AmmoStorage
		{
			Type = TypedResourceGrid
			ResourceType = bullet
			GridRect = [0, 2, 2, 1]
			Layer = "doodads_low"
			SpriteInset = [7/64, 9/64, 7/64, 13/64]
		}
		AmmoConsumer
		{
			Type = TypedResourceGridConsumer
			ResourceType = bullet
			Storage = AmmoStorage
			DefaultPriority = &/PRIORITIES/Weapon_Supply
			OperationalToggle = CommandConsumptionToggle
			ConsumptionToggleButtonOffset = [0, -.4]
		}

		AmmoPrereq
		{
			Type = MultiResourceStorage
			ResourceType = bullet
			ResourceStorages = [LoadedAmmo, AmmoStorage]
			ToggleOnResources = 6
			ToggleOffResources = 5
		}

		RailgunBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = Railgun
			BuffAmount = 0
			BuffArea = [0, -1, 2, 1]
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
		}

		OperationBuffProvider
		{
			Type = AreaBuffProvider
			BuffType = RailgunOperation
			BuffArea = [0, -1, 2, 1]
			OperationalToggle = BuffOperational
			Criteria
			{
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
		}

		AmmoLoader
		{
			Type = ResourceConverter
			FromStorage = AmmoStorage
			ToStorage = LoadedAmmo
			FromQuantity = 1
			ToQuantity = 1
			Interval = 0.15
		}

		LoadEffects
		{
			Type = TriggeredEffects
			Trigger = AmmoLoader
			MediaEffects = &/COMMON_EFFECTS/AmmoLoad
		}

		WeaponTrigger
		{
			Type = TriggerProxy
			PartLocation = [0, -1]
			PartCriteria
			{
				Category = railgun_power
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
			ComponentID = Weapon
		}
		
		ProjectileStartTrigger
		{
			Type = TriggerProxy
			PartLocation = [0, -1]
			PartCriteria
			{
				Category = railgun_power
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
			ComponentID = ProjectileStartTrigger
		}
		
		EmitTrigger
		{
			Type = TriggerProxy
			PartLocation = [0, -1]
			PartCriteria
			{
				Category = railgun_power
				Rot = 0
				Left = 0
				Right = 2
				Bottom = 0
			}
			ComponentID = EmissionTriggered
		}

		CrewLocation1
		{
			Type = CrewLocation
			Location = [.48, 1.5625]
			Rotation = -13.5d
		}
		CrewLocation2
		{
			Type = CrewLocation
			Location = [1.52, 1.5625]
			Rotation = 13.5d
		}
		PartCrew
		{
			Type = PartCrew
			Crew = 2
			DefaultPriority = &/PRIORITIES/Weapon_Crew
			PrerequisitesBeforeCrewing = [CommandConsumptionToggle]
			HighPriorityPrerequisites = [AmmoPrereq]
			CrewDestinations
			[
				[.48, 1.5625]
				[1.52, 1.5625]
			]
			CrewLocations
			[
				CrewLocation1
				CrewLocation2
			]
		}

		Router
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[Network_OverclockStateValue, Network_OverflowHeatStorage, 0]
						[Network_OverclockStateValue, Network_ChargedModules, 0]
					]
				}
			]
		}

		OverflowHeatStorage : <./Data/ships/terran/base_part_terran_overclock.rules>/Part/Components/OverflowHeatStorage {}
		OverheatEffects : <./Data/ships/terran/base_part_terran_overclock.rules>/Part/Components/OverheatEffects
		{
			Location = [1, 1.5]
		}

		Network_OverflowHeatStorage
		{
			Type = NetworkResourceStore
			ResourceType = heat
			ResourceStorage = OverflowHeatStorage
			AllowProviding = false
			Categories = [ railgun_heat_overflow ]
		}

		Network_OverclockStateValue
		{
			Type = NetworkValueReceiver
			Mode = Max
			Categories = [ overclock ]
			AllowUncategorized = false
		}
		IsOverclocked
		{
			Type = ThresholdToggle
			ValueFrom = Network_OverclockStateValue
			MinAmount = 0
			MaxAmount = 0
			Invert = true
		}

		BlueprintNetwork_IsOverclocked
		{
			Type = NetworkToggleReceiver
			Categories = [ overclock ]
			Mode = Any
			AllowUncategorized = false
			IncludeInBlueprints = true
			IncludeInPhysical = false
		}

		Port_Rail
		{
			Type = NetworkPort
			Location = [0, 0]
			Direction = Up
			Types = [ railgun_up ]
			CompatibleTypes = [ railgun_down ]
			RouteSource = Network_OverclockStateValue
			RouteEndpoint = Network_OverclockStateValue
			BlueprintRouteSource = BlueprintNetwork_IsOverclocked
			BlueprintRouteEndpoint = BlueprintNetwork_IsOverclocked
			Overlay
			{
				RouteDrawMode = Never
				IconDrawMode = Never
			}
		}

		Port_Thermal_Left : <./Data/ships/terran/base_part_terran_overclock.rules>/Part/BASE_THERMAL_PORT
		{
			OperationalToggle = IsOverclocked
			BlueprintOperationalToggle = BlueprintNetwork_IsOverclocked
			Location = [0, 2]
			Direction = Left
			RouteSource = Network_OverclockStateValue
			Overlay : ^/0/Overlay
			{
				SpreadHighlightThroughNetwork = BlueprintNetwork_IsOverclocked
			}
		}
		Port_Thermal_Right : Port_Thermal_Left
		{
			Location = [1, 2]
			Direction = Right
		}
		Port_Thermal_BottomLeft : Port_Thermal_Left
		{
			Location = [0, 2]
			Direction = Down
		}
		Port_Thermal_BottomRight : Port_Thermal_Left
		{
			Location = [1, 2]
			Direction = Down
		}

		Graphics
		{
			Type = Graphics
			Location = [1, 1.5]
			OperationalToggle = IsOperational
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [2, 3]
					}
					{
						File = "floor_33.png"
						Size = [2, 3]
					}
					{
						File = "floor_66.png"
						Size = [2, 3]
					}
				]
			}
			OperationalDoodad
			{
				Layer = "walls"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"doodads_on1.png"
							"doodads_on2.png"
							"doodads_on3.png"
							"doodads_on4.png"
							"doodads_on5.png"
							"doodads_on6.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.1
						AnimationStartTime = Zero
					}
					{
						AnimationFiles
						[
							"doodads_on1_33.png"
							"doodads_on2_33.png"
							"doodads_on3_33.png"
							"doodads_on4_33.png"
							"doodads_on5_33.png"
							"doodads_on6_33.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.1
						AnimationStartTime = Zero
					}
					{
						AnimationFiles
						[
							"doodads_on1_66.png"
							"doodads_on2_66.png"
							"doodads_on3_66.png"
							"doodads_on4_66.png"
							"doodads_on5_66.png"
							"doodads_on6_66.png"
						]
						Size = [2, 2]
						AnimationInterval = 0.1
						AnimationStartTime = Zero
					}
				]
			}
			OperationalLighting
			{
				Layer = "lights_add"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"lights1.png"
							"lights2.png"
							"lights3.png"
							"lights4.png"
							"lights5.png"
							"lights6.png"
						]
						Size = [2, 3]
						AnimationInterval = 0.1
						AnimationStartTime = Zero
					}
				]
			}
			Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [2, 3]
					}
					{
						File = "walls_33.png"
						Size = [2, 3]
					}
					{
						File = "walls_66.png"
						Size = [2, 3]
					}
				]
			}
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [2, 3]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [2, 3]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [2, 3]
					}
				]
			}
			OperationalRoofDoodad
			{
				Layer = "roof_doodads"
				Offset = [0, 0.5]
				DamageLevels
				[
					{
						File = "roof_glows.png"
						Size = [2, 2]
					}
					{
						File = "roof_glows_33.png"
						Size = [2, 2]
					}
					{
						File = "roof_glows_66.png"
						Size = [2, 2]
					}
				]
			}
			OperationalRoofLighting
			{
				Layer = "roof_lights_fancy"
				Offset = [0, 0.15625]
				DamageLevels
				[
					{
						File = "./Data/ships/common/light_blob.png"
						Size = [3, 3]
						Z = 1.0 // Controls the "height" of the light for the purposes of normal mapping. Set to -1 (or any negative number) to disable normal lighting for this light.
						VertexColor = [255*1.0, 0, 0]
					}
				]
			}
		}

		WeaponGraphics
		{
			Type = Graphics
			Location = [1, 1]
			OperationalToggle = IsOperational
			DoodadToggle = LoadedAmmo
			ShowToggledDoodadsWhenNotOperational = true
			Floor
			{
				Layer = "weapons"
				DamageLevels
				[
					{
						File = "weapon.png"
						NormalsFile = "weapon_normals.png"
						Size = [2, 2]
					}
					{
						File = "weapon_33.png"
						NormalsFile = "weapon_normals_33.png"
						Size = [2, 2]
					}
					{
						File = "weapon_66.png"
						NormalsFile = "weapon_normals_66.png"
						Size = [2, 2]
					}
				]
			}
			ToggleOnDoodad
			{
				Layer = "walls"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"bullet_door1.png"
							"bullet_door2.png"
							"bullet_door3.png"
						]
						Size = [1, 1]
						Offset = [0, 0.284375]
						AnimationInterval = 0.0666
						ClampAnimation = true
					}
					{
						AnimationFiles
						[
							"bullet_door1_33.png"
							"bullet_door2_33.png"
							"bullet_door3_33.png"
						]
						Size = [1, 1]
						Offset = [0, 0.284375]
						AnimationInterval = 0.0666
						ClampAnimation = true
					}
					{
						AnimationFiles
						[
							"bullet_door1_66.png"
							"bullet_door2_66.png"
							"bullet_door3_66.png"
						]
						Size = [1, 1]
						Offset = [0, 0.284375]
						AnimationInterval = 0.0666
						ClampAnimation = true
					}
				]
			}
			ToggleOffDoodad
			{
				Layer = "walls"
				DamageLevels
				[
					{
						AnimationFiles
						[
							"bullet_door3.png"
							"bullet_door2.png"
							"bullet_door1.png"
							"bullet_door0.png"
						]
						Size = [1, 1]
						Offset = [0, 0.284375]
						AnimationInterval = 0.0666
						ClampAnimation = true
					}
					{
						AnimationFiles
						[
							"bullet_door3_33.png"
							"bullet_door2_33.png"
							"bullet_door1_33.png"
							"bullet_door0.png"
						]
						Size = [1, 1]
						Offset = [0, 0.284375]
						AnimationInterval = 0.0666
						ClampAnimation = true
					}
					{
						AnimationFiles
						[
							"bullet_door3_66.png"
							"bullet_door2_66.png"
							"bullet_door1_66.png"
							"bullet_door0_66.png"
						]
						Size = [1, 1]
						Offset = [0, 0.284375]
						AnimationInterval = 0.0666
						ClampAnimation = true
					}
				]
			}
		}

		AmmoHideToggle
		{
			Type = TriggeredToggle
			OnTrigger = WeaponTrigger
			OffTrigger = EmitTrigger
			OperationalToggle = IsOperational
		}
		ToggledLoadedAmmoSprites
		{
			Type = ToggledComponents
			Toggle = AmmoHideToggle
			Invert = true
			Components
			{
				LoadedAmmoSprites
				{
					Type = ResourceSprites
					Location = [1, 1.3]
					ResourceStorage = LoadedAmmo
					Layer = "doodads_low"
					ResourceLevels
					[
						{
							File = "bullets1.png"
							Size = [1, 1]
						}
						{
							File = "bullets2.png"
							Size = [1, 1]
						}
						{
							File = "bullets3.png"
							Size = [1, 1]
						}
						{
							File = "bullets4.png"
							Size = [1, 1]
						}
						{
							File = "bullets5.png"
							Size = [1, 1]
						}
						{
							File = "bullets6.png"
							Size = [1, 1]
						}
					]
				}
			}
		}

		Network_ChargedModules
		{
			Type = NetworkValueReceiver
			Categories = [ railgun_charge_modules ]
			Mode = Max
			AllowUncategorized = false
		}
		Zero { Type = StaticValue; Value = 0; }
		Overclock_Charge_Lights_Intensity
		{
			Type = ValueOperation
			Operator = Subtract
			ValueOne = Network_ChargedModules
			ValueTwo = Zero
			MinValue = 0
			MaxValue = 0.5
		}
		FrameOffset { Type = StaticValue; Value = 0.5; }
		Overclock_Charge_Lights_Intensity_Normalize
		{
			Type = ValueOperation
			Operator = Divide
			ValueOne = Overclock_Charge_Lights_Intensity
			ValueTwo = FrameOffset
			MinValue = 0
			MaxValue = 1
		}
		Overclock_Charge_Lights
		{
			Type = ValueSprites
			Location = [1, 0.5]
			ValueFrom = Overclock_Charge_Lights_Intensity_Normalize
			Layer = "lights_add"
			ResourceLevels
			[
				{
					//Blank Frame
				}
				{
					File = "OClights1.png"
					Size = [2, 1]
				}
				{
					File = "OClights2.png"
					Size = [2, 1]
				}
			]
		}

		OperationEffects
		{
			Type = ToggleEffects
			Location = [1, 2.5]
			Toggle = IsOperational
			ToggledOnMediaEffects = &/COMMON_EFFECTS/MachinesOn
			ToggledOffMediaEffects = &/COMMON_EFFECTS/MachinesOff
		}

		ScorchedTrigger
		{
			Type = ToggleTrigger
			Toggle = ScorchedToggle
			TriggerWhenOn = false
		}

		ScorchedEffects
		{
			Type = TriggeredEffects
			Trigger = ScorchedTrigger
			Location = &../DestroyedEffects/Location
			MediaEffects = &/COMMON_EFFECTS/BigPartScorched
		}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/BigPartDestroyed
			Location = [1, 1.5]
		}

		RecursiveDeath
		{
			Type = DeathEffects
			Location = [1, -.5]

			HitEffects
			[
				{
					Type = AreaDamage
					Damage = 3000
					Radius = .6
					Falloff = 0
					Delay = .15
					Filter
					{
						OperationalHealth = true
						StructuralHealth = false
						Friendlies = true
					}
				}
			]
		}

		FireEffect
		{
			Type = TriggeredEffects
			Trigger = ProjectileStartTrigger
			Location = [1, 1]

			MediaEffects
			[
				: /BASE_SOUNDS/AudioExterior
				{
					Sound = "shoot.wav"
					Volume = 2
					SpeedVariation = .25
				}
			]
		}

		Indicators
		{
			Type = IndicatorSprites
			Location = [1, 1.5]
			Indicators
			[
				// Scorched
				{
					Toggle = ScorchedToggle
					AtlasSprite = &/INDICATORS/Scorched
					HidesIndicators = [1,2,3]
				}
				// Turned off.
				{
					Toggle = PowerToggle
					AtlasSprite
					{
						File = &/INDICATORS/PowerOff
						Size = [1, 1]
					}
					HidesIndicators = [2,3]
				}

				// Out of ammo.
				{
					Toggle = AmmoPrereq
					Delay = &<../railgun_launcher/railgun_launcher.rules>/Part/Components/Weapon/FireInterval
					AtlasSprite
					{
						File = &/INDICATORS/NoAmmo
						Size = [1, 1]
					}
				}

				// No crew.
				{
					Toggle = PartCrew
					AtlasSprite
					{
						File = &/INDICATORS/NoCrew
						Size = [1, 1]
					}
				}
			]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 3]
		}
	}

	Stats
	{
		CrewRequired = &~/Part/Components/PartCrew/Crew
		AmmoCapacity = (&~/Part/Components/AmmoStorage/GridRect/2) * (&~/Part/Components/AmmoStorage/GridRect/3) * (&<./Data/resources/bullet/bullet.rules>/MaxStackSize) + (&~/Part/Components/LoadedAmmo/MaxResources)

		RecAmmo = &../StatsByCategory/0/Stats/AmmoPerSecond
		RecCrew = (&CrewRequired) + (&RecAmmo) * 2
	}

	StatsByCategory = &<../railgun_launcher/railgun_launcher.rules>/Part/StatsByCategory
	StatsNotesKey = "Stats/RailgunNotes"
}