BASE = &<./Data/shots/flak_large/flak_large.rules>

FLAK_FIELD = &<flak_large_overclock_field.rules>

Beam : BASE
{
	HitNothing : ^/0/HitNothing
	{
		HitEffects : ^/0/HitEffects
		[
			{
				Type = SpawnBullets
				Bullet = &~/FLAK_FIELD
				Count = 1
			}
		]
		MediaEffects
		[
			&<particles/flak_large_overclock_field_shrapnel.rules>
			&<particles/flak_large_overclock_flash.rules>
			&<particles/flak_large_overclock_field_right.rules>
			&<particles/flak_large_overclock_field_left.rules>
		]
	}
	HitShield = &HitNothing
    HitOperational = &HitNothing
    HitStructural = &HitNothing
}