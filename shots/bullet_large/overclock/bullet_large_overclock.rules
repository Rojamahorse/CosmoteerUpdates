BASE = &<./Data/shots/bullet_large/bullet_large.rules>

ID = "cosmoteer.bullet_large_overclock"
Range = &BASE/Range
IdealRange = &BASE/IdealRange
IdealRadius = &BASE/IdealRadius
Speed = (&~/BASE/Speed) * 2

HEALTH = (&~/BASE/Components/Targetable/Health) * 0.5

SHRAPNEL_EFFECT
{
	Type = SpawnBullets
	Bullet = &<bullet_large_overclock_shrapnel.rules>
	Count = 20
	Arc = [-40d, 80d]
	Spread = [-5d, 5d]
//	InheritVelocity = true
}

Components : &BASE/Components
{
	Targetable : ^/0/Targetable
	{
		Health = &~/HEALTH
		
		OnDeath : ^/0/OnDeath
		{
			HitEffects
			[
				&~/SHRAPNEL_EFFECT
			]
		}
	}
	
	Hit
	{
		Type = SimpleHit
		
		CrewCollisions = {Enemies=true; Junk=true}
		PenetratesCrew = true
		HitCrew = &~/BASE/Components/Hit/HitCrew
		HitShield = &HitOperational
		HitOperational : &~/BASE/Components/Hit/HitOperational
		{
			HitEffects
			[
				// Impulse effect
				&../^/0/HitEffects/1
				&~/SHRAPNEL_EFFECT
			]
		}
		HitStructural = &~/BASE/Components/Hit/HitStructural
	}
	
	Sprite : ^/0/Sprite
	{
		ReduceScaleWith
	}
}
