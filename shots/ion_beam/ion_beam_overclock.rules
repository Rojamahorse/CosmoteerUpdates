OVERCLOCK
{
	DAMAGE_FACTOR = 0%
	LIGHTNING = &~/Beam/HitOperational/HitEffects/2
	LIGHTNING_OFFSET = 8
	LIGHTNING_BASE_CHAIN_LENGTH = [3,3]
	LIGHTNING_DAMAGE = 180
}

BEAM_BASE = &<ion_beam.rules>
BASE
{
	 DAMAGE = (&~/BEAM_BASE/HitOperational/HitEffects/0/Damage/BaseValue)
	 ION_ENERGY = (&~/BEAM_BASE/HitOperational/HitEffects/4/Amount/BaseValue)
}

MODIFIABLE_DAMAGE
{
	Modifiers
	[
		{
			Type = Buff
			BuffType = ElectronBuff
			ModificationMode = Multiply
		}
		{
			Type = EffectScale
			ModificationMode = Multiply
		}
	]
}

Beam : <ion_beam.rules>
{
	HitEffectsScaleOverRange = 1
	MediaEffectsScaleOverRange = 1
	SecondaryWidth = (&~/OVERCLOCK/LIGHTNING_OFFSET) * 2
	SecondaryFilter 
	{
		ExcludePartCategories = [ion_beam_prism]
		IgnoreInvulnerability = true; 
	}
	SecondaryOverrideFilter
	{
		Ships = true
		OperationalHealth = true
		Self = true
		Shields = false
		OnlyPartCategories = [ion_beam_prism]
		IgnoreInvulnerability = true
	}
	ShieldCollisions { IgnoreInvulnerability = true; }
	UseHitNormalAsWorldDirection = true
	HitShield = &HitOperational
	HitCrew = &HitOperational
	HitNothing = &HitOperational
	HitOperational : ^/0/HitOperational
	{
		HitEffects
		[
			{
				Type = ResourceDrain
				ResourceType = ion_energy_overclocked
				Amount = { BaseValue = (&~/BASE/ION_ENERGY); EffectScaleExponent = 1 }
				Filter
				{
					Friendlies = true
					IgnoreInvulnerability = true
					OnlyPartCategories = [ion_beam_prism]
				}
			}
			{
				Type = Damage
				Damage = { BaseValue = &~/BASE/DAMAGE; EffectScaleExponent = 1; }
				Filter
				{
					Friendlies = false
					Self = false
					Enemies = true
					Shields = false
					OnlyPartCategories = [ion_beam_prism]
				}
			}
			{
				Type = ChainLightning
				MaxChainLength = &~/OVERCLOCK/LIGHTNING_BASE_CHAIN_LENGTH
				InitialRadius = (&~/OVERCLOCK/LIGHTNING_OFFSET) + 1.5
				ChainRadius = 1.5
				InitialChance = 100%
				InitialStrikes = [1, 1]
				InitialStrikeRandomOffsetRadius = 0
				RaycastInitialTargets = true
				ChainChance = 100%
				ChainStrikes = [1, 2]
				MaxInitialAngle = 60d
				MaxChainAngle = 60d
				ChainDelay = 0.02
				ChainEffectFalloff = 0.5
				HitEffects
				[
					{
						Type = Damage
						Damage : ~/MODIFIABLE_DAMAGE
						{
							BaseValue = &~/OVERCLOCK/LIGHTNING_DAMAGE
						}
						Filter
						{
							Self = true
						}
					}
				]
				MediaEffects
				[
					&<particles/ion_beam_overclock_lightning_hit.rules>
					&<particles/ion_beam_overclock_flash.rules>
					&<particles/ion_beam_hit_sparks.rules>
				]
				ChainMediaEffects
				[
					&<particles/ion_beam_overclock_lightning_chain.rules>
					&<particles/ion_beam_overclock_flash.rules>
					&<particles/ion_beam_hit_sparks.rules>
				]
				HitFilter
				{
					Self = true
					Friendlies = true
					Enemies = true
					Neutrals = true
					Junk = true
					ExcludePartCategories = [ion_beam_prism]
				
					Ships = true
					OperationalHealth = true
					StructuralHealth = true
					Shields = true
					Bullets = true
					Crew = true
					Nuggets = true
					IgnoreInvulnerability = true
				}
				InitialFilter
				{
					ExcludePartCategories = [ion_beam_prism]
					IgnoreInvulnerability = true
				}
			}
		]
		
		MediaEffects
		[
			: <particles/ion_beam_overclock_spikes.rules>
			{
				Filter
				{
					ExcludePartCategories = [ion_beam_prism]
				}
			}
			
			: <particles/ion_beam_overclock_sparks_radial.rules>
			{
				Filter
				{
					ExcludePartCategories = [ion_beam_prism]
				}
			}
	
			: /BASE_SOUNDS/AudioExterior
			{
				Sound = "ion_beam_hit.wav"
				Volume = .5
				MaxConcurrent = 1
				MaxConcurrentVolume = 1
				RampUpTime = .25
				RampDownTime = .25
	
				Filter
				{
					ExcludePartCategories = [ion_beam_prism]
				}
			}
	
			: /BASE_SHAKE
			{
				ShakeAmount = .05
				Duration = .5
	
				Filter
				{
					ExcludePartCategories = [ion_beam_prism]
				}
			}
			{
				Type = Quad
				Bucket = IonHitSpikes
				IntensityScaleFactor = 1
				IntensityScaleExponent = 0.5
				FadeInTime = 0.2
				FadeOutTime = 0.2
				Sprite
				{
					Color = [255, 255, 255, 255]
					Size = [24, 24]
					Shader = particles/ion_storm.shader
					Texture
					{
						File = ./Data/common_effects/particles/noise_voronoi.png
						SampleMode = Linear
						MipLevels = max
						UMode = Wrap
						VMode = Wrap
					}
					_noiseTex1
					{
						File = ./Data/common_effects/particles/noise_marble2.png
						SampleMode = Linear
						MipLevels = max
						UMode = Wrap
						VMode = Wrap
					}
					_color1 = [255 * 0.9, 0, 0, 255]
					_color2 = [255, 255 * 0.8, 255 * 0.8, 255]
					TargetBlendMode = Add
				}
				Filter
				{
					ExcludePartCategories = [ion_beam_prism]
				}
			}
		]
	}
	
	BeamMediaEffects
	[
		// The beam itself.
		{
			Type = Beam
			Sprite
			{
				Texture
				{
					File = ../../common_effects/particles/noise_cells.png
					SampleMode = Linear
					MipLevels = max
					UVMode = Wrap
				}
				_noiseTexture
				{
					File = ../../common_effects/particles/noise_marble4.png
					MipLevels = max
					SampleMode = Linear
					UVMode = Wrap
				}
				Shader = "ion_beam.shader"
				_extraBeginLength = 0
				_extraEndLength = 0.25
				_sizePulseFactor = 1.2
				_sizePulseInterval = .1
				_sizePulseUOffsetFactor = -.03
				_endCapSize = 4
				Size = [100%, 2.5]
				VertexColor = [255, 255, 255, 217]
				_baseColor = [1, 0, 0, 1]
				_halfHighlightColor = [0.5, 0.4, 0.4, 1]
				TargetBlendMode
				{
					SourceRgbFactor = InverseDestColor
					DestRgbFactor = One
					RgbOperator = Add
					SourceAlphaFactor = One
					DestAlphaFactor = One
					AlphaOperator = Add
				}
			}
			FadeInTime = .25
			FadeOutTime = .25
			RandomTimeOffset = [0, 1]
			Bucket = IonBeam
		}
	
		// Beam lighting.
		{
			Type = Beam
			Sprite
			{
				Texture
				{
					File = "./Data/common_effects/particles/blob.png"
					MipLevels = max
					SampleMode = Linear
				}
				Shader = "./Data/common_effects/fancy_beam_light.shader"
				Size = [100%, 7]
				_extraBeginLength = (&Size/1) / 2
				_extraEndLength = (&Size/1) / 2
				VertexColor = [255, 0, 0, 255]
				_z = 0.4
				_litReflectiveStrength = 12
				_litAdditiveStrength = 0
				_unlitAdditiveStrength = 0.25
				_nrmlStrengthLimit = 1.0
				TargetBlendMode
				{
					SourceRgbFactor = InverseDestColor
					DestRgbFactor = One
					RgbOperator = Add
					SourceAlphaFactor = Zero
					DestAlphaFactor = One
					AlphaOperator = Add
				}
			}
			Bucket = Upper4
			IsLight = true
			FadeInTime = .25
			FadeOutTime = .25
		}
		
		//&<particles/ion_beam_overclock_beam_lightning.rules> //Currently Disabled
	
		: /BASE_SOUNDS/AudioExterior
		{
			Sound = "ion_beam.wav"
			Volume = 1
			MaxConcurrent = 1
			MaxConcurrentVolume = 1
			RampUpTime = .25
			RampDownTime = .25
	
			DynamicVolume : ^/0/DynamicVolume
			{
				UseCustomShapeForDistance = true
			}
			DynamicFilter : ^/0/DynamicFilter
			{
				UseCustomShapeForDistance = true
			}
		}
	]
}