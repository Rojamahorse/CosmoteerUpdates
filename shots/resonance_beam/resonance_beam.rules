Range
{
	BaseValue = 315
	Modifiers
	[
		{
			Type = Buff
			BuffType = Overclock
			ModificationMode = ReverseLerp
			MinValue = 155
			MaxValue = &../../BaseValue
		}
	]
}
IdealRange
{
	BaseValue = 300
	Modifiers
	[
		{
			Type = Buff
			BuffType = Overclock
			ModificationMode = ReverseLerp
			MinValue = 145
			MaxValue = &../../BaseValue
		}
	]
}
HitInterval = .1
//Width = 1.5

FriendlyShipLowCollisions = false

BeamMediaEffectsIntensity
{
	BaseValue = 1
	Modifiers
	[
		{
			Type = Buff
			BuffType = ThermalRadius
			ModificationMode = Replace
		}
	]
}

ColorRed
{
	BaseValue = 1
	Modifiers
	[
		{
			Type = Buff
			BuffType = ThermalIntensity
			ModificationMode = Replace
		}
	]
}
//necessary for the light beam
ColorBlue
{
	BaseValue = 1
	Modifiers
	[
		{
			Type = Buff
			BuffType = ThermalIntensity
			ModificationMode = Replace
		}
