ID = bullet
NameKey = "Resource/Bullet"
PluralNameKey = "Resource/BulletPlural"
DescriptionKey = "Resource/BulletDesc"
BuyPrice = 4
SellPrice = (&BuyPrice) / 2
MaxPerNugget = 2
MaxStackSize = 20
FlexGridPriorityKey = "flex_grid_bullet"
FlexGridDefaultPriority = 1
DropRates = &<../resources.rules>/AmmoDropRates
Rarity = Ammunition

Icon
{
	Texture
	{
		File = "icon.png"
		MipLevels = max
	}
	Size = [64, 64]
}

Overlay
{
	Texture
	{
		File = "overlay.png"
		SampleMode = Linear
		MipLevels = max
	}
	Size = [1, 1]
}

DeathHitEffects // Scaled with stack size.
[
	{
		Type = ExplosiveDamage
		TotalDamage = { BaseValue = 6000; EffectScaleExponent = 1 }
		Radius = 3
		Delay = .05
		StatusType = cosmoteer.fire
		StatusChancePerNDamage = 50%
		StatusValue = 1
		StatusValueType = Interpolated
		NDamage = 1000
		CrewKillChance = 10%
		Filter
		{
			OperationalHealth = true
			StructuralHealth = false
			Friendlies = true
		}
	}
	{
		Type = ExplosiveDamage
		TotalDamage = { BaseValue = 1200; EffectScaleExponent = 1 }
		Radius = 2
		Delay = .05
		Filter
		{
			OperationalHealth = false
			StructuralHealth = true
			Friendlies = true
			Crew = false
		}
	}
]

DeathMediaEffects = &/COMMON_EFFECTS/MedPartDestroyed

HitResponse
{
	HitEffects = &~/DeathHitEffects
	MediaEffects = &~/DeathMediaEffects
	Chance = 0
	ChancePerNDamage = 0
	RequireDirectHit = true
	DamageTypeOverrides
	{
		fire
		{
			ChancePerNDamage = 2.5%
			NDamage = &<./Data/statuses/fire/fire.rules>/DAMAGE_PER_TICK
		}
	}
}

